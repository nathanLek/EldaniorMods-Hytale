$Common = "../Common.ui";

@BulletPoint = Group {
  Anchor: (Top: 15);
  LayoutMode: Left;

  Group #BulletIcon {
    Anchor: (Width: 8, Height: 8, Top: 8);
  }

  Label #TextLabel {
    Anchor: (Left: 10);
    Style: (HorizontalAlignment: Start, FontSize: 18, Wrap: true, TextColor: #778393);
    Text: @Text;
  }
};

SceneBlur {}

Group {
  Background: #000000(0.70);
}

Group {
  LayoutMode: Middle;

  Group {
    LayoutMode: Center;
    Anchor: (Height: 440);
    Padding: (Vertical: 20);

    Group {
      LayoutMode: Top;

      Group #Content {
        Anchor: (Top: 30);
        LayoutMode: Left;

        Group #ContentText {
          Anchor: (Width: 500, Top: 20);
          LayoutMode: Top;

          Label #TitleLabel {
            Style: (HorizontalAlignment: Start, FontName: "Secondary", TextColor: #b6cfee, FontSize: 28, RenderBold: true, RenderUppercase: true, Wrap: true);
            Text: "Choisissez votre Destinée";
          }

          @BulletPoint {
            @Text = "Votre classe définit votre rôle sur Eldanior pour toujours.";
          }

          @BulletPoint {
            @Text = "Chaque classe possède des compétences et des améliorations uniques débloquées par le niveau.";
          }

          @BulletPoint {
            @Text = "Ce choix est définitif. Réfléchissez bien avant de vous engager.";
          }
        }
      }

      Group {
        FlexWeight: 1;
      }

      $Common.@TextButton #DiscoverClassesButton {
        @Anchor = Anchor(Width: 300, Bottom: 2);
        @Text = "Choisir ma Classe";
      }
    }
  }
}