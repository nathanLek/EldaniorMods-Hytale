            // ===== ONGLET GUILDE =====
            Group #TabGuilde {
                LayoutMode: Top;
                Visible: false;

                // --- NOBLE: NE PEUT PAS REJOINDRE ---
                Group #GuildeNobleBlock {
                    LayoutMode: Top;
                    Visible: false;

                    Group { Anchor: (Height: 80); }

                    Label {
                        Text: "GUILDE INDISPONIBLE";
                        Style: (FontSize: 20, TextColor: #cc4444, HorizontalAlignment: Center, RenderBold: true);
                        Anchor: (Height: 28);
                    }

                    Group { Anchor: (Height: 10); }

                    Label {
                        Text: "Les membres d'une famille noble ne peuvent pas";
                        Style: (FontSize: 14, TextColor: #8899aa, HorizontalAlignment: Center);
                        Anchor: (Height: 20);
                    }
                    Label {
                        Text: "creer ou rejoindre une guilde.";
                        Style: (FontSize: 14, TextColor: #8899aa, HorizontalAlignment: Center);
                        Anchor: (Height: 20);
                    }

