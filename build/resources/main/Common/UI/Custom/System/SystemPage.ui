            // ===== ONGLET GUILDE =====
            Group #TabGuilde {
                LayoutMode: Top;
                Visible: false;

                // --- NOBLE: NE PEUT PAS REJOINDRE ---
                Group #GuildeNobleBlock {
                    LayoutMode: Top;
                    Visible: false;

                    Group { Anchor: (Height: 80); }

                    Label {
                        Text: "GUILDE INDISPONIBLE";
                        Style: (FontSize: 20, TextColor: #cc4444, HorizontalAlignment: Center, RenderBold: true);
                        Anchor: (Height: 28);
                    }

                    Group { Anchor: (Height: 10); }

                    Label {
                        Text: "Les membres d'une famille noble ne peuvent pas";
                        Style: (FontSize: 14, TextColor: #8899aa, HorizontalAlignment: Center);
                        Anchor: (Height: 20);
                    }
                    Label {
                        Text: "creer ou rejoindre une guilde.";
                        Style: (FontSize: 14, TextColor: #8899aa, HorizontalAlignment: Center);
                        Anchor: (Height: 20);
                    }

                    Group { Anchor: (Height: 8); }

                    Label {
                        Text: "Quittez votre famille pour acceder aux guildes.";
                        Style: (FontSize: 12, TextColor: #556677, HorizontalAlignment: Center);
                        Anchor: (Height: 18);
                    }
                }

                // --- PAS DE GUILDE ---
                Group #GuildeNoGuild {
                    LayoutMode: Top;
                    Visible: true;

                    Group { Anchor: (Height: 80); }

                    Label {
                        Text: "VOUS N'ETES DANS AUCUNE GUILDE";
                        Style: (FontSize: 18, TextColor: #667788, HorizontalAlignment: Center, RenderBold: true);
                        Anchor: (Height: 28);
                    }

                    Group { Anchor: (Height: 8); }

                    Label {
                        Text: "Creez une guilde ou attendez une invitation !";
                        Style: (FontSize: 13, TextColor: #556677, HorizontalAlignment: Center);
                        Anchor: (Height: 20);
                    }

                    Group { Anchor: (Height: 20); }

                    Group {
                        LayoutMode: Center;
                        Anchor: (Height: 44);

                        TextButton #GuildeBtnCreate {
                            Text: "CREER UNE GUILDE";
                            Anchor: (Width: 260, Height: 44);
                            Style: (Default: (LabelStyle: (FontSize: 16, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 16, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                            Background: #1a1208(0.8);
                        }
                    }

                    Group { Anchor: (Height: 12); }

                    Group {
                        LayoutMode: Left;
                        Anchor: (Height: 34);

                        Group { FlexWeight: 1; }

                        Group {
                            Background: #1a2030(0.6);
                            LayoutMode: Left;
                            Padding: (Horizontal: 14, Vertical: 4);
                            Anchor: (Width: 200, Height: 34);

                            Label {
                                Text: "NIVEAU REQUIS";
                                Style: (FontSize: 10, TextColor: #8899aa, RenderBold: true, VerticalAlignment: Center);
                                Anchor: (Width: 120);
                            }
                            Label {
                                Text: "120";
                                Style: (FontSize: 16, TextColor: #FFD700, VerticalAlignment: Center, RenderBold: true);
                            }
                        }

                        Group { Anchor: (Width: 8); }

                        Group {
                            Background: #1a2030(0.6);
                            LayoutMode: Left;
                            Padding: (Horizontal: 14, Vertical: 4);
                            Anchor: (Width: 200, Height: 34);

                            Label {
                                Text: "COUT";
                                Style: (FontSize: 10, TextColor: #8899aa, RenderBold: true, VerticalAlignment: Center);
                                Anchor: (Width: 60);
                            }
                            Label {
                                Text: "150 000 Or";
                                Style: (FontSize: 16, TextColor: #D4AF37, VerticalAlignment: Center, RenderBold: true);
                            }
                        }

                        Group { FlexWeight: 1; }
                    }

                    Group { Anchor: (Height: 8); }

                    Label {
                        Text: "Usage : /es guildcreate <nom> <tag>";
                        Style: (FontSize: 11, TextColor: #445566, HorizontalAlignment: Center);
                        Anchor: (Height: 18);
                    }
                }

                // --- A UNE GUILDE ---
                Group #GuildeHasGuild {
                    LayoutMode: Top;
                    Visible: false;

                    // Header
