$C = "../Common.ui";

$C.@PageOverlay {}

Group {
    LayoutMode: Center;

    Group #MainPanel {
        Anchor: (Width: 1050, Height: 700);
        Background: #0c1018(0.92);
        LayoutMode: Left;

        // =============================================
        // SIDEBAR GAUCHE
        // =============================================
        Group #Sidebar {
            Anchor: (Width: 200);
            Background: #0a0e16(0.95);
            LayoutMode: Top;
            Padding: (Vertical: 12, Horizontal: 10);

            // --- Header ---
            Label #SidebarPlayerName {
                Style: (FontSize: 14, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: Center);
                Text: "";
                Anchor: (Height: 22);
            }

            Label #SidebarPlayerInfo {
                Style: (FontSize: 10, TextColor: #8899aa, HorizontalAlignment: Center);
                Text: "";
                Anchor: (Height: 16);
            }

            Group { Anchor: (Height: 6); }
            Group { Anchor: (Height: 1); Background: #FFD700(0.2); }
            Group { Anchor: (Height: 10); }

            // --- Navigation Buttons ---
            TextButton #TabBtnProfil {
                Text: "PROFIL";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #FFD700, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #1a2030(0.8);
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnInventaire {
                Text: "INVENTAIRE";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #151b28(0.6);
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnCompetences {
                Text: "COMPETENCES";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #151b28(0.6);
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnGuilde {
                Text: "GUILDE";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #151b28(0.6);
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnGroupe {
                Text: "GROUPE";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #151b28(0.6);
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnFamille {
                Text: "FAMILLE";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #151b28(0.6);
                Visible: false;
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnTitres {
                Text: "TITRES";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #151b28(0.6);
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnQuetes {
                Text: "QUETES";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #151b28(0.6);
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnBlackMarket {
                Text: "MARCHE NOIR";
                Style: (Default: (LabelStyle: (FontSize: 12, TextColor: #cc4444, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 12, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #2a1a1a(0.6);
                Visible: false;
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnShop {
                Text: "MARCHE";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #4CAF50, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #151b28(0.6);
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnDuel {
                Text: "DUEL";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #ff9800, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #151b28(0.6);
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnClassements {
                Text: "CLASSEMENTS";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #151b28(0.6);
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnTerritoires {
                Text: "TERRITOIRES";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #8B4513, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #1a1408(0.6);
                Visible: false;
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnProprietes {
                Text: "PROPRIETES";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #151b28(0.6);
            }

            Group { Anchor: (Height: 4); }

            TextButton #TabBtnEchanges {
                Text: "ECHANGES";
                Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #D4AF37, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 32);
                Background: #1a1a08(0.6);
                Visible: false;
            }

            // --- Spacer ---
            Group { FlexWeight: 1; }

            // --- Footer: Money + Level ---
            Group { Anchor: (Height: 1); Background: #FFD700(0.2); }
            Group { Anchor: (Height: 8); }

            Label #SidebarMoney {
                Style: (FontSize: 13, TextColor: #D4AF37, HorizontalAlignment: Center, RenderBold: true);
                Text: "";
                Anchor: (Height: 18);
            }

            Label #SidebarLevel {
                Style: (FontSize: 12, TextColor: #aabbcc, HorizontalAlignment: Center);
                Text: "";
                Anchor: (Height: 18);
            }
        }

        // Separateur vertical
        Group { Anchor: (Width: 1); Background: #2a3040; }

        // =============================================
        // ZONE DE CONTENU
        // =============================================
        Group #ContentArea {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            Padding: (Full: 20);

            // ===== ONGLET PROFIL =====
            Group #TabProfil {
                LayoutMode: Top;
                Visible: true;

                // ========================================
                // PSEUDO + RANG AVENTURIER
                // ========================================
                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 36);

                    Group { FlexWeight: 1; }

                    Label #ProfilName {
                        Text: "";
                        Style: (FontSize: 24, TextColor: #FFD700, RenderBold: true, VerticalAlignment: Center, LetterSpacing: 1);
                    }

                    Group { Anchor: (Width: 10); }

                    Group { FlexWeight: 1; }

                    Group #ProfilRankBox {
                        Anchor: (Width: 50, Height: 36);
                        Background: #1a1a2e(0.9);
                        LayoutMode: Top;

                        Label {
                            Text: "RANK";
                            Style: (FontSize: 8, TextColor: #667788, HorizontalAlignment: Center);
                            Anchor: (Height: 12);
                        }
                        Label #ProfilAdvRank {
                            Text: "F";
                            Style: (FontSize: 18, TextColor: #8899aa, HorizontalAlignment: Center, RenderBold: true);
                            FlexWeight: 1;
                        }
                    }
                }

                Group { Anchor: (Height: 6); }

                // ========================================
                // 3 zones : Rang | Status | Classe
                // ========================================
                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 32);

                    Group {
                        FlexWeight: 1;
                        Background: #1a2030(0.7);
                        LayoutMode: CenterMiddle;

                        Label #ProfilRank {
                            Text: "";
                            Style: (FontSize: 13, TextColor: #C8A2C8, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true);
                        }
                    }

                    Group { Anchor: (Width: 4); }

                    Group {
                        FlexWeight: 1;
                        Background: #1a2030(0.7);
                        LayoutMode: CenterMiddle;

                        Label #ProfilStatus {
                            Text: "";
                            Style: (FontSize: 13, TextColor: #8899aa, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true);
                        }
                    }

                    Group { Anchor: (Width: 4); }

                    Group {
                        FlexWeight: 1;
                        Background: #1a2030(0.7);
                        LayoutMode: CenterMiddle;

                        Label #ProfilClass {
                            Text: "";
                            Style: (FontSize: 13, TextColor: #8B4513, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true);
                        }
                    }
                }

                Group { Anchor: (Height: 4); }

                // ========================================
                // BANDEAU EGLISE
                // ========================================
                Group {
                    Anchor: (Height: 26);
                    Background: #181a2e(0.6);
                    LayoutMode: CenterMiddle;

                    Label #ProfilChurch {
                        Text: "";
                        Style: (FontSize: 12, TextColor: #7EB8DA, HorizontalAlignment: Center, VerticalAlignment: Center);
                    }
                }

                Group { Anchor: (Height: 4); }

                // ========================================
                // BANDEAU TITRE pleine largeur
                // ========================================
                Group {
                    Anchor: (Height: 28);
                    Background: #1a1208(0.6);
                    LayoutMode: CenterMiddle;

                    Label #ProfilTitle {
                        Text: "";
                        Style: (FontSize: 12, TextColor: #D4AF37, HorizontalAlignment: Center, VerticalAlignment: Center);
                    }
                }

                Group { Anchor: (Height: 10); }

                // ========================================
                // XP Bar
                // ========================================
                Label #ProfilXPLabel {
                    Text: "";
                    Style: (FontSize: 13, TextColor: #8B7355, RenderBold: true);
                    Anchor: (Height: 20);
                }

                Group {
                    Anchor: (Height: 28);
                    Background: #C4A484;

                    ProgressBar #ProfilXPBar {
                        BarTexturePath: "../Status/XPFill.png";
                        Value: 0.0;
                    }
                }

                Group { Anchor: (Height: 8); }

                // ========================================
                // Mana Bar
                // ========================================
                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 20);

                    Label {
                        Text: "MANA";
                        Style: (FontSize: 13, TextColor: #8B4513, RenderBold: true);
                        Anchor: (Width: 55);
                    }
                    Label #ProfilMana {
                        Text: "";
                        Style: (FontSize: 13, TextColor: #6B4423);
                    }
                }

                Group {
                    Anchor: (Height: 24);
                    Background: #C4A484;

                    ProgressBar #ProfilManaBar {
                        BarTexturePath: "../Status/MPFill.png";
                        Value: 1.0;
                    }
                }

                Group { Anchor: (Height: 12); }

                // ========================================
                // POINTS DISPONIBLES
                // ========================================
                Group {
                    Anchor: (Height: 40);
                    Background: #1a1208(0.8);
                    LayoutMode: CenterMiddle;

                    Label #ProfilPoints {
                        Text: "";
                        Style: (FontSize: 20, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, LetterSpacing: 1);
                    }
                }

                Group { Anchor: (Height: 10); }

                // ========================================
                // ATTRIBUTS - 2 colonnes, cartes larges
                // ========================================
                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 190);

                    // Colonne gauche
                    Group {
                        LayoutMode: Top;
                        FlexWeight: 1;
                        Padding: (Right: 4);

                        // FORCE
                        Group {
                            Anchor: (Height: 56);
                            Background: #1a2030(0.7);
                            LayoutMode: Left;
                            Padding: (Horizontal: 12, Vertical: 6);

                            Label #ProfilStr {
                                Text: "";
                                Style: (FontSize: 16, TextColor: #d4c4a0, VerticalAlignment: Center, RenderBold: true);
                                FlexWeight: 1;
                            }
                            TextButton #BtnStr1 {
                                Text: "+1";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                            Group { Anchor: (Width: 4); }
                            TextButton #BtnStr5 {
                                Text: "+5";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                        }

                        Group { Anchor: (Height: 5); }

                        // VITALITE
                        Group {
                            Anchor: (Height: 56);
                            Background: #1a2030(0.7);
                            LayoutMode: Left;
                            Padding: (Horizontal: 12, Vertical: 6);

                            Label #ProfilVit {
                                Text: "";
                                Style: (FontSize: 16, TextColor: #d4c4a0, VerticalAlignment: Center, RenderBold: true);
                                FlexWeight: 1;
                            }
                            TextButton #BtnVit1 {
                                Text: "+1";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                            Group { Anchor: (Width: 4); }
                            TextButton #BtnVit5 {
                                Text: "+5";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                        }

                        Group { Anchor: (Height: 5); }

                        // INTELLIGENCE
                        Group {
                            Anchor: (Height: 56);
                            Background: #1a2030(0.7);
                            LayoutMode: Left;
                            Padding: (Horizontal: 12, Vertical: 6);

                            Label #ProfilInt {
                                Text: "";
                                Style: (FontSize: 16, TextColor: #d4c4a0, VerticalAlignment: Center, RenderBold: true);
                                FlexWeight: 1;
                            }
                            TextButton #BtnInt1 {
                                Text: "+1";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                            Group { Anchor: (Width: 4); }
                            TextButton #BtnInt5 {
                                Text: "+5";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                        }
                    }

                    // Colonne droite
                    Group {
                        LayoutMode: Top;
                        FlexWeight: 1;
                        Padding: (Left: 4);

                        // ENDURANCE
                        Group {
                            Anchor: (Height: 56);
                            Background: #1a2030(0.7);
                            LayoutMode: Left;
                            Padding: (Horizontal: 12, Vertical: 6);

                            Label #ProfilEnd {
                                Text: "";
                                Style: (FontSize: 16, TextColor: #d4c4a0, VerticalAlignment: Center, RenderBold: true);
                                FlexWeight: 1;
                            }
                            TextButton #BtnEnd1 {
                                Text: "+1";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                            Group { Anchor: (Width: 4); }
                            TextButton #BtnEnd5 {
                                Text: "+5";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                        }

                        Group { Anchor: (Height: 5); }

                        // AGILITE
                        Group {
                            Anchor: (Height: 56);
                            Background: #1a2030(0.7);
                            LayoutMode: Left;
                            Padding: (Horizontal: 12, Vertical: 6);

                            Label #ProfilAgl {
                                Text: "";
                                Style: (FontSize: 16, TextColor: #d4c4a0, VerticalAlignment: Center, RenderBold: true);
                                FlexWeight: 1;
                            }
                            TextButton #BtnAgl1 {
                                Text: "+1";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                            Group { Anchor: (Width: 4); }
                            TextButton #BtnAgl5 {
                                Text: "+5";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                        }

                        Group { Anchor: (Height: 5); }

                        // CHANCE
                        Group {
                            Anchor: (Height: 56);
                            Background: #1a2030(0.7);
                            LayoutMode: Left;
                            Padding: (Horizontal: 12, Vertical: 6);

                            Label #ProfilLck {
                                Text: "";
                                Style: (FontSize: 16, TextColor: #d4c4a0, VerticalAlignment: Center, RenderBold: true);
                                FlexWeight: 1;
                            }
                            TextButton #BtnLck1 {
                                Text: "+1";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                            Group { Anchor: (Width: 4); }
                            TextButton #BtnLck5 {
                                Text: "+5";
                                Anchor: (Width: 48, Height: 38);
                                Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #8B7355, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                                Background: #2a3040(0.8);
                            }
                        }
                    }
                }

                Group { Anchor: (Height: 10); }

                // ========================================
                // FOI & DIGNITE (lecture seule)
                // ========================================
                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 36);

                    Group {
                        Anchor: (Height: 36);
                        Background: #1a2030(0.5);
                        LayoutMode: Left;
                        Padding: (Horizontal: 14, Vertical: 4);
                        FlexWeight: 1;

                        Label {
                            Text: "FOI";
                            Style: (FontSize: 14, TextColor: #8899aa, RenderBold: true, VerticalAlignment: Center);
                            Anchor: (Width: 70);
                        }
                        Label #ProfilFaith {
                            Text: "0";
                            Style: (FontSize: 16, TextColor: #7EB8DA, VerticalAlignment: Center, RenderBold: true);
                        }
                    }

                    Group { Anchor: (Width: 6); }

                    Group {
                        Anchor: (Height: 36);
                        Background: #1a2030(0.5);
                        LayoutMode: Left;
                        Padding: (Horizontal: 14, Vertical: 4);
                        FlexWeight: 1;

                        Label {
                            Text: "DIGNITE";
                            Style: (FontSize: 14, TextColor: #8899aa, RenderBold: true, VerticalAlignment: Center);
                            Anchor: (Width: 90);
                        }
                        Label #ProfilDignity {
                            Text: "0";
                            Style: (FontSize: 16, TextColor: #C8A2C8, VerticalAlignment: Center, RenderBold: true);
                        }
                    }
                }

                Group { Anchor: (Height: 14); }

                // ========================================
                // STATISTIQUES PVP
                // ========================================
                Group { Anchor: (Height: 1); Background: #8B7355(0.3); }
                Group { Anchor: (Height: 8); }

                Label {
                    Text: "STATISTIQUES PVP";
                    Style: (FontSize: 14, TextColor: #cc4444, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, HorizontalAlignment: Center);
                    Anchor: (Height: 22);
                }

                Group { Anchor: (Height: 6); }

                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 36);

                    Group {
                        FlexWeight: 1;
                        Background: #1a2030(0.6);
                        LayoutMode: Left;
                        Padding: (Horizontal: 12, Vertical: 4);

                        Label {
                            Text: "KILLS";
                            Style: (FontSize: 12, TextColor: #8899aa, RenderBold: true, VerticalAlignment: Center);
                            Anchor: (Width: 70);
                        }
                        Label #StatKills {
                            Text: "0";
