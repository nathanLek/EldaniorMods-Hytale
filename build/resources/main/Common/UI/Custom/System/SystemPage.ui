            // ===== ONGLET GROUPE =====
            Group #TabGroupe {
                LayoutMode: Top;
                Visible: false;

                // --- PAS DE GROUPE ---
                Group #GroupeNoParty {
                    LayoutMode: Top;
                    Visible: true;

                    Group { Anchor: (Height: 80); }

                    Label {
                        Text: "VOUS N'ETES DANS AUCUN GROUPE";
                        Style: (FontSize: 18, TextColor: #667788, HorizontalAlignment: Center, RenderBold: true);
                        Anchor: (Height: 28);
                    }

                    Group { Anchor: (Height: 8); }

                    Label {
                        Text: "Creez un groupe pour jouer avec vos amis !";
                        Style: (FontSize: 13, TextColor: #556677, HorizontalAlignment: Center);
                        Anchor: (Height: 20);
                    }

                    Group { Anchor: (Height: 20); }

                    Group {
                        LayoutMode: Center;
                        Anchor: (Height: 44);

                        TextButton #GroupeBtnCreate {
                            Text: "CREER UN GROUPE";
                            Anchor: (Width: 250, Height: 44);
                            Style: (Default: (LabelStyle: (FontSize: 16, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 16, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                            Background: #1a1208(0.8);
                        }
                    }
                }

                // --- A UN GROUPE ---
                Group #GroupeHasParty {
                    LayoutMode: Top;
                    Visible: false;

                    // Header
                    Label #GroupeTitle {
                        Text: "GROUPE";
                        Style: (FontSize: 18, TextColor: #FFD700, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, HorizontalAlignment: Center);
                        Anchor: (Height: 26);
                    }

                    Group { Anchor: (Height: 8); }

                    // --- Captain actions: Invite + Disband ---
                    Group #GroupeCaptainActions {
                        LayoutMode: Left;
                        Anchor: (Height: 38);
                        Visible: false;

                        TextButton #GroupeBtnDisband {
                            Text: "DISSOUDRE";
