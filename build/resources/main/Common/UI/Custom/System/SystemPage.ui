                    Group { Anchor: (Width: 8); }
                    Group #SkillCard49 { FlexWeight: 1; Background: #1a2030(0.7); LayoutMode: Top; Padding: (Horizontal: 12, Vertical: 10); Visible: false; Label #SkillName49 { Text: ""; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 20); } Label #SkillType49 { Text: ""; Style: (FontSize: 11, TextColor: #D4AF37, RenderUppercase: true, RenderBold: true); Anchor: (Height: 16); } Label #SkillDesc49 { Text: ""; Style: (FontSize: 11, TextColor: #aabbcc, Wrap: true); Anchor: (Height: 36); } Label #SkillStats49 { Text: ""; Style: (FontSize: 11, TextColor: #4CAF50, RenderBold: true); Anchor: (Height: 16); } Group { FlexWeight: 1; } Group { LayoutMode: Right; Anchor: (Height: 28); TextButton #SkillToggle49 { Text: "ACTIVER"; Anchor: (Width: 100, Height: 28); Style: (Default: (LabelStyle: (FontSize: 12, TextColor: #4CAF50, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #1a3a1a(0.8); } } }
