                            Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #cc4444, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                            Background: #2a1a1a(0.7);
                        }
                    }

                    Group { Anchor: (Height: 8); }
                    Group { Anchor: (Height: 1); Background: #FFD700(0.2); }
                    Group { Anchor: (Height: 8); }

                    // --- Membre 0 ---
                    Group #GrpMember0 {
                        Anchor: (Height: 56);
                        Background: #1a2030(0.7);
                        LayoutMode: Left;
                        Padding: (Horizontal: 10, Vertical: 6);
                        Visible: false;

                        Group { Anchor: (Width: 40, Height: 44); LayoutMode: Top;
                            Label #GrpBadge0 { Text: ""; Style: (FontSize: 9, TextColor: #FFD700, HorizontalAlignment: Center, RenderBold: true); Anchor: (Height: 14); }
                            Label #GrpLevel0 { Text: ""; Style: (FontSize: 11, TextColor: #aabbcc, HorizontalAlignment: Center, RenderBold: true); Anchor: (Height: 18); }
                        }

                        Group { LayoutMode: Top; FlexWeight: 1; Padding: (Left: 8);
                            Label #GrpName0 { Text: ""; Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 20); }
                            Group { Anchor: (Height: 10); Background: #333a47; ProgressBar #GrpBar0 { BarTexturePath: "../Party/HPFill.png"; Value: 1.0; } }
