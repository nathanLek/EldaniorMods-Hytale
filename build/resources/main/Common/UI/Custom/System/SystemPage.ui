                Label {
                    Text: "COMMANDES AVANCEES";
                    Style: (FontSize: 11, TextColor: #667788, RenderBold: true, RenderUppercase: true, LetterSpacing: 1);
                    Anchor: (Height: 16);
                }
                Group { Anchor: (Height: 4); }
                Label { Text: "/es setclass <player> <warrior|mage|archer|assassin|dragon>"; Style: (FontSize: 10, TextColor: #556677); Anchor: (Height: 14); }
                Label { Text: "/es titleadmin grant <player> <titleId>"; Style: (FontSize: 10, TextColor: #556677); Anchor: (Height: 14); }
                Label { Text: "/es titleadmin remove <player> <titleId>"; Style: (FontSize: 10, TextColor: #556677); Anchor: (Height: 14); }
                Label { Text: "/es titleadmin reset <player> _"; Style: (FontSize: 10, TextColor: #556677); Anchor: (Height: 14); }
                Label { Text: "/es familyset <player> <familyId>"; Style: (FontSize: 10, TextColor: #556677); Anchor: (Height: 14); }
                Label { Text: "/es setlevel <player> <level>"; Style: (FontSize: 10, TextColor: #556677); Anchor: (Height: 14); }
                Label { Text: "/es addxp <player> <amount>"; Style: (FontSize: 10, TextColor: #556677); Anchor: (Height: 14); }
