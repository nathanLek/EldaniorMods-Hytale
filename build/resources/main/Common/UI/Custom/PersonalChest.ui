Group {
  LayoutMode: Center;

  Group #MainPanel {
    LayoutMode: Top;
    Anchor: (Width: 650, Height: 500);
    Background: #1a1a1a(0.95);
    Padding: (Full: 20);

    Label #Title {
      Text: "Coffre Personnel";
      Style: (
        FontSize: 28,
        TextColor: #ffdd00,
        HorizontalAlignment: Center,
        RenderBold: true
      );
      Anchor: (Height: 40);
    }

    Group {
      Anchor: (Height: 20);
    }

    Group #InventoryGrid {
      LayoutMode: Top;
      Anchor: (Height: 330);

      Group {
        LayoutMode: Left;
        Anchor: (Height: 70);
        Button #Slot0 { Anchor: (Width: 64, Height: 64); Padding: (Full: 4); Background: #2a2a2a; ItemIcon #Icon { Visible: false; } Label #Quantity { Visible: false; Style: (FontSize: 12, TextColor: #ffffff); } }
        Group { Anchor: (Width: 5); }
        Button #Slot1 { Anchor: (Width: 64, Height: 64); Padding: (Full: 4); Background: #2a2a2a; ItemIcon #Icon { Visible: false; } Label #Quantity { Visible: false; Style: (FontSize: 12, TextColor: #ffffff); } }
