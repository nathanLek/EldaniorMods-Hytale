    }

    Button #BtnClose {
      Anchor: (Width: 150, Height: 40);
      Background: #ff4444;
      Padding: (Full: 8);
      Style: (
        Hovered: (Background: #ff6666),
        Pressed: (Background: #dd2222)
      );

      Label {
        Text: "FERMER";
        Style: (
