items.skill_page_wind_step.description=<b>Rareté : Commun</b>\n<i>L'air semble porter vos pas.</i>\n\n<b>Effet :</b> +3% Vitesse de déplacement.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Réflexes Éclairs
items.skill_page_light_reflexes.name=Réflexes Éclairs
items.skill_page_light_reflexes.description=<b>Rareté : Commun</b>\n<i>Frappez avant que l'ennemi ne cligne des yeux.</i>\n\n<b>Effet :</b> +4% Vitesse d'attaque.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Souplesse
items.skill_page_suppleness.name=Souplesse
items.skill_page_suppleness.description=<b>Rareté : Commun</b>\n<i>Les montagnes d'Eldanior ne sont plus un obstacle.</i>\n\n<b>Effet :</b> +10% Hauteur de saut.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Sens Aiguisés
items.skill_page_keen_senses.name=Sens Aiguisés
items.skill_page_keen_senses.description=<b>Rareté : Commun</b>\n<i>Percevez les failles dans la garde adverse.</i>\n\n<b>Effet :</b> +2% Chance de Critique.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Athleticism
items.skill_page_athleticism.name=Athlétisme
items.skill_page_athleticism.description=<b>Rareté : Commun</b>\n<i>Un parchemin usé par le vent, détaillant les techniques de souffle des éclaireurs d'Eldanior.</i>\n\n<b>[Clic F]</b> pour apprendre la compétence.

# 1. Œil de Rapace
items.skill_page_eagle_eye.name=Œil de Rapace
items.skill_page_eagle_eye.description=<b>Rareté : Commun</b>\n<i>Votre regard perce les horizons lointains.</i>\n\n<b>Effet :</b> +15% Distance de détection.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Instinct de Survie
items.skill_page_survival_instinct.name=Instinct de Survie
items.skill_page_survival_instinct.description=<b>Rareté : Commun</b>\n<i>Ressentez le danger avant qu'il ne frappe.</i>\n\n<b>Effet :</b> +10% Conscience des menaces.\n\n<b>[Clic F]</b> pour apprendre.
# 3. Detection Universel
items.skill_page_universal_detection.name=Detection Universel
items.skill_page_universal_detection.description=<b>Rareté : Legendaire</b>\n<i>Ressentez le danger avant qu'il ne frappe.</i>\n\n<b>Effet :</b> +400% Conscience des menaces.\n\n<b>[Clic F]</b> pour apprendre.

# 1. Vision Nocturne
items.skill_page_night_vision.name=Vision Nocturne
items.skill_page_night_vision.description=<b>Rareté : Commun</b>\n<i>L'obscurité ne vous cache plus rien.</i>\n\n<b>Effet :</b> +20% Visibilité nocturne.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Sixième Sens
items.skill_page_sixth_sense.name=Sixième Sens
items.skill_page_sixth_sense.description=<b>Rareté : Commun</b>\n<i>Même l'invisible laisse une trace.</i>\n\n<b>Effet :</b> +5% Détection de l'invisibilité.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Pisteur
items.skill_page_tracker.name=Pisteur
items.skill_page_tracker.description=<b>Rareté : Commun</b>\n<i>Suivez votre proie à la trace.</i>\n\n<b>Effet :</b> +25% Clarté des pistes.\n\n<b>[Clic F]</b> pour apprendre.

# 1. Tono'Squive (Unique)
items.skill_page_tono_squive.name=Tono'Squive
items.skill_page_tono_squive.description=<b>Rareté : Unique</b>\n<i>Suivez l'enseignement du grand guerrier Tono.</i>\n\n<b>Effet :</b> Augmente vos chances d'esquive de 30%.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Jugement de Koda (Legendaire)
items.skill_page_koda_judgment.name=Jugement de Kodha
items.skill_page_koda_judgment.description=<b>Rareté : Légendaire</b>\n<i>Kodha ne frappe qu'une seule fois. Mais une fois suffit.</i>\n\n<b>Effet :</b> Si votre Endurance est à 90% lors d'une attaque, vous avez 12% de chance d'exécuter instantanément votre cible.\n• Les chances augmentent si l'ennemi est plus faible que vous.\n• Les chances diminuent si l'ennemi est plus fort.\n• Inefficace contre les cibles ayant 100 niveaux de plus que vous.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Mauvais Présage (Unique)
items.skill_page_mauvais_presage.name=Mauvais Présage
items.skill_page_mauvais_presage.description=<b>Rareté : Unique</b>\n<i>Un simple toucher suffit à drainer l'essence vitale de vos ennemis.</i>\n\n<b>Effet :</b> Vos attaques ont 10% de chance de maudire la cible.\n• Épuisement : L'Endurance de la cible est instantanément réduite à 0.\n• Toxine : Inflige des dégâts supplémentaires équivalents à 15% des Points de Vie <b>MAXIMAUX</b> de la cible.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Égide de Dyna (Divin)
items.skill_page_dyna_aegis.name=Égide de Dyna
items.skill_page_dyna_aegis.description=<b>Rareté : Divin</b>\n<i>Les dieux n'abandonnent jamais leurs champions.</i>\n\n<b>Effet :</b> Lorsque votre santé tombe à 50% ou moins, Dyna intervient pour vous rendre totalement invincible aux dégâts pendant 5 secondes.\nTemps de recharge : 2 minutes.\n\n<b>[Clic F]</b> pour apprendre.

# 1. Résolution de Fer (Commun)
items.skill_page_iron_resolve.name=Résolution de Fer
items.skill_page_iron_resolve.description=<b>Rareté : Commun</b>\n<i>Votre volonté est aussi dure que le fer.</i>\n\n<b>Effet :</b> Réduit tous les dégâts subis de 3 points.\n\n<b>[Clic F]</b> pour apprendre.

# 1. Parade Mineure (Commun)
items.skill_page_minor_parry.name=Parade Mineure
items.skill_page_minor_parry.description=<b>Rareté : Commun</b>\n<i>Un bon coup d'œil permet de dévier les attaques les plus évidentes.</i>\n\n<b>Effet :</b> 15% de chance de réduire les dégâts d'une attaque de 15%.\n\n<b>[Clic F]</b> pour apprendre.

# 1. Garde de Chasseur (Commun)
items.skill_page_hunter_guard.name=Garde de Chasseur
items.skill_page_hunter_guard.description=<b>Rareté : Commun</b>\n<i>L'expérience de la traque vous apprend à anticiper les coups des bêtes.</i>\n\n<b>Effet :</b> Réduit les dégâts infligés par les monstres de 10%.\n\n<b>[Clic F]</b> pour apprendre.

# 1. Corps Robuste (Commun)
items.skill_page_sturdy_body.name=Corps Robuste
items.skill_page_sturdy_body.description=<b>Rareté : Commun</b>\n<i>L'entraînement physique intensif porte enfin ses fruits.</i>\n\n<b>Effet :</b> Augmente passivement votre Endurance de 15 points.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Artisanat (Rare)
items.skill_page_artisanat.name=Artisanat
items.skill_page_artisanat.description=<b>Rareté : Rare</b>\n<i>Le savoir-faire manuel pour transformer des matières brutes en équipement.</i>\n\n<b>Effet :</b> Débloque l'utilisation de TOUS les établis et stations de confection.\n<color:gray>• Passe-partout : remplace toutes les compétences de craft individuelles.</color>\n\n<b>[Clic F]</b> pour apprendre.
items.skill_page_craft_cuisine.name=Cuisine
items.skill_page_craft_cuisine.description=<b>Rareté : Commun</b>\n<i>L'art de preparer des plats nourrissants.</i>\n\n<b>Effet :</b> Débloque l'utilisation du Bench Cooking.\n\n<b>[Clic F]</b> pour apprendre.
items.skill_page_craft_fonderie.name=Fonderie
items.skill_page_craft_fonderie.description=<b>Rareté : Commun</b>\n<i>Maîtrisez le feu pour fondre les minerais.</i>\n\n<b>Effet :</b> Débloque l'utilisation du Bench Furnace.\n\n<b>[Clic F]</b> pour apprendre.
items.skill_page_craft_armurerie.name=Armurerie
items.skill_page_craft_armurerie.description=<b>Rareté : Peu Commun</b>\n<i>Forgez des armures solides pour vous protéger.</i>\n\n<b>Effet :</b> Débloque l'utilisation du Bench Armour.\n\n<b>[Clic F]</b> pour apprendre.
items.skill_page_craft_forge_armes.name=Forge d'Armes
items.skill_page_craft_forge_armes.description=<b>Rareté : Peu Commun</b>\n<i>L'art de forger des lames et des armes mortelles.</i>\n\n<b>Effet :</b> Débloque l'utilisation du Bench Weapon.\n\n<b>[Clic F]</b> pour apprendre.
items.skill_page_craft_tannerie.name=Tannerie
items.skill_page_craft_tannerie.description=<b>Rareté : Commun</b>\n<i>Transformez les peaux en cuir résistant.</i>\n\n<b>Effet :</b> Débloque l'utilisation du Bench Tannery.\n\n<b>[Clic F]</b> pour apprendre.
items.skill_page_craft_alchimie.name=Alchimie
items.skill_page_craft_alchimie.description=<b>Rareté : Peu Commun</b>\n<i>Mélangez les ingrédients pour créer des potions.</i>\n\n<b>Effet :</b> Débloque l'utilisation du Bench Alchemy.\n\n<b>[Clic F]</b> pour apprendre.
items.skill_page_craft_scierie.name=Scierie
items.skill_page_craft_scierie.description=<b>Rareté : Commun</b>\n<i>Découpez le bois pour en faire des planches.</i>\n\n<b>Effet :</b> Débloque l'utilisation du Bench Lumbermill.\n\n<b>[Clic F]</b> pour apprendre.
items.skill_page_craft_agriculture.name=Agriculture
items.skill_page_craft_agriculture.description=<b>Rareté : Commun</b>\n<i>Cultivez la terre et récoltez ses fruits.</i>\n\n<b>Effet :</b> Débloque l'utilisation du Bench Farming.\n\n<b>[Clic F]</b> pour apprendre.
items.skill_page_craft_recyclage.name=Recyclage
items.skill_page_craft_recyclage.description=<b>Rareté : Commun</b>\n<i>Récupérez des matériaux à partir d'objets usés.</i>\n\n<b>Effet :</b> Débloque l'utilisation du Bench Salvage.\n\n<b>[Clic F]</b> pour apprendre.

# --- ENDURANCE ---
# 1. Souffle Inépuisable (Commun)
items.skill_page_tireless_breath.name=Souffle Inépuisable
items.skill_page_tireless_breath.description=<b>Rareté : Commun</b>\n<i>La fatigue n'est qu'une illusion de l'esprit.</i>\n\n<b>Effet :</b> Augmente passivement votre Endurance maximale de 10 points.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Peau Épaisse (Commun)
items.skill_page_thick_skin.name=Peau Épaisse
items.skill_page_thick_skin.description=<b>Rareté : Commun</b>\n<i>Les coups semblent glisser sur votre peau endurcie.</i>\n\n<b>Effet :</b> Augmente votre score de Défense d'Endurance de 5, réduisant passivement les dégâts subis.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Posture Solide (Commun)
items.skill_page_solid_stance.name=Posture Solide
items.skill_page_solid_stance.description=<b>Rareté : Commun</b>\n<i>Un corps reposé encaisse bien mieux les chocs.</i>\n\n<b>Effet :</b> Tant que votre Endurance est supérieure à 80%, tous les dégâts subis sont réduits de 10%.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Vigueur Combative (Commun)
items.skill_page_combat_vigor.name=Vigueur Combative
items.skill_page_combat_vigor.description=<b>Rareté : Commun</b>\n<i>L'adrénaline du combat nourrit vos muscles.</i>\n\n<b>Effet :</b> Chaque attaque portée a 20% de chance de vous rendre 5 points d'Endurance instantanément.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Second Souffle (Commun)
items.skill_page_second_wind.name=Second Souffle
items.skill_page_second_wind.description=<b>Rareté : Commun</b>\n<i>Quand tout semble perdu, l'instinct de survie prend le relais.</i>\n\n<b>Effet :</b> Subir un coup lorsque votre Endurance est sous la barre des 20% a 15% de chance de vous rendre immédiatement 25 points d'Endurance.\n\n<b>[Clic F]</b> pour apprendre.

# --- REGENERATION ---
# 1. Régénération Cellulaire (Commun)
items.skill_page_cellular_regeneration.name=Régénération Cellulaire
items.skill_page_cellular_regeneration.description=<b>Rareté : Commun</b>\n<i>Chaque blessure force votre corps à réagir violemment pour survivre.</i>\n\n<b>Effet :</b> Vous avez 15% de chance de restaurer 5% de vos Points de Vie maximaux à chaque fois que vous subissez des dégâts.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Respiration Active (Commun)
items.skill_page_active_breathing.name=Respiration Active
items.skill_page_active_breathing.description=<b>Rareté : Commun</b>\n<i>Une technique de respiration qui permet de frapper sans jamais s'épuiser.</i>\n\n<b>Effet :</b> Vos attaques ont 20% de chance de vous rendre immédiatement 8 points d'Endurance.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Siphon Spirituel (Commun)
items.skill_page_spiritual_siphon.name=Siphon Spirituel
items.skill_page_spiritual_siphon.description=<b>Rareté : Commun</b>\n<i>Le flux magique retourne toujours à sa source.</i>\n\n<b>Effet :</b> Vos attaques ont 20% de chance de vous restituer 5 points de Mana en drainant l'énergie de l'impact.\n\n<b>[Clic F]</b> pour apprendre.
# 1. Source de Mana (Commun)
items.skill_page_mana_font.name=Parchemin Magique : Source de Mana
items.skill_page_mana_font.description=<b>Rareté : Commun</b>\n<i>Votre corps agit comme un aimant pour les énergies environnantes.</i>\n\n<b>Effet :</b> Multiplie votre vitesse de régénération naturelle de Mana par 3 (Réduit le temps de recharge complet d'environ 3 heures à 1 heure).\n\n<b>[Clic F]</b> pour apprendre.


# Skill - Invocations
# COMMON
items.Pact_Summary.name=Pacte Sommaire
items.Pact_Summary.description=<b>Rareté : COMMUN</b>\n<b>Type </b>: INVOCATION\n"Un contrat éphémère pour une loyauté incertaine."\n\n<b>[Clic Droit]</b> Invoque un Goblin Mineur.\n <i>Coût : 60 Mana</i>\n <i>Temps d'activation : 1s</i>\n <i>Cooldown : 40s</i>

# UNCOMMON
items.Familiar_Link.name=Lien du Familier
items.Familiar_Link.description=<b>Rareté : INHABITUEL</b>\n<b>Type : INVOCATION</b>\n"Un pacte silencieux unissant le mage à sa bête astrale."\n\n<b>[Clic Droit]</b> Invoque un Loup d'Éther.\n <i>Coût : 150 Mana</i>\n <i>Temps d'activation : 3s</i>\n <i>Cooldown : 60s</i>

# RARE
items.Mastery_Of_Chimeras.name=Maîtrise des Chimères
items.Mastery_Of_Chimeras.description=<b>Rareté : RARE</b>\n<b>Type : INVOCATION</b>\n"Un affront aux lois de la nature, forgé dans la chair et la magie."\n\n<b>[Clic Droit]</b> Invoque une Bête Chimérique.\n <i>Coût : 300 Mana</i>\n <i>Temps d'activation : 3.5s</i>\n <i>Cooldown : 100s</i>

# EPIC
items.Seal_Of_The_Ancients.name=Sceau des Anciens
items.Seal_Of_The_Ancients.description=<b>Rareté : EPIQUE</b>\n<b>Type : INVOCATION</b>\n"La terre tremble, car le grimoire ordonne."\n\n<b>[Clic Droit]</b> Invoque L'Éveil du Gardien.\n <i>Coût : 1200 Mana</i>\n <i>Temps d'activation : 5s</i>\n <i>Cooldown : 180s</i>

# UNIQUE
items.Pact_Of_Forgotten_Blood.name=Pacte du Sang Oublié
items.Pact_Of_Forgotten_Blood.description=<b>Rareté : UNIQUE</b>\n<b>Type : INVOCATION</b>\n"Une goutte suffit à réveiller les cauchemars enfouis dans les veines du monde."\n\n<b>[Clic Droit]</b> Invoque un Limier de Sang.\n <i>Coût : 1950 Mana</i>\n <i>Temps d'activation : 3s</i>\n <i>Cooldown : 50s</i>\n\n<b>[Touche A]</b> Déclenche l'Incarnation du Sang Primordial.\n <i>Coût : 2200 Mana</i>\n <i>Temps d'activation : 6.5s</i>\n <i>Cooldown : 320s</i>

# LEGENDAIRE
items.Word_Of_Creation.name=Verbe de la Création
items.Word_Of_Creation.description=<b>Rareté : LEGENDAIRE</b>\n<b>Type : INVOCATION</b>\n"Une syllabe oubliée, murmurée à l'aube des temps pour forger le cosmos."\n\n<b>[Clic Droit]</b> Invoque un Héro de la Genèse.\n <i>Coût : 3400 Mana</i>\n <i>Temps d'activation : 5s</i>\n <i>Cooldown : 290s</i>\n\n<b>[Touche A]</b> Déclenche l'Incarnation du Premier Mot.\n <i>Coût : 3500 Mana</i>\n <i>Temps d'activation : 3s</i>\n <i>Cooldown : 450s</i>

# DIVIN
items.Decree_Of_Genesis.name=Décret de la Genèse
items.Decree_Of_Genesis.description=<b>Rareté : DIVIN</b>\n<b>Type : INVOCATION</b>\n"Au commencement était le Verbe, et le Verbe ordonna à la matière de s'éveiller."\n\n<b>[Clic Droit]</b> Invoque les Esprits Élémentaires.\n <i>Coût : 5500 Mana</i>\n <i>Temps d'activation : 8s</i>\n <i>Cooldown : 200s</i>\n\n<b>[Touche A]</b> Déclenche l'Émanation du Créateur.\n <i>Coût : 4000 Mana</i>\n <i>Temps d'activation : 4s</i>\n <i>Cooldown : 600s</i>

