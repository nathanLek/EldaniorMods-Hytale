                      Padding: (Left: 8, Top: 2);
                      Label #BankCoinName0 { Style: (FontSize: 14, RenderBold: true, TextColor: #f0c868); }
                      Label #BankCoinRate0 { Style: (FontSize: 10, TextColor: #6f8296); }
                    }
                    Label #BankCoinCount0 {
                      Anchor: (Width: 52);
                      Style: (FontSize: 18, RenderBold: true, TextColor: #d1dae6, HorizontalAlignment: End, VerticalAlignment: Center);
                    }
                  }
                  Group { Anchor: (Height: 8); }
                  Group {
                    Anchor: (Height: 30);
