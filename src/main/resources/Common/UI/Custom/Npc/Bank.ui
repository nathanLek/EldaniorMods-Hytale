                  Padding: (Left: 10, Right: 10, Top: 8, Bottom: 8);
                  Group {
                    Anchor: (Height: 44);
                    LayoutMode: Left;
                    ItemIcon #BankCoinIcon0 { Anchor: (Width: 42, Height: 42); }
                    Group {
                      FlexWeight: 1;
