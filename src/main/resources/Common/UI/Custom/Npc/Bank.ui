                  Group { Anchor: (Height: 8); }
                  Group {
                    Anchor: (Height: 30);
                    LayoutMode: Left;
                    Button #BankUp6 {
                FlexWeight: 1; Anchor: (Height: 30, Right: 3);
                LayoutMode: Middle;
                Style: (
                  Default: (Background: #1b2a3b),
                  Hovered: (Background: #26394f),
                  Pressed: (Background: #26394f),
                  Sounds: $C.@ButtonSounds
                );
                Label #BankUp6Text {
                  Text: "↑ Regrouper";
                  Style: (FontSize: 11, RenderBold: true, RenderUppercase: true, TextColor: #9fd3a8, HorizontalAlignment: Center, VerticalAlignment: Center);
                }
              }
                    Button #BankDown6 {
                FlexWeight: 1; Anchor: (Height: 30, Left: 3);
                LayoutMode: Middle;
                Style: (
                  Default: (Background: #1b2a3b),
                  Hovered: (Background: #26394f),
                  Pressed: (Background: #26394f),
                  Sounds: $C.@ButtonSounds
                );
                Label #BankDown6Text {
                  Text: "↓ Casser";
                  Style: (FontSize: 11, RenderBold: true, RenderUppercase: true, TextColor: #e3c27a, HorizontalAlignment: Center, VerticalAlignment: Center);
                }
              }
                  }
                }
            }
            Group {
              Anchor: (Top: 8, Height: 34);
              LayoutMode: Center;
              Button #BankTidy {
                Anchor: (Height: 34, Width: 420);
                LayoutMode: Middle;
                Style: (
                  Default: (Background: #1b2a3b),
                  Hovered: (Background: #26394f),
                  Pressed: (Background: #26394f),
                  Sounds: $C.@ButtonSounds
                );
                Label #BankTidyText {
                  Text: "Tout regrouper : le moins de pièces possible";
                  Style: (FontSize: 12, RenderBold: true, RenderUppercase: true, TextColor: #d1dae6, HorizontalAlignment: Center, VerticalAlignment: Center);
                }
              }
            }
          }

          // ===== Panneau Prets (BankLoans, 2026-11-12) =====
          Group #BankPanel2 {
            Anchor: (Top: 12, Height: 268);
            LayoutMode: Top;
            Visible: false;
            Group {
              Anchor: (Height: 54);
              LayoutMode: Left;
              Group {
                FlexWeight: 1;
                Anchor: (Right: 4, Height: 54);
                LayoutMode: Left;
                Background: #101b28;
                Group { Anchor: (Width: 4); Background: #d4af37; }
                Group {
                  FlexWeight: 1;
                  LayoutMode: Top;
                  Padding: (Left: 10, Top: 6);
                  Label { Text: "Vous pouvez emprunter"; Style: (FontSize: 10, RenderBold: true, RenderUppercase: true, TextColor: #6f8296); }
                  Label #BankLoanMax { Style: (FontSize: 17, RenderBold: true, TextColor: #f0c868); }
                  Label #BankLoanMaxSub { Style: (FontSize: 10, TextColor: #6f8296); }
                }
              }
              Group {
                FlexWeight: 1;
                Anchor: (Left: 4, Height: 54);
                LayoutMode: Left;
                Background: #101b28;
                Group { Anchor: (Width: 4); Background: #e0796b; }
                Group {
                  FlexWeight: 1;
                  LayoutMode: Top;
                  Padding: (Left: 10, Top: 6);
                  Label { Text: "Dette envers la banque"; Style: (FontSize: 10, RenderBold: true, RenderUppercase: true, TextColor: #6f8296); }
                  Label #BankLoanDue { Style: (FontSize: 17, RenderBold: true, TextColor: #f0c868); }
                  Label #BankLoanTime { Style: (FontSize: 10, TextColor: #6f8296); }
                }
              }
            }
            Label {
              Anchor: (Top: 8);
              Text: "Montant";
              Style: (FontSize: 11, RenderBold: true, RenderUppercase: true, TextColor: #6f8296);
            }
            Group {
              Anchor: (Top: 4, Height: 32);
              LayoutMode: Left;
              $C.@NumberField #BankLoanAmount {
                FlexWeight: 1;
                Anchor: (Height: 30);
                Format: (MaxDecimalPlaces: 0, Step: 1);
              }
              Group { Anchor: (Width: 8); }
              $C.@DropdownBox #BankLoanUnit {
                Anchor: (Width: 220, Height: 30);
                Style: @DefaultDropdownBoxStyle;
              }
            }
            Group {
              Anchor: (Top: 8, Height: 38);
              LayoutMode: Left;
              Button #BankBorrow {
                FlexWeight: 1; Anchor: (Right: 3, Height: 38);
                LayoutMode: Middle;
                Style: (
                  Default: (Background: #5a4318),
                  Hovered: (Background: #78591f),
                  Pressed: (Background: #78591f),
                  Sounds: $C.@ButtonSounds
                );
                Label #BankBorrowText {
                  Text: "Emprunter";
                  Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #ffe7a8, HorizontalAlignment: Center, VerticalAlignment: Center);
                }
              }
              Button #BankRepay {
                FlexWeight: 1; Anchor: (Left: 3, Height: 38);
                LayoutMode: Middle;
                Style: (
                  Default: (Background: #1f4a32),
                  Hovered: (Background: #2b6544),
                  Pressed: (Background: #2b6544),
                  Sounds: $C.@ButtonSounds
                );
                Label #BankRepayText {
                  Text: "Rembourser";
                  Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #c8f0d2, HorizontalAlignment: Center, VerticalAlignment: Center);
                }
              }
              Button #BankRepayAll {
                FlexWeight: 1; Anchor: (Left: 3, Height: 38);
                LayoutMode: Middle;
                Style: (
                  Default: (Background: #1b2a3b),
                  Hovered: (Background: #26394f),
                  Pressed: (Background: #26394f),
                  Sounds: $C.@ButtonSounds
                );
                Label #BankRepayAllText {
                  Text: "Tout rembourser";
                  Style: (FontSize: 12, RenderBold: true, RenderUppercase: true, TextColor: #9fd3a8, HorizontalAlignment: Center, VerticalAlignment: Center);
                }
              }
            }
            Group {
              Anchor: (Top: 8, Height: 86);
              LayoutMode: Left;
              Background: #2a1414;
              Group { Anchor: (Width: 4); Background: #e0796b; }
              Label #BankLoanRules {
                FlexWeight: 1;
                Padding: (Left: 10, Right: 10, Top: 6);
                Style: (FontSize: 11, TextColor: #f1c3ba, Wrap: true);
              }
            }
          }

          // ===== Message, fermer =====
          Group {
            Anchor: (Top: 10, Height: 30);
            LayoutMode: Left;
            Background: #101b28;
            Group #BankMsgBar { Anchor: (Width: 4); Background: #8fd18f; }
            Label #BankMsg {
              FlexWeight: 1;
              Style: (FontSize: 13, RenderBold: true, TextColor: #8fd18f, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }
          Group {
            Anchor: (Top: 10, Height: 40);
            LayoutMode: Center;
            $C.@SecondaryTextButton #BankClose { @Anchor = Anchor(MinWidth: 220); Text: "Fermer"; }
          }
        }
      }
    }
  }
}
