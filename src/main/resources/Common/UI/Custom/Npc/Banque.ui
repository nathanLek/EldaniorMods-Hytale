    // ---- replique du banquier ----
    Label #BqQuote {
      Anchor: (Left: 611, Top: 136, Width: 1260, Height: 46);
      Style: (FontSize: 17, RenderBold: true, TextColor: #C58643, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
    }

    // ---- onglet 0 : deposer / retirer ----
    Group #BqPanel0 {
      Anchor: (Left: 611, Top: 196, Width: 1260, Height: 740);
      Group { Anchor: (Left: 0, Top: 0, Width: 620, Height: 448); Background: (TexturePath: "../Quest/QHudPatch.png", Border: 16); }
      Label {
        Anchor: (Left: 24, Top: 16, Width: 572, Height: 34);
      Text: "Déposer";
        Style: (FontName: "Secondary", FontSize: 26, RenderBold: true, TextColor: #f2c45e, RenderUppercase: true, VerticalAlignment: Center);
      }
      Label #BqDepFlow {
        Anchor: (Left: 24, Top: 52, Width: 572, Height: 24);
      Text: "Sac  →  Banque";
        Style: (FontSize: 15, RenderBold: true, TextColor: #8fd18f, RenderUppercase: true, VerticalAlignment: Center);
      }
      Label {
        Anchor: (Left: 24, Top: 78, Width: 572, Height: 22);
      Text: "Vos pièces quittent le sac et sont mises à l'abri à la banque.";
        Style: (FontSize: 14, RenderBold: true, TextColor: #77879D, VerticalAlignment: Center, Wrap: true);
      }
      Group { Anchor: (Left: 24, Top: 108, Width: 572, Height: 8); Background: (TexturePath: "../Quest/ChapDivider.png", HorizontalBorder: 24, VerticalBorder: 0); }
      Label {
        Anchor: (Left: 24, Top: 126, Width: 572, Height: 20);
      Text: "Somme en cuivres (100 = 1 or)";
        Style: (FontSize: 12, RenderBold: true, TextColor: #77879D, RenderUppercase: true, VerticalAlignment: Center);
      }
      Group {
        Anchor: (Left: 24, Top: 150, Width: 230, Height: 40);
        $C.@NumberField #BqDepAmount {
          Anchor: (Left: 0, Top: 0, Width: 230, Height: 40);
          Format: (MaxDecimalPlaces: 0, Step: 100);
        }
      }
      Label #BqDepWorth {
        Anchor: (Left: 268, Top: 150, Width: 328, Height: 40);
        Style: (FontSize: 15, RenderBold: true, TextColor: #f2c45e, VerticalAlignment: Center, Wrap: true, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10);
      }
      Label #BqDepPreview {
        Anchor: (Left: 24, Top: 198, Width: 572, Height: 52);
      Text: "";
        Style: (FontSize: 15, RenderBold: true, TextColor: #b8c2d0, VerticalAlignment: Center, Wrap: true);
      }
      Group {
        Anchor: (Left: 24, Top: 260, Width: 572, Height: 50);
        $C.@TextButton #BqDepGo {
          @Anchor = Anchor(Left: 0, Top: 0, Width: 572);
          Text: "Déposer";
        }
      }
      Label {
        Anchor: (Left: 24, Top: 356, Width: 572, Height: 20);
      Text: "Raccourcis";
        Style: (FontSize: 12, RenderBold: true, TextColor: #77879D, RenderUppercase: true, VerticalAlignment: Center);
      }
      Group {
        Anchor: (Left: 24, Top: 384, Width: 137, Height: 44);
        $C.@SecondaryTextButton #BqDepQ0 {
          @Anchor = Anchor(Left: 0, Top: 0, Width: 137);
          Text: "Tout le sac";
        }
      }
      Group {
        Anchor: (Left: 169, Top: 384, Width: 137, Height: 44);
        $C.@SecondaryTextButton #BqDepQ1 {
          @Anchor = Anchor(Left: 0, Top: 0, Width: 137);
