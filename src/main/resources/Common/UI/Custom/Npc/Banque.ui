$C = "../Common.ui";

// Banque (guards/BankPage), facon fenetre Chapitres. Generee par scripts/npcs/gen_banque_ui.py : voir ce script.
Group {
  LayoutMode: Middle;
  Background: (TexturePath: "../Quest/ChapBackground.png");

  Group #BqPage {
    Anchor: (Width: 1920, Height: 1080);

    // ---- fond : voile de droite, bande d'encre, lueur, eclats ----
    Group { Anchor: (Left: 1003, Top: 0, Width: 917, Height: 1080); Background: #181822(0.5); }
    Group { Anchor: (Left: 499, Top: 0, Width: 504, Height: 1080); Background: (TexturePath: "../Quest/ChapSeparator.png"); }
    Group { Anchor: (Left: 480, Top: 25, Width: 488, Height: 1055); Background: (TexturePath: "../Quest/ChapGlows.png"); }
    Group { Anchor: (Left: 0, Top: 0, Width: 1920, Height: 1080); Background: (TexturePath: "../Quest/ChapShards.png"); }
    Group { Anchor: (Left: 599, Top: 0, Width: 1321, Height: 1080); Background: #0b0b12(0.45); }

    // ---- onglets ----
    Group { Anchor: (Left: 603, Top: 28, Width: 1276, Height: 96); Background: #0b0b12(0.55); }
    Group { Anchor: (Left: 603, Top: 124, Width: 1276, Height: 8); Background: (TexturePath: "../Quest/ChapDivider.png", HorizontalBorder: 24, VerticalBorder: 0); }
    Button #BqTab0 {
      Anchor: (Left: 611, Top: 34, Width: 408, Height: 84);
      Style: (Default: (Background: #000000(0)), Hovered: (Background: (TexturePath: "../Quest/QHudPatch.png", Border: 16)), Pressed: (Background: (TexturePath: "../Quest/ChapSlot.png", Border: 23)), Sounds: $C.@ButtonSounds);
      Group #BqTabGlow0 { Anchor: (Left: 0, Top: 0, Width: 408, Height: 84); Background: (TexturePath: "../Quest/ChapSlot.png", Border: 23); Visible: false; }
      ItemIcon #BqTabIcon0 { Anchor: (Left: 18, Top: 18, Width: 48, Height: 48); }
      Label #BqTabLabel0 {
        Anchor: (Left: 80, Top: 14, Width: 312, Height: 26);
        Style: (FontName: "Secondary", FontSize: 20, RenderBold: true, RenderUppercase: true, TextColor: #96a9be, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 12);
      }
      Label #BqTabSub0 {
        Anchor: (Left: 80, Top: 42, Width: 312, Height: 26);
        Style: (FontSize: 13, RenderBold: true, TextColor: #77879D, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10);
      }
      Group #BqTabOn0 { Anchor: (Left: 18, Top: 79, Width: 372, Height: 3); Background: #f2c45e; Visible: false; }
    }
    Button #BqTab1 {
      Anchor: (Left: 1037, Top: 34, Width: 408, Height: 84);
      Style: (Default: (Background: #000000(0)), Hovered: (Background: (TexturePath: "../Quest/QHudPatch.png", Border: 16)), Pressed: (Background: (TexturePath: "../Quest/ChapSlot.png", Border: 23)), Sounds: $C.@ButtonSounds);
      Group #BqTabGlow1 { Anchor: (Left: 0, Top: 0, Width: 408, Height: 84); Background: (TexturePath: "../Quest/ChapSlot.png", Border: 23); Visible: false; }
      ItemIcon #BqTabIcon1 { Anchor: (Left: 18, Top: 18, Width: 48, Height: 48); }
      Label #BqTabLabel1 {
        Anchor: (Left: 80, Top: 14, Width: 312, Height: 26);
        Style: (FontName: "Secondary", FontSize: 20, RenderBold: true, RenderUppercase: true, TextColor: #96a9be, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 12);
      }
      Label #BqTabSub1 {
