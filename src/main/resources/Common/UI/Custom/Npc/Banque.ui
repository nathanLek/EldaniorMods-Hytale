        }
      }
      Group #BqRepayBox {
        Anchor: (Left: 24, Top: 350, Width: 572, Height: 110);
        Visible: false;
        Group {
          Anchor: (Left: 0, Top: 0, Width: 572, Height: 50);
          $C.@TextButton #BqRepay {
            @Anchor = Anchor(Left: 0, Top: 0, Width: 572);
            Text: "Rembourser cette somme";
          }
        }
        Group {
          Anchor: (Left: 0, Top: 58, Width: 572, Height: 44);
          $C.@SecondaryTextButton #BqRepayAll {
            @Anchor = Anchor(Left: 0, Top: 0, Width: 572);
            Text: "Tout rembourser";
          }
        }
      }
      Group { Anchor: (Left: 640, Top: 0, Width: 620, Height: 560); Background: (TexturePath: "../Quest/QHudPatch.png", Border: 16); }
      Label {
        Anchor: (Left: 664, Top: 16, Width: 572, Height: 34);
      Text: "Règles du prêt";
        Style: (FontName: "Secondary", FontSize: 26, RenderBold: true, TextColor: #f2c45e, RenderUppercase: true, VerticalAlignment: Center);
      }
      Group { Anchor: (Left: 664, Top: 56, Width: 572, Height: 8); Background: (TexturePath: "../Quest/ChapDivider.png", HorizontalBorder: 24, VerticalBorder: 0); }
      Group { Anchor: (Left: 664, Top: 78, Width: 20, Height: 20); Background: (TexturePath: "../Quest/ChapBullet.png"); }
      Label {
        Anchor: (Left: 694, Top: 76, Width: 542, Height: 70);
      Text: "Vous pouvez emprunter jusqu'à 3 fois ce que vous possédez (sac + banque). Un seul prêt à la fois.";
        Style: (FontSize: 15, RenderBold: true, TextColor: #b8c2d0, Wrap: true);
      }
      Group { Anchor: (Left: 664, Top: 154, Width: 20, Height: 20); Background: (TexturePath: "../Quest/ChapBullet.png"); }
      Label {
        Anchor: (Left: 694, Top: 152, Width: 542, Height: 70);
      Text: "Vous rendez la somme + 20 % d'intérêts, ici, depuis votre compte en banque, dans les 7 jours.";
        Style: (FontSize: 15, RenderBold: true, TextColor: #b8c2d0, Wrap: true);
      }
      Group { Anchor: (Left: 664, Top: 230, Width: 20, Height: 20); Background: (TexturePath: "../Quest/ChapBullet.png"); }
      Label {
        Anchor: (Left: 694, Top: 228, Width: 542, Height: 70);
      Text: "Pour rembourser, déposez d'abord vos pièces dans l'onglet Déposer / Retirer.";
        Style: (FontSize: 15, RenderBold: true, TextColor: #b8c2d0, Wrap: true);
      }
      Group { Anchor: (Left: 664, Top: 306, Width: 20, Height: 20); Background: (TexturePath: "../Quest/ChapBullet.png"); }
      Label {
        Anchor: (Left: 694, Top: 304, Width: 542, Height: 70);
      Text: "Passé 7 jours, la banque met une prime sur votre tête : vous devenez CRIMINEL ÉTOILÉ, traqué par les chasseurs de prime.";
        Style: (FontSize: 15, RenderBold: true, TextColor: #e8b48a, Wrap: true);
      }
      Group { Anchor: (Left: 664, Top: 382, Width: 20, Height: 20); Background: (TexturePath: "../Quest/ChapBullet.png"); }
      Label {
        Anchor: (Left: 694, Top: 380, Width: 542, Height: 70);
      Text: "Si vous mourez alors, vous perdez TOUT : niveau 1, classe, objets, argent, famille et guilde.";
        Style: (FontSize: 15, RenderBold: true, TextColor: #e8b48a, Wrap: true);
      }
      Group { Anchor: (Left: 664, Top: 458, Width: 20, Height: 20); Background: (TexturePath: "../Quest/ChapBullet.png"); }
      Label {
        Anchor: (Left: 694, Top: 456, Width: 542, Height: 70);
      Text: "Solder la dette, même en retard, lève la prime.";
        Style: (FontSize: 15, RenderBold: true, TextColor: #e8b48a, Wrap: true);
      }
    }

