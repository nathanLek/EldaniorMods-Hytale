    // ---- onglet 1 : change ----
    Group #BqPanel1 {
      Anchor: (Left: 611, Top: 196, Width: 1260, Height: 740);
      Visible: false;
      Group { Anchor: (Left: 0, Top: 0, Width: 1260, Height: 92); Background: (TexturePath: "../Quest/QHudPatch.png", Border: 16); }
