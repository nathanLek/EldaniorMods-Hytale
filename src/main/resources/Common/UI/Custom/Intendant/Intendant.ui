    // ---- pages ----
    Group {
      Anchor: (Left: 611, Top: 892, Width: 1248, Height: 40);
      LayoutMode: Center;
      Group #IntPager {
        LayoutMode: Left;
        Visible: false;
        $C.@SmallSecondaryTextButton #IntPrev {
          @Anchor = Anchor(Width: 130, Right: 14);
          Text: "Précédente";
        }
        Label #IntPageLabel {
          Anchor: (Width: 90);
          Style: (FontSize: 15, RenderBold: true, TextColor: #b8c2d0, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
        $C.@SmallSecondaryTextButton #IntNext {
          @Anchor = Anchor(Width: 130, Left: 14);
          Text: "Suivante";
        }
      }
    }

    Group {
      Anchor: (Left: 1639, Top: 960, Width: 220, Height: 44);
      $C.@SecondaryTextButton #IntClose {
        @Anchor = Anchor(Left: 0, Top: 0, Width: 220);
        Text: "Fermer";
      }
    }
    Label #IntPurse {
      Anchor: (Left: 611, Top: 960, Width: 760, Height: 44);
      Style: (FontSize: 15, RenderBold: true, TextColor: #b8c2d0, VerticalAlignment: Center);
    }
    Label {
      Anchor: (Left: 1639, Top: 1010, Width: 220, Height: 24);
      Text: "Échap  ·  Retour";
      Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #77879d, HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    // ---- fiche (refaite le 2026-11-19 : embleme compact, faits, actions groupees) ----
    Group { Anchor: (Left: 80, Top: 20, Width: 445, Height: 1040); Background: #0b0b12(0.35); }
    Group { Anchor: (Left: 219, Top: 30, Width: 168, Height: 168); Background: (TexturePath: "../Quest/ChapEmblemFrame.png"); }
    Group { Anchor: (Left: 249, Top: 60, Width: 108, Height: 108); Background: (TexturePath: "../Quest/ChapEmblemBack.png"); }
