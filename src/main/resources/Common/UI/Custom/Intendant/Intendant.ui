$C = "../Common.ui";

// Registre de la maison (intendant), facon fenetre Chapitres. Genere par scripts/intendant/gen_intendant_ui.py.
Group {
  LayoutMode: Middle;
  Background: (TexturePath: "../Quest/ChapBackground.png");

