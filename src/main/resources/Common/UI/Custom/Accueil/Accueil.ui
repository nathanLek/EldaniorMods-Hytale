$C = "../Common.ui";

// Fenetre a cartes d'Eldanior : accueil (accueil/WelcomePage) et statue des classes (classes/gui/ClassChoicePage),
// generee par scripts/accueil/gen_accueil_ui.py.
Group {
  LayoutMode: Middle;
  Background: (TexturePath: "AccBackground.png");

  Group #AccPage {
    Anchor: (Width: 1920, Height: 1080);

    // ---- fond : carte du continent (AccBackground), bande d'encre, lueur, ombre, eclats ----
    Group { Anchor: (Left: 499, Top: 0, Width: 504, Height: 1080); Background: (TexturePath: "../Quest/ChapSeparator.png"); }
    Group { Anchor: (Left: 480, Top: 25, Width: 488, Height: 1055); Background: (TexturePath: "../Quest/ChapGlows.png"); }
    Group { Anchor: (Left: 615, Top: 194, Width: 391, Height: 736); Background: (TexturePath: "../Quest/ChapShadow.png"); }
    Group { Anchor: (Left: 0, Top: 0, Width: 1920, Height: 1080); Background: (TexturePath: "../Quest/ChapShards.png"); }

    // ---- bandeau Eldanior ----
    Group { Anchor: (Left: 0, Top: 0, Width: 1920, Height: 100); Background: #05070f(0.62); }
    Group { Anchor: (Left: 0, Top: 100, Width: 1920, Height: 2); Background: #c58643(0.55); }
    Group { Anchor: (Left: 64, Top: 12, Width: 76, Height: 76); Background: (TexturePath: "AccCrest.png"); }
    Label {
      Anchor: (Left: 152, Top: 10, Width: 420, Height: 50);
      Text: "Eldanior";
      Style: (FontName: "Secondary", FontSize: 42, RenderBold: true, RenderUppercase: true, TextColor: #f2c45e, VerticalAlignment: Center);
    }
    Label #AccBrandSub {
      Anchor: (Left: 154, Top: 58, Width: 440, Height: 26);
      Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #b9a2d8, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10);
    }
    Group #AccSteps {
      Anchor: (Left: 611, Top: 18, Width: 1105, Height: 66);
      Button #AccStep0 {
        Anchor: (Left: 0, Top: 0, Width: 262, Height: 64);
        Style: (Default: (Background: #000000(0)), Hovered: (Background: #ffffff(0.05)), Sounds: $C.@ButtonSounds);
        Group #AccStepOff0 { Anchor: (Left: 6, Top: 13, Width: 38, Height: 38); Background: (TexturePath: "../Quest/ChapCheckOff.png"); }
        Group #AccStepOn0 { Anchor: (Left: 6, Top: 13, Width: 38, Height: 38); Background: (TexturePath: "../Quest/ChapCheckOn.png"); Visible: false; }
        Label #AccStepNum0 {
          Anchor: (Left: 6, Top: 13, Width: 38, Height: 38);
          Style: (FontName: "Secondary", FontSize: 17, RenderBold: true, TextColor: #1b1420, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
        Label #AccStepLbl0 {
          Anchor: (Left: 54, Top: 0, Width: 202, Height: 64);
          Style: (FontName: "Secondary", FontSize: 21, RenderBold: true, RenderUppercase: true, TextColor: #77879d, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 14);
        }
        Group #AccStepBar0 { Anchor: (Left: 6, Top: 60, Width: 242, Height: 3); Background: #f2c45e; Visible: false; }
      }
      Button #AccStep1 {
        Anchor: (Left: 276, Top: 0, Width: 262, Height: 64);
        Style: (Default: (Background: #000000(0)), Hovered: (Background: #ffffff(0.05)), Sounds: $C.@ButtonSounds);
        Group #AccStepOff1 { Anchor: (Left: 6, Top: 13, Width: 38, Height: 38); Background: (TexturePath: "../Quest/ChapCheckOff.png"); }
        Group #AccStepOn1 { Anchor: (Left: 6, Top: 13, Width: 38, Height: 38); Background: (TexturePath: "../Quest/ChapCheckOn.png"); Visible: false; }
        Label #AccStepNum1 {
          Anchor: (Left: 6, Top: 13, Width: 38, Height: 38);
          Style: (FontName: "Secondary", FontSize: 17, RenderBold: true, TextColor: #1b1420, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
        Label #AccStepLbl1 {
          Anchor: (Left: 54, Top: 0, Width: 202, Height: 64);
          Style: (FontName: "Secondary", FontSize: 21, RenderBold: true, RenderUppercase: true, TextColor: #77879d, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 14);
        }
        Group #AccStepBar1 { Anchor: (Left: 6, Top: 60, Width: 242, Height: 3); Background: #f2c45e; Visible: false; }
      }
      Button #AccStep2 {
