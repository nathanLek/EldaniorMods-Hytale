    Button #AccPrev {
      Anchor: (Left: 553, Top: 547, Width: 40, Height: 80);
      Visible: false;
      Style: (Default: (Background: #000000(0)), Hovered: (Background: #000000(0)), Sounds: $C.@ButtonSounds);
      Group { Anchor: (Left: 0, Top: 0, Width: 40, Height: 80); Background: (TexturePath: "../Quest/ChapArrowLeft.png"); }
    }
    Button #AccNext {
      Anchor: (Left: 1734, Top: 547, Width: 40, Height: 80);
      Visible: false;
      Style: (Default: (Background: #000000(0)), Hovered: (Background: #000000(0)), Sounds: $C.@ButtonSounds);
      Group { Anchor: (Left: 0, Top: 0, Width: 40, Height: 80); Background: (TexturePath: "../Quest/ChapArrowRight.png"); }
    }
    Label #AccCount {
      Anchor: (Left: 611, Top: 914, Width: 1105, Height: 22);
      Style: (FontSize: 14, RenderBold: true, TextColor: #8a96a8, HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    // ---- actions ----
    Group {
      Anchor: (Left: 611, Top: 948, Width: 1105, Height: 48);
      LayoutMode: Center;
      $C.@SecondaryTextButton #AccBack {
        @Anchor = (MinWidth: 180, Right: 16);
        Text: "Retour";
        Visible: false;
      }
      $C.@SecondaryTextButton #AccAlt {
        @Anchor = (MinWidth: 200, Right: 16);
        Text: "Relancer";
        Visible: false;
      }
      $C.@TextButton #AccMain {
        @Anchor = Anchor(MinWidth: 320);
        Text: "Suivant";
      }
    }
    Label #AccHint {
      Anchor: (Left: 611, Top: 1004, Width: 1105, Height: 24);
      Style: (FontSize: 15, RenderBold: true, TextColor: #8a96a8, HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    // ---- detail de la carte designee ----
    Group #AccDetail {
      Anchor: (Left: 0, Top: 0, Width: 540, Height: 1080);

      Group { Anchor: (Left: 228, Top: 116, Width: 150, Height: 150); Background: (TexturePath: "../Quest/ChapEmblemFrame.png"); }
      Group { Anchor: (Left: 255, Top: 141, Width: 96, Height: 96); Background: (TexturePath: "../Quest/ChapEmblemBack.png"); }
      Label #AccMark {
        Anchor: (Left: 255, Top: 143, Width: 96, Height: 86);
        Style: (FontName: "Secondary", FontSize: 52, RenderBold: true, TextColor: #ffe98a, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 26);
      }

      Label #AccKicker {
        Anchor: (Left: 96, Top: 270, Width: 415, Height: 22);
        Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #b9a2d8, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10);
      }
      Label #AccTitle {
        Anchor: (Left: 96, Top: 294, Width: 415, Height: 44);
        Style: (FontName: "Secondary", FontSize: 30, RenderBold: true, RenderUppercase: true, TextColor: #f2c45e, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 18);
      }
      Label #AccTagline {
        Anchor: (Left: 96, Top: 338, Width: 415, Height: 28);
        Style: (FontSize: 19, RenderBold: true, TextColor: #C58643, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 13);
      }
      Group { Anchor: (Left: 94, Top: 372, Width: 418, Height: 8); Background: (TexturePath: "../Quest/ChapDivider.png", HorizontalBorder: 24, VerticalBorder: 0); }

