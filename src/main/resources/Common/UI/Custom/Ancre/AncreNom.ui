$C = "../Common.ui";

// Cercle d'Ancrage : nommer ou renommer une ancre (AnchorNamePage). Calquee sur la fenetre vanilla
// Pages/NameRespawnPointPage.ui (nom d'un point de reapparition).
$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 500);

    #Title {
      $C.@Title {
        @Text = "Cercle d'Ancrage";
      }
    }

    #Content {
      Padding: (Vertical: 28, Horizontal: 45);

      Label #AncreInfo {
        Style: (FontSize: 14, TextColor: #a9b8c8, Wrap: true);
      }

      Label {
        Anchor: (Top: 14);
        Text: "Nom de l'ancre";
        Style: (RenderBold: true, RenderUppercase: true, TextColor: #94a7bb);
      }

      Label #AncreError {
        Style: (RenderBold: true, TextColor: #bb3333, Wrap: true);
        Visible: false;
      }

      $C.@TextField #AncreName {
        Anchor: (Top: 10, Height: 44);
        PlaceholderText: "2 à 24 caractères";
      }

      Group {
        LayoutMode: Center;
        Anchor: (Top: 8);

        $C.@TextButton #AncreOk {
          @Anchor = (Right: 4);
          Text: "Valider";
          FlexWeight: 1;
        }

        $C.@SecondaryTextButton #AncreCancel {
          @Anchor = (Left: 4);
          Text: "Annuler";
          FlexWeight: 1;
        }
      }
    }
  }
}

$C.@BackButton {}
