                Group #FamChoice8 { Anchor: (Height: 90); Background: #162030(0.6); LayoutMode: Left; Padding: (Horizontal: 14, Vertical: 8); Visible: false; Group { LayoutMode: Top; FlexWeight: 1; Label #FamCName8 { Text: ""; Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 18); } Label #FamCRarity8 { Text: ""; Style: (FontSize: 10, TextColor: #c98ce0, RenderUppercase: true, RenderBold: true); Anchor: (Height: 14); } Label #FamCMotto8 { Text: ""; Style: (FontSize: 10, TextColor: #aabbcc); Anchor: (Height: 14); } Label #FamCPassive8 { Text: ""; Style: (FontSize: 10, TextColor: #5fc77e, RenderBold: true); Anchor: (Height: 14); } Label #FamCHistory8 { Text: ""; Visible: false; Style: (FontSize: 9, TextColor: #7d8fa3, Wrap: true); Anchor: (Height: 24); } } Group { LayoutMode: Top; Anchor: (Width: 110); Padding: (Vertical: 4); Label #FamCPriceLabel8 { Text: ""; Visible: false; Style: (FontSize: 11, TextColor: #FFD700, HorizontalAlignment: Center, RenderBold: true); Anchor: (Height: 16); } Group { Anchor: (Height: 4); } TextButton #FamBtn8 { Text: "CHOISIR"; Anchor: (Height: 30); Style: (Default: (LabelStyle: (FontSize: 12, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #162030(0.8); } Group { FlexWeight: 1; } } }
            }

            // === STATE: HAS FAMILY (main panel) ===
            Group #FamilleHasFamily {
                LayoutMode: Top; Visible: false;

                // 1. HEADER
                Label #FamName { Text: ""; Style: (FontSize: 20, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: Center, LetterSpacing: 1); Anchor: (Height: 28); }
                Group { Anchor: (Height: 4); }
                Label #FamMotto { Text: ""; Style: (FontSize: 12, TextColor: #7d8fa3, HorizontalAlignment: Center); Anchor: (Height: 18); }
                Label #FamManageHint { Text: "Membres, invitations, tresorerie et ordres se gerent aupres de l'intendant de votre territoire."; Visible: false; Style: (FontSize: 11, TextColor: #c9a24a, HorizontalAlignment: Center, Wrap: true); Anchor: (Top: 4); }
                Group { Anchor: (Height: 10); }

                // CATEGORIES DE L'INTENDANT (2026-11-10) : visibles seulement dans la fenetre de l'intendant
                Group #FamCatBar { LayoutMode: Left; Anchor: (Height: 30); Visible: false;
                    TextButton #FamCatListes { Text: "LISTES"; FlexWeight: 1; Anchor: (Height: 30); Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #c9a24a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, LetterSpacing: 1)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, LetterSpacing: 1))); Background: #141d2b(0.9); }
                    Group { Anchor: (Width: 4); }
                    TextButton #FamCatOrdres { Text: "ORDRES"; FlexWeight: 1; Anchor: (Height: 30); Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #c9a24a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, LetterSpacing: 1)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, LetterSpacing: 1))); Background: #141d2b(0.9); }
                    Group { Anchor: (Width: 4); }
                    TextButton #FamCatGestion { Text: "GESTIONS"; FlexWeight: 1; Anchor: (Height: 30); Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #c9a24a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, LetterSpacing: 1)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, LetterSpacing: 1))); Background: #141d2b(0.9); }
                    Group { Anchor: (Width: 4); }
                    TextButton #FamCatAchats { Text: "ACHATS"; FlexWeight: 1; Anchor: (Height: 30); Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #c9a24a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, LetterSpacing: 1)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, LetterSpacing: 1))); Background: #141d2b(0.9); }
                }
                Group #FamCatLine { Anchor: (Height: 2); Background: #c9a24a(0.5); Visible: false; }
                Group { Anchor: (Height: 8); }
                Group #FamSecCards { LayoutMode: Top;
                    // 2. THREE INFO CARDS
                    Group { LayoutMode: Left; Anchor: (Height: 44);
                        // Rarity (violet border)
                        Group { FlexWeight: 1; Background: #162030; LayoutMode: Left;
                            Group { Anchor: (Width: 3, Height: 44); Background: #c98ce0; }
                            Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 10, Vertical: 4);
                                Label { Text: "RARETE"; Style: (FontSize: 9, TextColor: #7d8fa3, RenderBold: true, RenderUppercase: true); Anchor: (Height: 14); }
                                Label #FamRarity { Text: ""; Style: (FontSize: 13, TextColor: #c98ce0, RenderBold: true); Anchor: (Height: 18); }
                            }
                        }
                        Group { Anchor: (Width: 4); }
                        // Rank (blue border)
                        Group { FlexWeight: 1; Background: #162030; LayoutMode: Left;
                            Group { Anchor: (Width: 3, Height: 44); Background: #5b9bd5; }
                            Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 10, Vertical: 4);
                                Label { Text: "RANG MINIMUM"; Style: (FontSize: 9, TextColor: #7d8fa3, RenderBold: true, RenderUppercase: true); Anchor: (Height: 14); }
                                Label #FamRank { Text: ""; Style: (FontSize: 13, TextColor: #5b9bd5); Anchor: (Height: 18); }
                            }
                        }
                        Group { Anchor: (Width: 4); }
                        // Role (gold border)
                        Group { FlexWeight: 1; Background: #162030; LayoutMode: Left;
                            Group { Anchor: (Width: 3, Height: 44); Background: #FFD700; }
                            Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 10, Vertical: 4);
                                Label { Text: "VOTRE ROLE"; Style: (FontSize: 9, TextColor: #7d8fa3, RenderBold: true, RenderUppercase: true); Anchor: (Height: 14); }
                                Label #FamStatus { Text: ""; Style: (FontSize: 13, TextColor: #FFD700, RenderBold: true); Anchor: (Height: 18); }
                            }
                        }
                    }
                    Group { Anchor: (Height: 8); }

                }
                Group #FamSecTreasury { LayoutMode: Top;
                    // 3. TREASURY + CONTRIBUTION (green border)
                    Group { LayoutMode: Left; Anchor: (Height: 44);
                        Group { FlexWeight: 1; Background: #162030; LayoutMode: Left;
                            Group { Anchor: (Width: 3, Height: 44); Background: #5fc77e; }
                            Group { LayoutMode: Left; FlexWeight: 1; Padding: (Horizontal: 10, Vertical: 6);
                                Label { Text: "TRESORERIE"; Style: (FontSize: 10, TextColor: #7d8fa3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 100); }
                                Label #FamTreasury { Text: "0 Or"; Style: (FontSize: 16, TextColor: #FFD700, VerticalAlignment: Center, RenderBold: true); FlexWeight: 1; }
                                TextButton #FamBtnDeposit { Text: "+1000"; Anchor: (Width: 65, Height: 26); Style: (Default: (LabelStyle: (FontSize: 10, TextColor: #5fc77e, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #1a3a1a(0.8); }
                                Group { Anchor: (Width: 4); }
                                TextButton #FamBtnWithdraw { Text: "-1000"; Anchor: (Width: 65, Height: 26); Visible: false; Style: (Default: (LabelStyle: (FontSize: 10, TextColor: #c44545, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #2a1a1a(0.8); }
                            }
