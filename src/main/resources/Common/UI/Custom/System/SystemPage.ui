                            }
                        }
                        Group { Anchor: (Width: 4); }
                        Group { FlexWeight: 1; Background: #162030; LayoutMode: Left;
                            Group { Anchor: (Width: 3); Background: #5fc77e; }
                            Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 10, Vertical: 4);
                                Group { LayoutMode: Left; Anchor: (Height: 16);
                                    Label { Text: "Effectifs"; Style: (FontSize: 10, TextColor: #7d8fa3, RenderBold: true, RenderUppercase: true); FlexWeight: 1; }
                                    Label #GuildeUpgLevel2 { Text: "0/5"; Style: (FontSize: 10, TextColor: #5a6a7d, RenderBold: true); }
                                }
                                Label #GuildeUpgEffect2 { Text: ""; Style: (FontSize: 13, TextColor: #5fc77e, RenderBold: true); Anchor: (Height: 18); }
                            }
                        }
                    }
                }
                Group { Anchor: (Height: 10); }

                // 4c. CONTRATS DE GUILDE DE LA SEMAINE (tableau de guilde)
                Group { Background: #11192680; Padding: (Horizontal: 12, Vertical: 8); LayoutMode: Top;
                    Group { LayoutMode: Left; Anchor: (Height: 16);
                        Label { Text: "CONTRATS DE LA SEMAINE"; Style: (FontSize: 11, TextColor: #7d8fa3, RenderBold: true, RenderUppercase: true, LetterSpacing: 1); FlexWeight: 1; }
