                            Label { Text: "MOB KILLS"; Style: (FontSize: 10, TextColor: #7d8fa3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 80); }
                            Label #GuildeStatMobs { Text: "0"; Style: (FontSize: 14, TextColor: #5fc77e, VerticalAlignment: Center, RenderBold: true); }
                        }
                        Group { FlexWeight: 1; LayoutMode: Left; Padding: (Horizontal: 8);
                            Label { Text: "PVP KILLS"; Style: (FontSize: 10, TextColor: #7d8fa3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 80); }
