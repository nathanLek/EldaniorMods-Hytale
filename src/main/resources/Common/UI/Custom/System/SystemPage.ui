$C = "../Common.ui";

$C.@PageOverlay {}

// Cadre des fenetres : celui du jeu (@DecoratedContainer) avec bordure doree, ou rouge pour un criminel (PK) :
// couches #Frame*/#Frame*Red basculees par SystemScreen.frame (textures : scripts/system/gen_cadre_or.py).
@GoldContainer = Group {
  Group #FrameTitle {
    Anchor: (Height: 38, Top: 0);
    Background: (TexturePath: "GoldHeader.png", HorizontalBorder: 50, VerticalBorder: 0);
  }
  Group #FrameBody {
    Anchor: (Top: 38);
    Background: (TexturePath: "GoldPatch.png", Border: 23);
  }
  Group #FrameTitleRed {
    Anchor: (Height: 38, Top: 0);
    Background: (TexturePath: "RedHeader.png", HorizontalBorder: 50, VerticalBorder: 0);
    Visible: false;
  }
  Group #FrameBodyRed {
    Anchor: (Top: 38);
    Background: (TexturePath: "RedPatch.png", Border: 23);
    Visible: false;
  }
  Group #FrameDecoTop {
    Anchor: (Width: 236, Height: 11, Top: -12);
    Background: "GoldDecorationTop.png";
  }
  Group #FrameDecoTopRed {
    Anchor: (Width: 236, Height: 11, Top: -12);
    Background: "RedDecorationTop.png";
    Visible: false;
  }

  Group #Title {
    Anchor: (Height: 38, Top: 0);
    Padding: (Top: 7);
  }

  Group #Content {
    LayoutMode: Top;
    Anchor: (Top: 38);
    Padding: (Full: 17);
  }

  Group #FrameDecoBottom {
    Anchor: (Width: 236, Height: 11, Bottom: -6);
    Background: "GoldDecorationBottom.png";
  }
  Group #FrameDecoBottomRed {
    Anchor: (Width: 236, Height: 11, Bottom: -6);
    Background: "RedDecorationBottom.png";
    Visible: false;
  }
};

// Menu systeme (refonte du 2026-11-12, style de l'inventaire) : profil a gauche (apercu du personnage, XP, mana,
// caracteristiques avec boutons + quand il reste des points), colonne de categories, contenu de l'onglet a droite.
// Images du panneau personnage copiees du client (Data/Game/Interface/InGame/Pages/Inventory) ; panneaux des onglets inchanges.
Group {
  LayoutMode: Center;

  Group #MainPanel {
    Anchor: (Height: 800);
    LayoutMode: Left;

    // ===== PROFIL : personnage, progression, caracteristiques (panneau personnage de l'inventaire) =====
    @GoldContainer #Sidebar {
      Anchor: (Width: 440, Height: 800);

      #Title {
        Label #SidebarPlayerName {
          Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
          Padding: (Horizontal: 19);
        }
      }

      #Content {
        LayoutMode: Top;

        Group {
          Anchor: (Height: 252);
          LayoutMode: Left;

          // a gauche : rang d'aventurier, noblesse, Eglise (ou criminel)
          Group {
            Anchor: (Width: 104);
            LayoutMode: Top;

              Group {
                Anchor: (Height: 80);
                LayoutMode: Top;
                Group {
                  Anchor: (Height: 46);
                  LayoutMode: Center;
                  Group {
                    Anchor: (Width: 46, Height: 46);
                    Background: "CharacterPanelButton.png";
                    LayoutMode: CenterMiddle;
                    Label #ProfilAdvRank {
                      Style: (FontSize: 24, TextColor: #e8b34f, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                    }
                  }
                }
                Label {
                  Anchor: (Top: 3, Height: 12);
                  Text: "Rang";
                  Style: (FontSize: 9, TextColor: #878e9c, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
                }
              }

            Group { Anchor: (Height: 4); }

              Group {
                Anchor: (Height: 80);
                LayoutMode: Top;
                Group {
                  Anchor: (Height: 46);
                  LayoutMode: Center;
                  Group {
                    Anchor: (Width: 46, Height: 46);
                    Background: "CharacterPanelButton.png";
                    LayoutMode: CenterMiddle;
                    ItemIcon #IdIconNoble {
                      Anchor: (Width: 32, Height: 32);
                    }
                  }
                }
                Label {
                  Anchor: (Top: 3, Height: 12);
                  Text: "Noblesse";
                  Style: (FontSize: 9, TextColor: #878e9c, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
                }
                Label #IdNoble {
                  Anchor: (Height: 18);
                  Style: (FontSize: 12, TextColor: #d1dae6, RenderBold: true, HorizontalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9);
                }
              }

            Group { Anchor: (Height: 4); }

              Group {
                Anchor: (Height: 80);
                LayoutMode: Top;
                Group {
                  Anchor: (Height: 46);
                  LayoutMode: Center;
                  Group {
                    Anchor: (Width: 46, Height: 46);
                    Background: "CharacterPanelButton.png";
                    LayoutMode: CenterMiddle;
                    ItemIcon #IdIconChurch {
                      Anchor: (Width: 32, Height: 32);
                    }
                  }
                }
                Label {
                  Anchor: (Top: 3, Height: 12);
                  Text: "Église";
                  Style: (FontSize: 9, TextColor: #878e9c, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
                }
                Label #IdChurch {
                  Anchor: (Height: 18);
                  Style: (FontSize: 12, TextColor: #d1dae6, RenderBold: true, HorizontalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9);
                }
              }

          }

          // au centre : la classe (entre le rang et le niveau, au-dessus de la tete), puis le personnage
          Group {
            FlexWeight: 1;
            Background: "CharacterBackground.png";
            LayoutMode: Top;

            Label #IdClass {
              Anchor: (Top: 8, Height: 30, Horizontal: 4);
              Style: (FontSize: 15, TextColor: #e8b34f, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10);
            }

            Group #ProfilPreviewBox {
              FlexWeight: 1;
              TooltipText: "";
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;

              CharacterPreviewComponent #ProfilPreview {
                Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
              }
            }
          }

          // a droite : niveau (progression dessous), famille et guilde (seulement si on en a)
          Group {
            Anchor: (Width: 104);
            LayoutMode: Top;

              Group {
                Anchor: (Height: 80);
                LayoutMode: Top;
                Group {
                  Anchor: (Height: 46);
                  LayoutMode: Center;
                  Group {
                    Anchor: (Width: 46, Height: 46);
                    Background: "CharacterPanelButton.png";
                    LayoutMode: CenterMiddle;
                    Label #IdLevel {
                      Style: (FontSize: 17, TextColor: #e8b34f, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                    }
                  }
                }
                Label {
                  Anchor: (Top: 3, Height: 12);
                  Text: "Niveau";
                  Style: (FontSize: 9, TextColor: #878e9c, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
                }
              }

            Group { Anchor: (Height: 4); }

              // Famille et Guilde cote a cote (2026-11-16 : la 3e rangee est celle de la poche, a la hauteur de l'Eglise)
              Group {
                Anchor: (Height: 80);
                LayoutMode: Center;
                Group #IdRowFamily {
                  Anchor: (Width: 52, Height: 80);
                  LayoutMode: Top;
                  Group {
                    Anchor: (Height: 46);
                    LayoutMode: Center;
                    Group {
                      Anchor: (Width: 46, Height: 46);
                      Background: "CharacterPanelButton.png";
                      LayoutMode: CenterMiddle;
                      ItemIcon #IdIconFamily {
                        Anchor: (Width: 32, Height: 32);
                      }
                    }
                  }
                  Label {
                    Anchor: (Top: 3, Height: 12);
                    Text: "Famille";
                    Style: (FontSize: 9, TextColor: #878e9c, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
                  }
                  Label #IdFamily {
                    Anchor: (Height: 18);
                    Style: (FontSize: 12, TextColor: #d1dae6, RenderBold: true, HorizontalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9);
                  }
                }
                Group #IdRowGuild {
                  Anchor: (Width: 52, Height: 80);
                  LayoutMode: Top;
                  Group {
                    Anchor: (Height: 46);
                    LayoutMode: Center;
                    Group {
                      Anchor: (Width: 46, Height: 46);
                      Background: "CharacterPanelButton.png";
                      LayoutMode: CenterMiddle;
                      ItemIcon #IdIconGuild {
                        Anchor: (Width: 32, Height: 32);
                      }
                    }
                  }
                  Label {
                    Anchor: (Top: 3, Height: 12);
                    Text: "Guilde";
                    Style: (FontSize: 9, TextColor: #878e9c, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
                  }
                  Label #IdGuild {
                    Anchor: (Height: 18);
                    Style: (FontSize: 12, TextColor: #d1dae6, RenderBold: true, HorizontalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9);
                  }
                }
              }

            Group { Anchor: (Height: 4); }

              // Poche dimensionnelle (2026-11-16) : colonne du Niveau, a la hauteur de l'Eglise ; clic = panneau #TabPoche
              Group #PocheBox {
                Anchor: (Height: 80);
                LayoutMode: Top;
                Group {
                  Anchor: (Height: 46);
                  LayoutMode: CenterMiddle;
                  Button #PocheSlot {
                    Anchor: (Width: 52, Height: 52);
                    TooltipText: "Poche dimensionnelle : 4 rangées qui ne se perdent jamais";
                    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                    Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);

                    Group {
                      LayoutMode: CenterMiddle;
                      ItemIcon #PocheSlotIcon {
                        Anchor: (Width: 42, Height: 42);
                        Visible: false;
                      }
                    }
                  }
                }
                Label {
                  Anchor: (Top: 3, Height: 12);
                  Text: "Poche";
                  Style: (FontSize: 9, TextColor: #878e9c, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
                }
                Label {
                  Anchor: (Height: 18);
                  Text: "Dimensionnelle";
                  Style: (FontSize: 12, TextColor: #d1dae6, RenderBold: true, HorizontalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9);
                }
              }

          }
        }

        // XP
        Group {
          Anchor: (Top: 8, Height: 16);
          LayoutMode: Left;
          Label {
            Text: "Expérience";
            Style: (FontSize: 11, TextColor: #c99436, RenderBold: true, RenderUppercase: true);
            FlexWeight: 1;
          }
          Label #ProfilXPLabel {
            Style: (FontSize: 11, TextColor: #b4c8c9, RenderBold: true, HorizontalAlignment: End);
            Anchor: (Width: 220);
          }
        }
        Group {
          Anchor: (Top: 2, Height: 12);
          Background: "../Status/XPBackground.png";
          ProgressBar #ProfilXPBar {
            BarTexturePath: "../Status/XPFill.png";
            Value: 0.0;
          }
        }

        // Statistiques reelles (comme le panneau de l'inventaire)
        Group {
          Anchor: (Top: 10, Height: 146);
          LayoutMode: Top;

          Group {
            Anchor: (Top: 6, Height: 18);
            LayoutMode: Left;
            Group { Anchor: (Width: 6, Height: 6, Top: 6); Background: #c99436; }
            Label {
              Anchor: (Left: 6);
              Text: "Statistiques";
              Style: (TextColor: #e8b34f, FontSize: 13, RenderBold: true, RenderUppercase: true);
              FlexWeight: 1;
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 48);

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 5);
              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Points de vie actuels / maximum";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconVitalite.png"; }
              }
              Group {
                Anchor: (Left: 10);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Vie";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #RealHealth {
                  Style: (TextColor: #b4c8c9, FontSize: 14, RenderBold: true);
                }
              }
            }

            Group { Anchor: (Width: 10); }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 5);
              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Endurance actuelle / maximum";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconEndurance.png"; }
              }
              Group {
                Anchor: (Left: 10);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Endurance";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #RealStamina {
                  Style: (TextColor: #b4c8c9, FontSize: 14, RenderBold: true);
                }
              }
            }

          }

          Group { Anchor: (Height: 2); Background: #c99436(0.18); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 48);

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 5);
              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Mana actuel / maximum";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconIntelligence.png"; }
              }
              Group {
                Anchor: (Left: 10);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Mana";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #RealMana {
                  Style: (TextColor: #b4c8c9, FontSize: 14, RenderBold: true);
                }
              }
            }

            Group { Anchor: (Width: 10); }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 5);
              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Points retirés à chaque coup reçu (Endurance)";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconDefense.png"; }
              }
              Group {
                Anchor: (Left: 10);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Défense";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #RealDefense {
                  Style: (TextColor: #b4c8c9, FontSize: 14, RenderBold: true);
                }
              }
            }

          }

          Label #RealDerived {
            Anchor: (Top: 2, Height: 16);
            Style: (TextColor: #878e9c, FontSize: 11, RenderBold: true, HorizontalAlignment: Center);
          }
        }

        // Caracteristiques
        Group {
          Anchor: (Top: 10, Height: 244);
          LayoutMode: Top;


          Group {
            Anchor: (Top: 6, Height: 18);
            LayoutMode: Left;
            Group { Anchor: (Width: 6, Height: 6, Top: 6); Background: #c99436; }
            Label {
              Anchor: (Left: 6);
              Text: "Caractéristiques";
              Style: (TextColor: #e8b34f, FontSize: 13, RenderBold: true, RenderUppercase: true);
              FlexWeight: 1;
            }
            Label #ProfilPoints {
              Style: (TextColor: #f0c868, FontSize: 12, RenderBold: true, HorizontalAlignment: End);
              Anchor: (Width: 180);
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 50);

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 6);

              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Force : Dégâts au corps à corps";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconForce.png"; }
              }

              Group {
                Anchor: (Left: 8);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Force";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #ProfilStr {
                  Style: (TextColor: #b4c8c9, FontSize: 14, RenderBold: true);
                }
              }

              Group {
                Anchor: (Width: 62);
                LayoutMode: Middle;
                Group {
                  Anchor: (Height: 26);
                  LayoutMode: Left;
                  TextButton #BtnStr1 {
                    Text: "+";
                    Anchor: (Width: 28, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                  Group { Anchor: (Width: 4); }
                  TextButton #BtnStr5 {
                    Text: "+5";
                    Anchor: (Width: 30, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                }
              }
            }

            Group { Anchor: (Width: 10); }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 6);

              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Vitalité : Points de vie";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconVitalite.png"; }
              }

              Group {
                Anchor: (Left: 8);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Vitalité";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #ProfilVit {
                  Style: (TextColor: #b4c8c9, FontSize: 14, RenderBold: true);
                }
              }

              Group {
                Anchor: (Width: 62);
                LayoutMode: Middle;
                Group {
                  Anchor: (Height: 26);
                  LayoutMode: Left;
                  TextButton #BtnVit1 {
                    Text: "+";
                    Anchor: (Width: 28, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                  Group { Anchor: (Width: 4); }
                  TextButton #BtnVit5 {
                    Text: "+5";
                    Anchor: (Width: 30, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                }
              }
            }

          }

          Group { Anchor: (Height: 2); Background: #c99436(0.18); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 50);

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 6);

              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Intelligence : Mana et puissance des sorts";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconIntelligence.png"; }
              }

              Group {
                Anchor: (Left: 8);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Intelligence";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #ProfilInt {
                  Style: (TextColor: #b4c8c9, FontSize: 14, RenderBold: true);
                }
              }

              Group {
                Anchor: (Width: 62);
                LayoutMode: Middle;
                Group {
                  Anchor: (Height: 26);
                  LayoutMode: Left;
                  TextButton #BtnInt1 {
                    Text: "+";
                    Anchor: (Width: 28, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                  Group { Anchor: (Width: 4); }
                  TextButton #BtnInt5 {
                    Text: "+5";
                    Anchor: (Width: 30, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                }
              }
            }

            Group { Anchor: (Width: 10); }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 6);

              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Endurance : Endurance et défense";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconEndurance.png"; }
              }

              Group {
                Anchor: (Left: 8);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Endurance";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #ProfilEnd {
                  Style: (TextColor: #b4c8c9, FontSize: 14, RenderBold: true);
                }
              }

              Group {
                Anchor: (Width: 62);
                LayoutMode: Middle;
                Group {
                  Anchor: (Height: 26);
                  LayoutMode: Left;
                  TextButton #BtnEnd1 {
                    Text: "+";
                    Anchor: (Width: 28, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                  Group { Anchor: (Width: 4); }
                  TextButton #BtnEnd5 {
                    Text: "+5";
                    Anchor: (Width: 30, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                }
              }
            }

          }

          Group { Anchor: (Height: 2); Background: #c99436(0.18); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 50);

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 6);

              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Agilité : Vitesse et esquive";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconAgilite.png"; }
              }

              Group {
                Anchor: (Left: 8);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Agilité";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #ProfilAgl {
                  Style: (TextColor: #b4c8c9, FontSize: 14, RenderBold: true);
                }
              }

              Group {
                Anchor: (Width: 62);
                LayoutMode: Middle;
                Group {
                  Anchor: (Height: 26);
                  LayoutMode: Left;
                  TextButton #BtnAgl1 {
                    Text: "+";
                    Anchor: (Width: 28, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                  Group { Anchor: (Width: 4); }
                  TextButton #BtnAgl5 {
                    Text: "+5";
                    Anchor: (Width: 30, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                }
              }
            }

            Group { Anchor: (Width: 10); }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 6);

              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Chance : Coups critiques et butin";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconChance.png"; }
              }

              Group {
                Anchor: (Left: 8);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Chance";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #ProfilLck {
                  Style: (TextColor: #b4c8c9, FontSize: 14, RenderBold: true);
                }
              }

              Group {
                Anchor: (Width: 62);
                LayoutMode: Middle;
                Group {
                  Anchor: (Height: 26);
                  LayoutMode: Left;
                  TextButton #BtnLck1 {
                    Text: "+";
                    Anchor: (Width: 28, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                  Group { Anchor: (Width: 4); }
                  TextButton #BtnLck5 {
                    Text: "+5";
                    Anchor: (Width: 30, Height: 26);
                    Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                    Background: #2a3a52(0.9);
                  }
                }
              }
            }

          }

          Group { Anchor: (Height: 2); Background: #c99436(0.18); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 50);

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 6);

              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Foi : lien avec l'Église, monte avec le rang religieux";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconFoi.png"; }
              }

              Group {
                Anchor: (Left: 8);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Foi";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #ProfilFaith {
                  Style: (TextColor: #f0d58c, FontSize: 14, RenderBold: true);
                }
              }
            }

            Group { Anchor: (Width: 10); }

            Group {
              FlexWeight: 1;
              LayoutMode: Left;
              Padding: (Vertical: 6);

              Group {
                Anchor: (Width: 35, Height: 35);
                Background: "CharacterPanelStatIconBackground.png";
                TooltipText: "Dignité : prestige de la noblesse, monte avec le rang noble";
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Group { Background: "StatIconDignite.png"; }
              }

              Group {
                Anchor: (Left: 8);
                FlexWeight: 1;
                LayoutMode: Middle;
                Label {
                  Text: "Dignité";
                  Style: (TextColor: #878e9c, FontSize: 11);
                }
                Label #ProfilDignity {
                  Style: (TextColor: #f0d58c, FontSize: 14, RenderBold: true);
                }
              }
            }

          }
        }

        Group { FlexWeight: 1; }

        Group {
          Anchor: (Height: 20);
          LayoutMode: Left;
          Label #SidebarMoney {
            Style: (FontSize: 13, TextColor: #D4AF37, RenderBold: true);
            FlexWeight: 1;
          }
          Label #SidebarLevel {
            Style: (FontSize: 13, TextColor: #aabbcc, RenderBold: true, HorizontalAlignment: End);
            Anchor: (Width: 160);
          }
        }
      }
    }

    Group { Anchor: (Width: 10); }

    // ===== CATEGORIES : un bouton par onglet (comme les boutons de droite du panneau personnage) =====
    Group #CategoryBar {
      Anchor: (Width: 70, Height: 800);
      LayoutMode: Top;
      Padding: (Top: 46);

      Button #TabBtnCompetences {
        Anchor: (Width: 70, Height: 70, Top: 4);
        TooltipText: "Compétences";
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);

        Group #TabOnCompetences {
          Background: "CharacterPanelButtonActive.png";
          Visible: true;
        }

        Group {
          LayoutMode: CenterMiddle;
          ItemIcon #TabIconCompetences {
            Anchor: (Width: 46, Height: 46);
          }
        }
      }

      Button #TabBtnQuetes {
        Anchor: (Width: 70, Height: 70, Top: 4);
        TooltipText: "Quêtes";
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);

        Group #TabOnQuetes {
          Background: "CharacterPanelButtonActive.png";
          Visible: false;
        }

        Group {
          LayoutMode: CenterMiddle;
          ItemIcon #TabIconQuetes {
            Anchor: (Width: 46, Height: 46);
          }
        }
      }

      Button #TabBtnGuilde {
        Anchor: (Width: 70, Height: 70, Top: 4);
        TooltipText: "Guilde";
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);

        Group #TabOnGuilde {
          Background: "CharacterPanelButtonActive.png";
          Visible: false;
        }

        Group {
          LayoutMode: CenterMiddle;
          ItemIcon #TabIconGuilde {
            Anchor: (Width: 46, Height: 46);
          }
        }
      }

      Button #TabBtnGroupe {
        Anchor: (Width: 70, Height: 70, Top: 4);
        TooltipText: "Groupe";
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);

        Group #TabOnGroupe {
          Background: "CharacterPanelButtonActive.png";
          Visible: false;
        }

        Group {
          LayoutMode: CenterMiddle;
          // aucun objet du jeu n'evoque un groupe : image dessinee (scripts/system/gen_icone_groupe.py)
          Group #TabIconGroupe {
            Anchor: (Width: 38, Height: 38);
            Background: "TabIconGroupe.png";
          }
        }
      }

      Button #TabBtnFamille {
        Anchor: (Width: 70, Height: 70, Top: 4);
        TooltipText: "Famille";
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);
        Visible: false;

        Group #TabOnFamille {
          Background: "CharacterPanelButtonActive.png";
          Visible: false;
        }

        Group {
          LayoutMode: CenterMiddle;
          ItemIcon #TabIconFamille {
            Anchor: (Width: 46, Height: 46);
          }
        }
      }

      Button #TabBtnTitres {
        Anchor: (Width: 70, Height: 70, Top: 4);
        TooltipText: "Titres";
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);

        Group #TabOnTitres {
          Background: "CharacterPanelButtonActive.png";
          Visible: false;
        }

        Group {
          LayoutMode: CenterMiddle;
          ItemIcon #TabIconTitres {
            Anchor: (Width: 46, Height: 46);
          }
        }
      }

      Button #TabBtnShop {
        Anchor: (Width: 70, Height: 70, Top: 4);
        TooltipText: "Marché";
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);

        Group #TabOnShop {
          Background: "CharacterPanelButtonActive.png";
          Visible: false;
        }

        Group {
          LayoutMode: CenterMiddle;
          ItemIcon #TabIconShop {
            Anchor: (Width: 46, Height: 46);
          }
        }
      }

      Button #TabBtnBlackMarket {
        Anchor: (Width: 70, Height: 70, Top: 4);
        TooltipText: "Marché noir";
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);
        Visible: false;

        Group #TabOnBlackMarket {
          Background: "CharacterPanelButtonActive.png";
          Visible: false;
        }

        Group {
          LayoutMode: CenterMiddle;
          ItemIcon #TabIconBlackMarket {
            Anchor: (Width: 46, Height: 46);
          }
        }
      }

      // Cour de l'Observateur (2026-11-17) : Roi, Empereur Luo, admins ; panneau #TabObservateur a droite (2026-11-19)
      Button #TabBtnObservateur {
        Anchor: (Width: 70, Height: 70, Top: 4);
        TooltipText: "Observateur";
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);
        Visible: false;

        Group #TabOnObservateur {
          Background: "CharacterPanelButtonActive.png";
          Visible: false;
        }

        Group {
          LayoutMode: CenterMiddle;
          ItemIcon #TabIconObservateur {
            Anchor: (Width: 46, Height: 46);
          }
        }
      }

      Button #TabBtnEchanges {
        Anchor: (Width: 70, Height: 70, Top: 4);
        TooltipText: "Échanges";
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);
        Visible: false;

        Group #TabOnEchanges {
          Background: "CharacterPanelButtonActive.png";
          Visible: false;
        }

        Group {
          LayoutMode: CenterMiddle;
          ItemIcon #TabIconEchanges {
            Anchor: (Width: 46, Height: 46);
          }
        }
      }

      Button #TabBtnWiki {
        Anchor: (Width: 70, Height: 70, Top: 4);
        TooltipText: "Wiki";
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Style: (Default: (Background: "CharacterPanelButton.png"), Hovered: (Background: "CharacterPanelButtonActive.png"), Sounds: $C.@ButtonSounds);

        Group #TabOnWiki {
          Background: "CharacterPanelButtonActive.png";
          Visible: false;
        }

        Group {
          LayoutMode: CenterMiddle;
          ItemIcon #TabIconWiki {
            Anchor: (Width: 46, Height: 46);
          }
        }
      }

    }

    Group { Anchor: (Width: 10); }

    // ===== CONTENU DE L'ONGLET =====
    @GoldContainer #ContentPanel {
      Anchor: (Width: 860, Height: 800);

      #Title {
        Label #ContentTitle {
          Text: "Compétences";
          Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
          Padding: (Horizontal: 19);
        }
      }

      #Content {
        LayoutMode: Top;

        Group #ContentArea {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Horizontal: 6, Top: 4);

                    Group #TabCompetences {
            LayoutMode: Top;
            Visible: true;

            Label #SkillCount {
                Text: "COMPETENCES";
                Style: (FontSize: 16, TextColor: #FFD700, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, HorizontalAlignment: Center);
                Anchor: (Height: 24);
            }

            Group { Anchor: (Height: 6); }

            // Onglets Passives / Runes actives : fond et soulignement dore de l'onglet choisi (CompetencesTab)
            Group {
                LayoutMode: Left;
                Anchor: (Height: 34);

                Group { FlexWeight: 1; }
                Group {
                    Anchor: (Width: 210);
                    LayoutMode: Top;
                    TextButton #SkillTabPassive {
                        Text: "Passives";
                        Anchor: (Height: 31);
                        Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #c9d1dc, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true, LetterSpacing: 1)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true, LetterSpacing: 1)));
                        Background: #141a24(0.85);
                    }
                    Group #SkillTabPassiveOn { Anchor: (Height: 3); Background: #e8b34f; Visible: false; }
                }
                Group { Anchor: (Width: 8); }
                Group {
                    Anchor: (Width: 210);
                    LayoutMode: Top;
                    TextButton #SkillTabActive {
                        Text: "Runes actives";
                        Anchor: (Height: 31);
                        Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #c9d1dc, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true, LetterSpacing: 1)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true, LetterSpacing: 1)));
                        Background: #141a24(0.85);
                    }
                    Group #SkillTabActiveOn { Anchor: (Height: 3); Background: #e8b34f; Visible: false; }
                }
                Group { FlexWeight: 1; }
            }

            Group { Anchor: (Height: 6); }

            // Pagination
            Group #SkillPager {
                LayoutMode: Left;
                Anchor: (Height: 30);

                TextButton #SkillBtnPrev {
                    Text: "< PRECEDENT";
                    Anchor: (Width: 140, Height: 28);
                    Style: (Default: (LabelStyle: (FontSize: 12, TextColor: #aabbcc, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                }

                Group { FlexWeight: 1; }

                Label #SkillPage {
                    Text: "Page 1 / 1";
                    Style: (FontSize: 13, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
                }

                Group { FlexWeight: 1; }

                TextButton #SkillBtnNext {
                    Text: "SUIVANT >";
                    Anchor: (Width: 140, Height: 28);
                    Style: (Default: (LabelStyle: (FontSize: 12, TextColor: #aabbcc, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                }
            }

            Group { Anchor: (Height: 6); }


            // Runes actives (2026-11-12, remplace /es runes) : les memes grilles que la fenetre des runes du jeu
            // (Pages/Abilities/AbilityBenchPanel.ui, RuneBagPanel.ui), remplies par RunesTab (#Grille.Slots = ItemGridSlot[]) :
            // 2 lignes de competence de 3 cases, sac de 50 places. Gestes traites par RunesTab (clic = envoi rapide,
            // glisser-deposer = case precise). Hauteur totale < zone de contenu : seul le sac defile.
            Group #RuneManager {
              LayoutMode: Top;
              Visible: false;

              // ---- Runes equipees : sans cadre ni fond, fondu dans la page (demande du 2026-11-12) ----
              Group {
                Anchor: (Top: 6, Height: 214);
                LayoutMode: Top;
                Padding: (Horizontal: 14, Vertical: 4);

                Group {
                  Anchor: (Height: 22);
                  LayoutMode: Left;
                  Group { Anchor: (Width: 6, Height: 6, Top: 8); Background: #c99436; }
                  Label {
                    Anchor: (Left: 8);
                    Text: "Runes équipées";
                    Style: (TextColor: #e8b34f, FontSize: 14, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, VerticalAlignment: Center);
                    FlexWeight: 1;
                  }
                  Label #RuneEquippedCount {
                    Anchor: (Width: 260);
                    Text: "";
                    Style: (FontSize: 12, TextColor: #f0c868, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
                  }
                }
                Group { Anchor: (Top: 4, Height: 1); Background: #c99436(0.35); }

                Group {
                  Anchor: (Top: 6, Height: 172);
                  LayoutMode: Left;

                  Group {
                    Anchor: (Width: 170);
                    LayoutMode: Top;
                    Padding: (Top: 14);
                    Group {
                      Anchor: (Top: 0, Height: 72);
                      LayoutMode: Middle;
                      Label { Text: "Compétence 1"; Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, RenderUppercase: true); }
                      Label { Text: "1 principale · 2 soutiens"; Style: (FontSize: 11, TextColor: #878e9c); }
                    }
                    Group {
                      Anchor: (Top: 8, Height: 72);
                      LayoutMode: Middle;
                      Label { Text: "Compétence 2"; Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, RenderUppercase: true); }
                      Label { Text: "1 principale · 2 soutiens"; Style: (FontSize: 11, TextColor: #878e9c); }
                    }
                  }

                  Group {
                    Anchor: (Width: 240);
                    LayoutMode: Top;
                    Group {
                      Anchor: (Height: 14);
                      LayoutMode: Left;
                      Label { Anchor: (Width: 80); Text: "Principale"; Style: (FontSize: 10, TextColor: #f0c868, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center); }
                      Label { Anchor: (Width: 160); Text: "Soutiens"; Style: (FontSize: 10, TextColor: #878e9c, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center); }
                    }
                    ItemGrid #RuneAbilityGrid {
                      Anchor: (Width: 236, Height: 156);
                      SlotsPerRow: 3;
                      AreItemsDraggable: true;
                      Style: (SlotSize: 72, SlotIconSize: 62, SlotSpacing: 8, SlotBackground: "AbilitySlot.png");
                      Padding: 2;
                    }
                  }

                  Group { Anchor: (Width: 18); }

                  // legende (la description d'une rune : infobulle du jeu au survol)
                  Group {
                    FlexWeight: 1;
                    LayoutMode: Top;
                    Padding: (Top: 20, Right: 6);
                    Group {
                      Anchor: (Height: 62);
                      LayoutMode: Top;
                      Background: #0d1520(0.55);
                      Padding: (Horizontal: 10, Vertical: 6);
                      Label { Text: "Principale"; Style: (FontSize: 12, TextColor: #f0c868, RenderBold: true, RenderUppercase: true); Anchor: (Height: 16); }
                      Label { Text: "La rune qui donne la compétence (sort lancé)."; Style: (FontSize: 12, TextColor: #aab4c3, Wrap: true); FlexWeight: 1; }
                    }
                    Group { Anchor: (Height: 8); }
                    Group {
                      Anchor: (Height: 62);
                      LayoutMode: Top;
                      Background: #0d1520(0.55);
                      Padding: (Horizontal: 10, Vertical: 6);
                      Label { Text: "Soutiens"; Style: (FontSize: 12, TextColor: #c9d1dc, RenderBold: true, RenderUppercase: true); Anchor: (Height: 16); }
                      Label { Text: "Modifient la principale : il faut d'abord une principale compatible."; Style: (FontSize: 12, TextColor: #aab4c3, Wrap: true); FlexWeight: 1; }
                    }
                  }
                }
              }

              // ---- Sac de runes : 5 rangees visibles (5 x 64 + 4 x 4 + 2 x 2 = 340), defile seul au-dela ----
              // Hauteur de la vue : 72 (en-tete, onglets) + 220 + 390 + 30 = 712 < 724 (zone de contenu) : la page ne defile pas.
              // sans cadre ni fond, comme les runes equipees (demande du 2026-11-12)
              Group {
                Anchor: (Top: 8, Height: 382);
                LayoutMode: Top;
                Padding: (Horizontal: 14, Vertical: 4);

                Group {
                  Anchor: (Height: 22);
                  LayoutMode: Left;
                  Group { Anchor: (Width: 6, Height: 6, Top: 8); Background: #c99436; }
                  Label {
                    Anchor: (Left: 8);
                    Text: "Sac de runes";
                    Style: (TextColor: #e8b34f, FontSize: 14, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, VerticalAlignment: Center);
                    FlexWeight: 1;
                  }
                  Label #RuneBagCount {
                    Anchor: (Width: 420);
                    Text: "";
                    Style: (FontSize: 12, TextColor: #f0c868, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
                  }
                }
                Group { Anchor: (Top: 4, Height: 1); Background: #c99436(0.35); }

                Group {
                  Anchor: (Top: 6, Height: 340);
                  LayoutMode: Center;

                  ItemGrid #RuneBagGrid {
                    Anchor: (Width: 692, Height: 340);
                    SlotsPerRow: 10;
                    AreItemsDraggable: true;
                    ShowScrollbar: true;
                    KeepScrollPosition: true;
                    ScrollbarStyle: $C.@TranslucentScrollbarStyle;
                    Style: (SlotSize: 64, SlotIconSize: 56, SlotSpacing: 4, SlotBackground: "RuneSlot.png");
                    Padding: 2;
                  }
                }
              }

              // ---- aide ----
              Group {
                Anchor: (Top: 6, Height: 24);
                LayoutMode: Center;
                Background: #0d1520(0.6);
                Label {
                  Anchor: (Width: 780);
                  Text: "Clic : envoi rapide entre le sac et les compétences   ·   Glisser-déposer : case précise, ou réordonner le sac   ·   Survol : description";
                  Style: (FontSize: 12, TextColor: #aab4c3, HorizontalAlignment: Center, VerticalAlignment: Center);
                }
              }
            }

            // Skill cards — design fiche compacte
            // ACTIF : ActiveBar visible, StateBadge ACTIVE vert, ToggleWrap #1a3a1a, Toggle ON
            // INACTIF : ActiveBar hidden, StateBadge hidden, ToggleWrap #2a3040, Toggle OFF
            // EN RECHARGE : StateBadge RECHARGE orange, ToggleWrap #2a2410, Toggle hidden, CdTimer visible
