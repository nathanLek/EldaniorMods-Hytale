            // === STATE 3: HAS GUILD ===
            Group #GuildeHasGuild {
                LayoutMode: Top;
                Visible: false;

                // 1. HEADER
                Label #GuildeName { Text: ""; Style: (FontSize: 20, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: Center, LetterSpacing: 1); Anchor: (Height: 28); }
                Group { Anchor: (Height: 4); }
                Label #GuildeRecruitStatus { Text: ""; Style: (FontSize: 12, TextColor: #5fc77e, HorizontalAlignment: Center); Anchor: (Height: 18); }
                Group { Anchor: (Height: 10); }

                // 2. THREE INFO CARDS (with gold left border)
                Group { LayoutMode: Left; Anchor: (Height: 44);
                    // Card: Fondateur
                    Group { FlexWeight: 1; Background: #162030; LayoutMode: Left;
                        Group { Anchor: (Width: 3, Height: 44); Background: #FFD700; }
                        Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 10, Vertical: 4);
                            Label { Text: "FONDATEUR"; Style: (FontSize: 9, TextColor: #7d8fa3, RenderBold: true, RenderUppercase: true); Anchor: (Height: 14); }
                            Label #GuildeFounder { Text: ""; Style: (FontSize: 13, TextColor: #aabbcc); Anchor: (Height: 18); }
                        }
                    }
                    Group { Anchor: (Width: 4); }
                    // Card: Role
                    Group { FlexWeight: 1; Background: #162030; LayoutMode: Left;
                        Group { Anchor: (Width: 3, Height: 44); Background: #FFD700; }
                        Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 10, Vertical: 4);
                            Label { Text: "VOTRE ROLE"; Style: (FontSize: 9, TextColor: #7d8fa3, RenderBold: true, RenderUppercase: true); Anchor: (Height: 14); }
                            Label #GuildeRole { Text: ""; Style: (FontSize: 13, TextColor: #FFD700, RenderBold: true); Anchor: (Height: 18); }
                        }
                    }
                    Group { Anchor: (Width: 4); }
                    // Card: Membres
                    Group { FlexWeight: 1; Background: #162030; LayoutMode: Left;
                        Group { Anchor: (Width: 3, Height: 44); Background: #FFD700; }
                        Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 10, Vertical: 4);
                            Label { Text: "MEMBRES"; Style: (FontSize: 9, TextColor: #7d8fa3, RenderBold: true, RenderUppercase: true); Anchor: (Height: 14); }
                            Label #GuildeMemberCount { Text: ""; Style: (FontSize: 13, TextColor: #aabbcc); Anchor: (Height: 18); }
                        }
                    }
                }
                Group { Anchor: (Height: 8); }

                // 3. TREASURY + CONTRIBUTION (green left border)
                Group { LayoutMode: Left; Anchor: (Height: 44);
                    // Treasury card
                    Group { FlexWeight: 1; Background: #162030; LayoutMode: Left;
                        Group { Anchor: (Width: 3, Height: 44); Background: #5fc77e; }
                        Group { LayoutMode: Left; FlexWeight: 1; Padding: (Horizontal: 10, Vertical: 6);
                            Label { Text: "TRESORERIE"; Style: (FontSize: 10, TextColor: #7d8fa3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 100); }
                            Label #GuildeTreasury { Text: "0 Or"; Style: (FontSize: 16, TextColor: #FFD700, VerticalAlignment: Center, RenderBold: true); FlexWeight: 1; }
                            TextButton #GuildeBtnDeposit { Text: "+1000"; Anchor: (Width: 65, Height: 26); Style: (Default: (LabelStyle: (FontSize: 10, TextColor: #5fc77e, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #1a3a1a(0.8); }
                            Group { Anchor: (Width: 4); }
                            TextButton #GuildeBtnWithdraw { Text: "-1000"; Anchor: (Width: 65, Height: 26); Visible: false; Style: (Default: (LabelStyle: (FontSize: 10, TextColor: #c44545, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #2a1a1a(0.8); }
                        }
                    }
                    Group { Anchor: (Width: 4); }
                    // Contribution card
                    Group { FlexWeight: 1; Background: #162030; LayoutMode: Left;
                        Group { Anchor: (Width: 3, Height: 44); Background: #5fc77e; }
                        Group { LayoutMode: Left; FlexWeight: 1; Padding: (Horizontal: 10, Vertical: 6);
                            Label { Text: "CONTRIBUTION"; Style: (FontSize: 10, TextColor: #7d8fa3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 110); }
                            Label #GuildeContribution { Text: "0"; Style: (FontSize: 16, TextColor: #5fc77e, VerticalAlignment: Center, RenderBold: true); }
                        }
                    }
                }
                Group { Anchor: (Height: 10); }

                // 4. STATISTICS BLOCK
                Group { Background: #11192680; Padding: (Horizontal: 12, Vertical: 8); LayoutMode: Top;
                    Label { Text: "STATISTIQUES DE GUILDE"; Style: (FontSize: 11, TextColor: #7d8fa3, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, HorizontalAlignment: Center); Anchor: (Height: 16); }
                    Group { Anchor: (Height: 6); }
                    Group { LayoutMode: Left; Anchor: (Height: 32);
