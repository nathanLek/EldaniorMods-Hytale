                    Group #TabGuilde {
            LayoutMode: Top;
            Visible: false;
            Padding: (Horizontal: 14, Vertical: 10);

            // === STATE 1: NOBLE BLOCKED ===
            Group #GuildeNobleBlock {
                LayoutMode: Top;
                Visible: false;
                Group { Anchor: (Height: 80); }
                Label { Text: "GUILDE INDISPONIBLE"; Style: (FontSize: 20, TextColor: #c44545, HorizontalAlignment: Center, RenderBold: true); Anchor: (Height: 28); }
                Group { Anchor: (Height: 10); }
                Label { Text: "Les membres d'une famille noble ne peuvent pas"; Style: (FontSize: 14, TextColor: #7d8fa3, HorizontalAlignment: Center); Anchor: (Height: 20); }
                Label { Text: "creer ou rejoindre une guilde."; Style: (FontSize: 14, TextColor: #7d8fa3, HorizontalAlignment: Center); Anchor: (Height: 20); }
                Group { Anchor: (Height: 8); }
                Label { Text: "Quittez votre famille pour acceder aux guildes."; Style: (FontSize: 12, TextColor: #5a6a7d, HorizontalAlignment: Center); Anchor: (Height: 18); }
            }

            // === STATE 2: NO GUILD ===
            Group #GuildeNoGuild {
                LayoutMode: Top;
                Visible: true;

                Group { Anchor: (Height: 60); }
                Label { Text: "VOUS N'ETES DANS AUCUNE GUILDE"; Style: (FontSize: 18, TextColor: #7d8fa3, HorizontalAlignment: Center, RenderBold: true); Anchor: (Height: 28); }
                Group { Anchor: (Height: 8); }
                Label { Text: "Fondez une guilde aupres d'un Maitre de guilde, ou rejoignez-en une !"; Style: (FontSize: 13, TextColor: #5a6a7d, HorizontalAlignment: Center); Anchor: (Height: 20); }
                Group { Anchor: (Height: 20); }

                Group { Anchor: (Height: 12); }

                // Info cards (level + cost)
                Group { LayoutMode: Left; Anchor: (Height: 34);
                    Group { FlexWeight: 1; }
                    Group { Background: #162030(0.6); LayoutMode: Left; Padding: (Horizontal: 14, Vertical: 4); Anchor: (Width: 200, Height: 34);
                        Label { Text: "NIVEAU REQUIS"; Style: (FontSize: 10, TextColor: #7d8fa3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 120); }
                        Label { Text: "120"; Style: (FontSize: 16, TextColor: #FFD700, VerticalAlignment: Center, RenderBold: true); }
                    }
                    Group { Anchor: (Width: 8); }
                    Group { Background: #162030(0.6); LayoutMode: Left; Padding: (Horizontal: 14, Vertical: 4); Anchor: (Width: 200, Height: 34);
                        Label { Text: "COUT"; Style: (FontSize: 10, TextColor: #7d8fa3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 60); }
                        Label { Text: "150 000 Or"; Style: (FontSize: 16, TextColor: #FFD700, VerticalAlignment: Center, RenderBold: true); }
                    }
                    Group { FlexWeight: 1; }
                }

                Group { Anchor: (Height: 8); }
                Label { Text: "Rendez-vous chez un Maitre de guilde, en ville, pour fonder la votre."; Style: (FontSize: 11, TextColor: #5a6a7d, HorizontalAlignment: Center); Anchor: (Height: 18); }

                // === OPEN GUILDS LIST (paginated) ===
                Group #GuildeOpenGuildSection { LayoutMode: Top; Visible: false;
                    Group { Anchor: (Height: 16); }
                    Group { Anchor: (Height: 1); Background: #5b9bd5(0.3); }
                    Group { Anchor: (Height: 8); }

                    // Header with pagination
                    Group { LayoutMode: Left; Anchor: (Height: 24);
                        Label { Text: "GUILDES EN RECRUTEMENT OUVERT"; Style: (FontSize: 12, TextColor: #5b9bd5, RenderBold: true, RenderUppercase: true, LetterSpacing: 1); FlexWeight: 1; }
                        TextButton #GOpenBtnPrev { Text: "< PREC."; Anchor: (Width: 70, Height: 22); Style: (Default: (LabelStyle: (FontSize: 10, TextColor: #5b9bd5, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #162030(0.6); }
                        Group { Anchor: (Width: 4); }
                        Label #GOpenPage { Text: "1/1"; Style: (FontSize: 10, TextColor: #5a6a7d, HorizontalAlignment: Center, VerticalAlignment: Center); Anchor: (Width: 40); }
                        Group { Anchor: (Width: 4); }
                        TextButton #GOpenBtnNext { Text: "SUIV. >"; Anchor: (Width: 70, Height: 22); Style: (Default: (LabelStyle: (FontSize: 10, TextColor: #5b9bd5, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #162030(0.6); }
                    }

                    Group { Anchor: (Height: 6); }

                    // 5 guild slots
                    Group #GOpenGuild0 { Anchor: (Height: 36); Background: #162030(0.5); LayoutMode: Left; Padding: (Horizontal: 12, Vertical: 4); Visible: false;
                        Label #GOpenGuildName0 { Text: ""; Style: (FontSize: 13, TextColor: #aabbcc, VerticalAlignment: Center); FlexWeight: 1; }
                        Label #GOpenGuildMembers0 { Text: ""; Style: (FontSize: 11, TextColor: #7d8fa3, VerticalAlignment: Center); Anchor: (Width: 80); }
                        TextButton #GOpenGuildBtn0 { Text: "REJOINDRE"; Anchor: (Width: 100, Height: 26); Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #5fc77e, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #1a3a1a(0.8); }
                    }
                    Group { Anchor: (Height: 3); }
                    Group #GOpenGuild1 { Anchor: (Height: 36); Background: #162030(0.5); LayoutMode: Left; Padding: (Horizontal: 12, Vertical: 4); Visible: false;
                        Label #GOpenGuildName1 { Text: ""; Style: (FontSize: 13, TextColor: #aabbcc, VerticalAlignment: Center); FlexWeight: 1; }
                        Label #GOpenGuildMembers1 { Text: ""; Style: (FontSize: 11, TextColor: #7d8fa3, VerticalAlignment: Center); Anchor: (Width: 80); }
                        TextButton #GOpenGuildBtn1 { Text: "REJOINDRE"; Anchor: (Width: 100, Height: 26); Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #5fc77e, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #1a3a1a(0.8); }
                    }
                    Group { Anchor: (Height: 3); }
