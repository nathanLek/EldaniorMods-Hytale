                    Group #TabShop {
            LayoutMode: Top;
            Visible: false;

            Label #ShopCount {
                Text: "MARCHE (0 annonces)";
                Style: (FontSize: 16, TextColor: #4CAF50, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, HorizontalAlignment: Center);
                Anchor: (Height: 24);
            }

            Group { Anchor: (Height: 4); }

            Label {
                Text: "Vendez vos objets : /es sell <prix> (objet en main)";
                Style: (FontSize: 11, TextColor: #556677, HorizontalAlignment: Center);
                Anchor: (Height: 16);
            }

            Group { Anchor: (Height: 6); }

            // Pagination
            Group {
                LayoutMode: Left;
                Anchor: (Height: 30);

                TextButton #ShopBtnPrev {
                    Text: "< PRECEDENT";
                    Anchor: (Width: 140, Height: 28);
                    Style: (Default: (LabelStyle: (FontSize: 12, TextColor: #aabbcc, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                }

                Group { FlexWeight: 1; }

                Label #ShopPage {
                    Text: "Page 1 / 1";
                    Style: (FontSize: 13, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
                }

                Group { FlexWeight: 1; }

                TextButton #ShopBtnNext {
                    Text: "SUIVANT >";
                    Anchor: (Width: 140, Height: 28);
                    Style: (Default: (LabelStyle: (FontSize: 12, TextColor: #aabbcc, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)));
                }
