                    // <<< Observateur

                    Group #TabWiki {
            LayoutMode: Top;
            Visible: false;

            // Header + Navigation
            Group { LayoutMode: Left; Anchor: (Height: 36);
                Label { Text: "WIKI"; Style: (FontSize: 16, TextColor: #FFD700, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, HorizontalAlignment: Center); FlexWeight: 1; }
                TextButton #WikiBtnPrev { Visible: false; Text: "< PREV"; Anchor: (Width: 100, Height: 36); Style: (Default: (LabelStyle: (FontSize: 12, TextColor: #aabbcc, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #2a3040(0.6); }
                Group { Anchor: (Width: 6); }
                Label #WikiPageInfo { Text: "Page 1/12"; Style: (FontSize: 13, TextColor: #FFD700, VerticalAlignment: Center, HorizontalAlignment: Center, RenderBold: true); Anchor: (Width: 140); }
                Group { Anchor: (Width: 6); }
                TextButton #WikiBtnNext { Visible: false; Text: "NEXT >"; Anchor: (Width: 100, Height: 36); Style: (Default: (LabelStyle: (FontSize: 12, TextColor: #aabbcc, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #2a3040(0.6); }
            }
            Group { Anchor: (Height: 1); Background: #FFD700(0.2); }
            Group { Anchor: (Height: 6); }

            Label { Text: "Les commandes du mod commencent par /es"; Style: (FontSize: 11, TextColor: #667788, HorizontalAlignment: Center); Anchor: (Height: 16); }
            Group { Anchor: (Height: 4); }

            // === PAGE 0 : commandes joueur (seule page visible des joueurs ; les autres pages sont reservees aux admins, WikiTab) ===
            Group #WikiPage0 { LayoutMode: Top; Visible: true;
                Label { Text: "COMMANDES JOUEUR"; Style: (FontSize: 24, TextColor: #D4AF37, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 32); }
                Label { Text: "Tout le reste se fait dans ce menu, aux pancartes, aux tableaux et auprès des PNJ (banquier, intendant, Maître de guilde...)."; Style: (FontSize: 13, TextColor: #8899aa, Wrap: true); Anchor: (Height: 36); }
                Group { Anchor: (Height: 6); }
                Group { Anchor: (Height: 50); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #D4AF37; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 5); Label { Text: "/es system"; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 21); } Label { Text: "Ouvre ce menu : profil, compétences et runes, famille, quêtes, classements..."; Style: (FontSize: 13, TextColor: #8899aa); Anchor: (Height: 17); } } }
                Group { Anchor: (Height: 4); }
                Group { Anchor: (Height: 50); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #D4AF37; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 5); Label { Text: "/es party <create|invite|kick|leave|disband|accept|decline|list> [joueur]"; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 21); } Label { Text: "Groupe : jouer ensemble et partager l'expérience"; Style: (FontSize: 13, TextColor: #8899aa); Anchor: (Height: 17); } } }
                Group { Anchor: (Height: 4); }
                Group { Anchor: (Height: 50); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #D4AF37; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 5); Label { Text: "/es duel <joueur|accept|decline>"; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 21); } Label { Text: "Défier un joueur en duel, accepter ou refuser un défi"; Style: (FontSize: 13, TextColor: #8899aa); Anchor: (Height: 17); } } }
                Group { Anchor: (Height: 4); }
                Group { Anchor: (Height: 50); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #D4AF37; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 5); Label { Text: "/es trade <accept|decline|cancel>"; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 21); } Label { Text: "Répondre à un échange (onglet Échanges, près d'un autre joueur)"; Style: (FontSize: 13, TextColor: #8899aa); Anchor: (Height: 17); } } }
                Group { Anchor: (Height: 4); }
                Group { Anchor: (Height: 50); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #D4AF37; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 5); Label { Text: "/es sell <prix>"; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 21); } Label { Text: "Mettre en vente l'objet tenu en main (3 annonces au plus)"; Style: (FontSize: 13, TextColor: #8899aa); Anchor: (Height: 17); } } }
                Group { Anchor: (Height: 4); }
                Group { Anchor: (Height: 50); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #D4AF37; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 5); Label { Text: "/es guild <invite|kick|promote|demote|info|leave|accept|decline|recruitment|join> [nom]"; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 21); } Label { Text: "Gérer sa guilde ou en rejoindre une (fondation : Maître de guilde, en ville)"; Style: (FontSize: 13, TextColor: #8899aa); Anchor: (Height: 17); } } }
                Group { Anchor: (Height: 4); }
                Group { Anchor: (Height: 50); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #D4AF37; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 5); Label { Text: "/es guilddisband"; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 21); } Label { Text: "Dissoudre votre guilde (chef uniquement)"; Style: (FontSize: 13, TextColor: #8899aa); Anchor: (Height: 17); } } }
                Group { Anchor: (Height: 4); }
                Group { Anchor: (Height: 50); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #D4AF37; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 5); Label { Text: "/es kingdom"; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 21); } Label { Text: "Vue d'ensemble du royaume : le roi et ses nobles"; Style: (FontSize: 13, TextColor: #8899aa); Anchor: (Height: 17); } } }
                Group { Anchor: (Height: 4); }
                Group { Anchor: (Height: 50); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #D4AF37; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 5); Label { Text: "/incliner"; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 21); } Label { Text: "S'incliner : salut du Clan Luo"; Style: (FontSize: 13, TextColor: #8899aa); Anchor: (Height: 17); } } }
                Group { Anchor: (Height: 4); }
            }

            // === PAGE 1 : Leveling & Stats ===
            Group #WikiPage1 { LayoutMode: Top; Visible: false;
                Label { Text: "LEVELING & STATS"; Style: (FontSize: 26, TextColor: #1ABC9C, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 180); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "Progressez en gagnant de l'experience en tuant des mobs, des joueurs et en completant des quetes. A chaque niveau, vous recevez +3 points d'attributs a repartir librement. Niveau max : 999. Formule XP : 100 + 140*(N-1) + 5*(N-1)^2. En cas de mort, vous perdez 10% de l'XP du niveau (20% si vous etes PK). L'XP est ajustee selon l'ecart de niveau avec la cible (+2% par niveau au-dessus, -2% par niveau en-dessous)."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Label { Text: "LES 6 ATTRIBUTS"; Style: (FontSize: 22, TextColor: #1ABC9C, RenderBold: true, RenderUppercase: true, LetterSpacing: 2); Anchor: (Height: 28); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 50); Background: #0d1520(0.5); Padding: (Horizontal: 14, Vertical: 6); Label { Text: "FORCE — +0.5 % de degats par point, sans plafond. Augmente vos degats au corps a corps et a distance."; Style: (FontSize: 18, TextColor: #99aabb, Wrap: true); } }
                Group { Anchor: (Height: 3); }
                Group { Anchor: (Height: 50); Background: #0d1520(0.5); Padding: (Horizontal: 14, Vertical: 6); Label { Text: "ENDURANCE — +0.5 endurance par point, et moins de degats recus (25 % a 1 000 points, 60 % max avec passifs)."; Style: (FontSize: 18, TextColor: #99aabb, Wrap: true); } }
                Group { Anchor: (Height: 3); }
                Group { Anchor: (Height: 50); Background: #0d1520(0.5); Padding: (Horizontal: 14, Vertical: 6); Label { Text: "AGILITE — +vitesse, +saut, +resistance chute, +esquive automatique (30 % max vers 3 500 points ; jamais en attaquant)."; Style: (FontSize: 18, TextColor: #99aabb, Wrap: true); } }
                Group { Anchor: (Height: 3); }
                Group { Anchor: (Height: 50); Background: #0d1520(0.5); Padding: (Horizontal: 14, Vertical: 6); Label { Text: "VITALITE — +PV. Chaque point donne +0.5 vitalite. PV max = Vitalite totale x 10. Regeneration passive."; Style: (FontSize: 18, TextColor: #99aabb, Wrap: true); } }
                Group { Anchor: (Height: 3); }
                Group { Anchor: (Height: 50); Background: #0d1520(0.5); Padding: (Horizontal: 14, Vertical: 6); Label { Text: "INTELLIGENCE — +Mana. Chaque point donne +3.33 intelligence. Mana max = Intelligence totale x 10. Regeneration passive."; Style: (FontSize: 18, TextColor: #99aabb, Wrap: true); } }
                Group { Anchor: (Height: 3); }
                Group { Anchor: (Height: 50); Background: #0d1520(0.5); Padding: (Horizontal: 14, Vertical: 6); Label { Text: "CHANCE — +critique (+0.05%/pt, cap 80%), +qualite loot (+0.5%/pt), +evenements rares (+0.5%/pt). Critique = x2 degats."; Style: (FontSize: 18, TextColor: #99aabb, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Label { Text: "SOURCES D'XP"; Style: (FontSize: 22, TextColor: #E67E22, RenderBold: true, RenderUppercase: true, LetterSpacing: 2); Anchor: (Height: 28); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 60); Background: #0d1520(0.5); Padding: (Horizontal: 14, Vertical: 6); Label { Text: "PvE : 30 XP (Gobelin) a 5500 XP (Boss T4). PvP : 100 * (nivVictime/nivTueur), cap 500 + 5*nivVictime. Groupe : +10% XP partage aux membres."; Style: (FontSize: 18, TextColor: #99aabb, Wrap: true); } }
            }

            // === PAGE 2 : Groupe ===
            Group #WikiPage2 { LayoutMode: Top; Visible: false;
                Label { Text: "GROUPE"; Style: (FontSize: 26, TextColor: #3498DB, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 140); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "Le systeme de groupe permet de former une equipe pour explorer les donjons et combattre ensemble. Un HUD dedie affiche en temps reel les membres, leur vie et leur mana. Le chef peut inviter, expulser ou dissoudre le groupe. Les membres partagent les recompenses de quetes et l'experience des mobs tues a proximite. Ideal pour les zones dangereuses et les boss."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es party create"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Creer un nouveau groupe (vous devenez chef)"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es party invite <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Inviter un joueur dans votre groupe"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es party accept | decline"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Accepter ou refuser une invitation de groupe"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es party kick <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Expulser un joueur du groupe (chef uniquement)"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es party leave"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Quitter votre groupe actuel"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es party disband"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Dissoudre le groupe (chef uniquement)"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es party list"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Afficher la liste des membres du groupe"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
            }

            // === PAGE 3 : Duel ===
            Group #WikiPage3 { LayoutMode: Top; Visible: false;
                Label { Text: "DUEL"; Style: (FontSize: 26, TextColor: #ff9800, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 140); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "Affrontez un autre joueur en combat PvP loyal ! Les duels sont entierement proteges : aucune perte d'experience, d'objet ou de monnaie en cas de defaite. Le combat se termine quand un joueur tombe a 0 PV. Le vainqueur est annonce dans le chat. Les duels comptent pour les classements PvP et certaines quetes journalieres de type Duel. Les deux joueurs doivent accepter avant le debut."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #ff9800; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es duel <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Defier un joueur en duel PvP"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #ff9800; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es duel accept"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Accepter un defi de duel"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #ff9800; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es duel decline"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Refuser un defi de duel"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
            }

            // === PAGE 4 : Echange & Commerce ===
            Group #WikiPage4 { LayoutMode: Top; Visible: false;
                Label { Text: "ECHANGE & COMMERCE"; Style: (FontSize: 26, TextColor: #4CAF50, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 140); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "L'economie d'Eldanior repose sur 6 monnaies : Cuivre (1), Argent (10), Or (100), Diamant (1000), Zenith (10000) et Astrale (100000). Echangez des objets avec d'autres joueurs via le trade securise, ou vendez vos items au marche. Une taxe de 12% est prelevee sur les ventes. Le Marche Noir propose des objets rares. Gerez votre fortune pour progresser en noblesse et acquerir des parcelles."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #4CAF50; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es trade <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Proposer un echange d'objets a un joueur"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #4CAF50; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es trade accept | decline | cancel"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Accepter, refuser ou annuler un echange en cours"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #4CAF50; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es sell <prix>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Vendre l'item en main au marche au prix indique"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #4CAF50; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es retirer <montant>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Retirer de l'or de votre banque sous forme de pieces"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
            }

            // === PAGE 5 : Guilde ===
            Group #WikiPage5 { LayoutMode: Top; Visible: false;
                Label { Text: "GUILDE"; Style: (FontSize: 26, TextColor: #2ECC71, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 140); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "Les guildes sont des organisations de joueurs avec hierarchie (Membre, Officier, Chef) et tresorerie commune. Fondation chez un Maitre de guilde, en ville : niveau 120 + 150 000 or. Le chef y achete des ameliorations avec le tresor. Au tableau de guilde : classement, contrats de la semaine et missions individuelles."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #2ECC71; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "Maitre de guilde (PNJ, en ville)"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Fonder une guilde, rejoindre une guilde qui recrute, acheter des ameliorations"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #2ECC71; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "Ameliorations"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Sagesse +3% XP, Fortune +3% or, Effectifs +5 places par niveau (tresor, chef)"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #2ECC71; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "Tableau de guilde (en ville)"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Classement, contrats de la semaine (toute la guilde), missions (2 max)"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #2ECC71; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "Membres"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "15 places, plus 5 par niveau d'Effectifs"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #2ECC71; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es guild invite <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Inviter un joueur dans votre guilde"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #2ECC71; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es guild accept | decline"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Accepter ou refuser une invitation de guilde"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #2ECC71; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es guild kick <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Expulser un membre de la guilde"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #2ECC71; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es guild promote | demote <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Promouvoir ou retrograder un membre"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #2ECC71; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es guild info"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Afficher les informations de votre guilde"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #2ECC71; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es guild leave"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Quitter votre guilde"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #2ECC71; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es guilddisband"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Dissoudre la guilde (Chef uniquement)"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
            }

            // === PAGE 6 : Famille Noble ===
            Group #WikiPage6 { LayoutMode: Top; Visible: false;
                Label { Text: "FAMILLE NOBLE"; Style: (FontSize: 26, TextColor: #C8A2C8, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 140); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "Eldanior compte 9 familles royales, chacune avec une identite et des passifs uniques. Pour rejoindre une famille, vous devez etre Marquis ou Duc minimum. Le chef de famille peut inviter de nouveaux membres. Chaque famille confere des competences passives exclusives renforçant un aspect du personnage. Les familles rivalisent pour le controle des territoires."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #C8A2C8; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es family choose <id>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Choisir une famille noble (rang Marquis ou Duc requis)"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #C8A2C8; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es family invite <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Inviter un joueur dans votre famille"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #C8A2C8; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es family info <id>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Consulter les informations d'une famille"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
            }

            // === PAGE 7 : Noblesse & Eglise ===
            Group #WikiPage7 { LayoutMode: Top; Visible: false;
                Label { Text: "NOBLESSE & EGLISE"; Style: (FontSize: 26, TextColor: #FFD700, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 120); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "Deux hierarchies gouvernent Eldanior. La Noblesse confere la dignite : une aura qui ralentit les mobs proches des nobles de haut rang. L'Eglise offre des benedictions spirituelles. Progressez en remplissant des conditions liees a votre devotion et vos actions dans le monde."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #FFD700; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es rank info <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Consulter le rang de noblesse d'un joueur"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #FFD700; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es church status"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Voir votre rang dans la hierarchie de l'Eglise"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #FFD700; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es church info <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Consulter le rang d'eglise d'un joueur"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 10); }
                Group { Anchor: (Height: 44); Background: #0d1520(0.5); Padding: (Horizontal: 14, Vertical: 6); Label { Text: "Noblesse : Roturier > Baron > Chevalier > Comte > Duc > Marquis > Roi"; Style: (FontSize: 18, TextColor: #99aabb, Wrap: true); } }
                Group { Anchor: (Height: 3); }
                Group { Anchor: (Height: 44); Background: #0d1520(0.5); Padding: (Horizontal: 14, Vertical: 6); Label { Text: "Eglise : Fidele > Acolyte > Pretre > Eveque > Archeveque > Cardinal > Pape"; Style: (FontSize: 18, TextColor: #99aabb, Wrap: true); } }
            }

            // === PAGE 8 : Territoires & Parcelles ===
            Group #WikiPage8 { LayoutMode: Top; Visible: false;
                Label { Text: "TERRITOIRES & PARCELLES"; Style: (FontSize: 26, TextColor: #3498DB, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 140); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "Possedez et gerez des terrains ! 4 types existent : Royaumes, Villes, Parcelles et Logements. Chaque parcelle a un systeme de permissions par role (Proprietaire, Membre, Invite). Les parcelles peuvent etre vendues ou louees (periodes de 7 jours). Les fermes, mines et forets regenerent leurs ressources automatiquement."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Label { Text: "CREATION & INFO"; Style: (FontSize: 22, TextColor: #3498DB, RenderBold: true, RenderUppercase: true, LetterSpacing: 2); Anchor: (Height: 28); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es parcel pos1 | pos2"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Definir les deux coins de votre selection"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es pcreate <type> <nom>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Creer une parcelle dans la zone selectionnee"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es parcel info"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Voir les informations de la parcelle actuelle"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es parcel list"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Lister toutes vos parcelles"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #3498DB; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es pdelete <id|nom>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Supprimer une parcelle"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 10); }
                Label { Text: "VENTE & LOCATION"; Style: (FontSize: 22, TextColor: #4CAF50, RenderBold: true, RenderUppercase: true, LetterSpacing: 2); Anchor: (Height: 28); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #4CAF50; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es psetprice <prix>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Definir le prix de vente de la parcelle"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #4CAF50; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es psetrent <prix>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Definir le prix de location (par 7 jours)"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #4CAF50; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es psell"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Mettre en vente la parcelle"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #4CAF50; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es parcel buy"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Acheter une parcelle en vente"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 10); }
                Label { Text: "GESTION & PERMISSIONS"; Style: (FontSize: 22, TextColor: #ff9800, RenderBold: true, RenderUppercase: true, LetterSpacing: 2); Anchor: (Height: 28); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #ff9800; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es pinvite <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Inviter un joueur dans la parcelle"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #ff9800; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es pkick <joueur>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Expulser un joueur de la parcelle"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #ff9800; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es psetperm <role:permission> <true|false>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Modifier les permissions d'un role"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #ff9800; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es psetrank <joueur> <rang>"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Changer le rang d'un joueur dans la parcelle"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
            }

            // === PAGE 9 : Classes ===
            Group #WikiPage9 { LayoutMode: Top; Visible: false;
                Label { Text: "CLASSES"; Style: (FontSize: 26, TextColor: #E74C3C, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 140); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "5 classes de base : Guerrier (melee, tank), Mage (sorts, DPS magique), Archer (distance, precision), Assassin (furtivite, critique) et Marchand (economie, commerce). A chaque palier (niv. 100, 200, 300, 400), evoluez en sous-classe via un gacha : 3 choix proposes, 2 rerolls max. Le Mage evolue en Pyromancien, Elementaliste, Enchanteur ou Necromancien."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
            }

            // === PAGE 10 : Competences ===
            Group #WikiPage10 { LayoutMode: Top; Visible: false;
                Label { Text: "COMPETENCES"; Style: (FontSize: 26, TextColor: #9B59B6, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 160); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "311 competences passives a collecter ! Les parchemins de competence se trouvent dans les coffres de donjon (respawn 1h). Consommez un parchemin (clic droit) pour apprendre la competence, puis activez-la dans l'onglet Competences du menu. Certaines competences evoluent vers des versions superieures ! 11 categories : Agilite, Attaque, Defense, Detection, Endurance, Magique, Chance, Resistance, Vie, Regeneration, Maitrise."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Group { Anchor: (Height: 68); Background: #1a2030(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #9B59B6; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es system > Competences"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Ouvrir l'onglet pour activer ou desactiver vos competences"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 10); }
                Group { Anchor: (Height: 50); Background: #0d1520(0.5); Padding: (Horizontal: 14, Vertical: 6); Label { Text: "Raretes : Commun (1%) > Rare (0.3%) > Epique (0.1%) > Unique (0.05%) > Legendaire (0.02%) > Divin (0.01%)"; Style: (FontSize: 18, TextColor: #99aabb, Wrap: true); } }
            }

            // === PAGE 11 : Titres ===
            Group #WikiPage11 { LayoutMode: Top; Visible: false;
                Label { Text: "TITRES"; Style: (FontSize: 26, TextColor: #D4AF37, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 140); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "Les titres sont des recompenses honorifiques obtenues en accomplissant des exploits : tuer un boss, atteindre un niveau, remporter des duels, decouvrir des zones secretes... Chaque titre s'affiche au-dessus de votre nom et confere des bonus permanents a vos stats. Vous ne pouvez equiper qu'un seul titre a la fois."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
            }

            // === PAGE 12 : Primes ===
            Group #WikiPage12 { LayoutMode: Top; Visible: false;
                Label { Text: "PRIMES & CRIMINELS"; Style: (FontSize: 26, TextColor: #cc4444, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 140); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "Un joueur PK est recherche : une prime est mise sur sa tete et celui qui l'abat la touche. Les tableaux de prime, en ville, listent les PK et les criminels, et proposent chaque jour des contrats de monstres d'elite. Les chasseurs de prime traquent les PK et les criminels."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Group { Anchor: (Height: 68); Background: #2a1a1a(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #cc4444; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "Tableau de prime (en ville)"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Recherches : PK et criminels, niveau, prime et derniere position"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #2a1a1a(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #cc4444; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "Placer une prime"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Ajouter de l'or a la prime d'un recherche (+10% de commission)"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #2a1a1a(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #cc4444; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "Racheter sa prime"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Un PK efface sa prime pour 2 fois son montant"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #2a1a1a(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #cc4444; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "Criminels"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Hors-la-loi et leurs complices (1 a 10 selon le rang) ; ils epargnent les PK"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #2a1a1a(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #cc4444; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "Chasseurs de prime"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Traquent PK et criminels ; leur part de la prime va au tresor de la ville"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #2a1a1a(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #cc4444; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "Contrats de monstres"; Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true); Anchor: (Height: 28); } Label { Text: "3 monstres d'elite nommes par jour : le premier qui en abat un touche la prime"; Style: (FontSize: 18, TextColor: #8899aa); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
            }

            // === PAGE 13 : Admin (OP) ===
            Group #WikiPage13 { LayoutMode: Top; Visible: false;
                Label { Text: "COMMANDES ADMIN (OP)"; Style: (FontSize: 26, TextColor: #cc4444, RenderBold: true, RenderUppercase: true, LetterSpacing: 3); Anchor: (Height: 34); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 140); Background: #0d1520(0.6); Padding: (Horizontal: 14, Vertical: 10); Label { Text: "Panel d'administration reserve aux operateurs (OP). Modifiez XP, niveaux et classes des joueurs. Promouvez dans les hierarchies de noblesse et d'eglise. Assignez des familles nobles, gerez les parcelles territoriales, creez des hologrammes et configurez les coffres au tresor. L'interface /es admin offre une vue complete."; Style: (FontSize: 20, TextColor: #8899aa, Wrap: true); } }
                Group { Anchor: (Height: 10); }
                Label { Text: "GENERAL"; Style: (FontSize: 22, TextColor: #cc4444, RenderBold: true, RenderUppercase: true, LetterSpacing: 2); Anchor: (Height: 28); }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #2a1a1a(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #cc4444; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es admin"; Style: (FontSize: 24, TextColor: #ff6666, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Ouvrir l'interface d'administration complete"; Style: (FontSize: 18, TextColor: #996666); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #2a1a1a(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #cc4444; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es addxp <joueur> <nombre>"; Style: (FontSize: 24, TextColor: #ff6666, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Ajouter de l'experience a un joueur"; Style: (FontSize: 18, TextColor: #996666); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #2a1a1a(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #cc4444; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es setlevel <joueur> <niveau>"; Style: (FontSize: 24, TextColor: #ff6666, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Definir le niveau d'un joueur"; Style: (FontSize: 18, TextColor: #996666); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 5); }
                Group { Anchor: (Height: 68); Background: #2a1a1a(0.6); LayoutMode: Left; Group { Anchor: (Width: 4); Background: #cc4444; } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 12, Vertical: 8); Label { Text: "/es setclass <joueur> <classId>"; Style: (FontSize: 24, TextColor: #ff6666, RenderBold: true); Anchor: (Height: 28); } Label { Text: "Changer la classe d'un joueur"; Style: (FontSize: 18, TextColor: #996666); Anchor: (Height: 22); } } }
                Group { Anchor: (Height: 10); }
                Label { Text: "PRIMES, PNJ & CONTRATS"; Style: (FontSize: 22, TextColor: #cc4444, RenderBold: true, RenderUppercase: true, LetterSpacing: 2); Anchor: (Height: 28); }
                Group { Anchor: (Height: 5); }
