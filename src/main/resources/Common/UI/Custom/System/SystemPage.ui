                    Group #TabPoche {
            LayoutMode: Top;
            Visible: false;

            // Poche dimensionnelle (2026-11-16, PocheTab) : la poche et l'inventaire du joueur
            Label #PocheInfo {
              Anchor: (Height: 36);
              Style: (FontSize: 12, TextColor: #8899aa, Wrap: true, HorizontalAlignment: Center);
            }
            Group #PocheGrids {
              LayoutMode: Top;
              Visible: false;

              Group {
                Anchor: (Height: 20);
                LayoutMode: Left;
                Label { Text: "Poche dimensionnelle"; FlexWeight: 1; Style: (FontSize: 12, TextColor: #e8b34f, RenderBold: true, RenderUppercase: true); }
                Label #PocheCount { Anchor: (Width: 200); Style: (FontSize: 11, TextColor: #b4c8c9, RenderBold: true, HorizontalAlignment: End); }
              }
              Group {
                Anchor: (Top: 4, Height: 280);
                LayoutMode: Center;
                ItemGrid #PocheGrid {
                  Anchor: (Width: 616, Height: 276);
                  SlotsPerRow: 9;
                  AreItemsDraggable: true;
                  Style: (SlotSize: 64, SlotIconSize: 56, SlotSpacing: 4, SlotBackground: "RuneSlot.png");
                  Padding: 2;
                }
              }
              Group { Anchor: (Top: 8, Height: 1); Background: #e8b34f(0.25); }
              Label {
                Anchor: (Top: 6, Height: 20);
                Text: "Votre inventaire (réserve, barre d'action, sac à dos)";
                Style: (FontSize: 12, TextColor: #e8b34f, RenderBold: true, RenderUppercase: true);
              }
              Group {
                Anchor: (Top: 4, Height: 290);
                LayoutMode: Center;
                ItemGrid #PocheInvGrid {
                  Anchor: (Width: 636, Height: 286);
                  SlotsPerRow: 9;
                  AreItemsDraggable: true;
                  ShowScrollbar: true;
                  KeepScrollPosition: true;
                  ScrollbarStyle: $C.@TranslucentScrollbarStyle;
                  Style: (SlotSize: 64, SlotIconSize: 56, SlotSpacing: 4, SlotBackground: "RuneSlot.png");
                  Padding: 2;
                }
              }
            }
        }

                    // >>> Observateur (scripts/observateur/gen_ui.py)
