                        }
                        Group { FlexWeight: 1; LayoutMode: Left; Padding: (Horizontal: 8);
                            Label { Text: "MORTS"; Style: (FontSize: 10, TextColor: #7d8fa3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 80); }
                            Label #GuildeStatDeaths { Text: "0"; Style: (FontSize: 14, TextColor: #aabbcc, VerticalAlignment: Center, RenderBold: true); }
                        }
                    }
                }
                Group { Anchor: (Height: 10); }

                // 4b. AMELIORATIONS (achetees par le chef chez le Maitre de guilde)
                Group { Background: #11192680; Padding: (Horizontal: 12, Vertical: 8); LayoutMode: Top;
                    Label { Text: "AMELIORATIONS - MAITRE DE GUILDE"; Style: (FontSize: 11, TextColor: #7d8fa3, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, HorizontalAlignment: Center); Anchor: (Height: 16); }
                    Group { Anchor: (Height: 6); }
                    Group { LayoutMode: Left; Anchor: (Height: 40);
                        Group { FlexWeight: 1; Background: #162030; LayoutMode: Left;
                            Group { Anchor: (Width: 3); Background: #5b9bd5; }
                            Group { LayoutMode: Top; FlexWeight: 1; Padding: (Horizontal: 10, Vertical: 4);
                                Group { LayoutMode: Left; Anchor: (Height: 16);
                                    Label { Text: "Sagesse"; Style: (FontSize: 10, TextColor: #7d8fa3, RenderBold: true, RenderUppercase: true); FlexWeight: 1; }
                                    Label #GuildeUpgLevel0 { Text: "0/5"; Style: (FontSize: 10, TextColor: #5a6a7d, RenderBold: true); }
                                }
