$C = "../Common.ui";

$C.@PageOverlay {}

// Proposition d'Observateur (classes/observateur/ObservateurOfferPage), envoyee depuis la Cour ; style du menu Systeme.
// Genere par scripts/observateur/gen_ui.py : modifier le script, pas ce fichier.
// Cadre des fenetres du menu Systeme (System/SystemPage.ui, @GoldContainer), textures du dossier System.
@GoldContainer = Group {
  Group #FrameTitle {
    Anchor: (Height: 38, Top: 0);
    Background: (TexturePath: "../System/GoldHeader.png", HorizontalBorder: 50, VerticalBorder: 0);
  }
  Group #FrameBody {
    Anchor: (Top: 38);
    Background: (TexturePath: "../System/GoldPatch.png", Border: 23);
  }
  Group #FrameDecoTop {
    Anchor: (Width: 236, Height: 11, Top: -12);
    Background: "../System/GoldDecorationTop.png";
  }
  Group #Title {
    Anchor: (Height: 38, Top: 0);
    Padding: (Top: 7);
  }
  Group #Content {
    LayoutMode: Top;
    Anchor: (Top: 38);
    Padding: (Full: 17);
  }
  Group #FrameDecoBottom {
    Anchor: (Width: 236, Height: 11, Bottom: -6);
    Background: "../System/GoldDecorationBottom.png";
  }
};

Group {
  LayoutMode: Center;

  Group {
    Anchor: (Height: 470);
    LayoutMode: Left;

    @GoldContainer #ArkFrame {
      Anchor: (Width: 620, Height: 470);

      #Title {
        Label {
          Text: "Observateur";
          Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
          Padding: (Horizontal: 19);
        }
      }

      #Content {
        LayoutMode: Top;
        Group {
          Anchor: (Height: 54);
          LayoutMode: Left;
          Group {
            Anchor: (Width: 50, Height: 50);
            Background: "../System/CharacterPanelButton.png";
            LayoutMode: CenterMiddle;
            Group { Anchor: (Width: 40, Height: 40); Background: "ClassEmblem_LEGENDARY.png"; }
          }
          Group {
            FlexWeight: 1;
            LayoutMode: Top;
            Padding: (Left: 12, Top: 4);
            Label #ArkSubtitle { Anchor: (Height: 22); Text: ""; Style: (FontSize: 16, TextColor: #f0d58c, RenderBold: true); }
            Label { Anchor: (Height: 18); Text: "Classe unique · Légendaire"; Style: (FontSize: 12, TextColor: #878e9c, RenderBold: false); }
          }
        }
        Group { Anchor: (Top: 10, Height: 2); Background: #c99436(0.18); }
        Label #ArkText { Anchor: (Top: 14); Text: ""; Style: (FontSize: 14, TextColor: #d1dae6, RenderBold: false, Wrap: true); }
        Group #ArkWarnRow {
          Anchor: (Top: 14, Height: 64);
          LayoutMode: Left;
          Background: (TexturePath: "../System/GoldPanelPatch.png", Border: 4);
          Visible: true;
          Group { Anchor: (Width: 4); Background: #c99436; }
          Group {
            FlexWeight: 1;
            LayoutMode: Middle;
            Padding: (Horizontal: 12);
            Label #ArkWarn { Text: ""; Style: (FontSize: 13, TextColor: #f0d58c, RenderBold: true, Wrap: true); }
          }
        }
        Label #ArkKeep { Anchor: (Top: 10); Text: ""; Style: (FontSize: 12, TextColor: #878e9c, RenderBold: false, Wrap: true, HorizontalAlignment: Center); }
        Group { FlexWeight: 1; }
        Group { Anchor: (Top: 6, Height: 2); Background: #c99436(0.18); }
        Group {
          Anchor: (Top: 10, Height: 44);
          LayoutMode: Left;
          $C.@SecondaryTextButton #ArkCancel {
            @Text = "Décliner";
            @Anchor = Anchor(Width: 200);
          }
          Group { FlexWeight: 1; }
          $C.@TextButton #ArkAccept {
            @Text = "Servir le souverain";
            @Anchor = Anchor(Width: 260);
          }
        }
      }
    }
  }
}
