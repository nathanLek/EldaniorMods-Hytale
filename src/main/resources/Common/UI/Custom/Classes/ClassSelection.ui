$C = "../Common.ui";

SceneBlur {}

Group {
  Background: #000000(0.75);
}

Group {
  LayoutMode: Center;

  Group {
    Anchor: (Width: 960, Height: 560);
    LayoutMode: Top;

    Label {
      Text: "CHOIX DE CLASSE";
      Anchor: (Height: 38);
      Style: (FontSize: 26, RenderBold: true, RenderUppercase: true, TextColor: #FFD700, HorizontalAlignment: Center);
    }

    Group { Anchor: (Height: 8); }

    Group {
      LayoutMode: Left;
      FlexWeight: 1;

      Group #ClassCard0 { FlexWeight: 1; Background: #0d1b2a(0.95); LayoutMode: Top; Padding: (Horizontal: 10, Vertical: 8); Visible: false;
        Group { LayoutMode: Left; Anchor: (Height: 22); Label #CName0 { Text: ""; Style: (FontSize: 16, TextColor: #FFD700, RenderBold: true); FlexWeight: 1; } Label #CRarity0 { Text: ""; Style: (FontSize: 13, TextColor: #8899aa, HorizontalAlignment: End, RenderBold: true); Anchor: (Width: 70); } }
        Label #CType0 { Text: ""; Style: (FontSize: 12, TextColor: #ff9800, RenderBold: true); Anchor: (Height: 16); }
        Group { Anchor: (Height: 2); Background: #FFD700(0.3); }
        Group { Anchor: (Height: 4); }
        Label #CDesc0 { Text: ""; Style: (FontSize: 12, TextColor: #aabbcc, Wrap: true); Anchor: (Height: 110); }
        Group { Anchor: (Height: 6); }
        Label { Text: "BONUS STATS"; Style: (FontSize: 10, TextColor: #667788, RenderUppercase: true); Anchor: (Height: 14); }
        Group { LayoutMode: Left; Anchor: (Height: 18); Label #CStat0a { Text: ""; Style: (FontSize: 12, TextColor: #ddeeff); FlexWeight: 1; } Label #CStat0b { Text: ""; Style: (FontSize: 12, TextColor: #ddeeff); FlexWeight: 1; } Label #CStat0c { Text: ""; Style: (FontSize: 12, TextColor: #ddeeff); FlexWeight: 1; } }
