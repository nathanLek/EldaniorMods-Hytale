                Visible: false;
                Style: (Default: (Background: PatchStyle(TexturePath: "../System/GoldPanelPatch.png", Border: 4)), Hovered: (Background: PatchStyle(TexturePath: "../System/GoldPanelHover.png", Border: 4)), Sounds: $C.@ButtonSounds);
                Group #SvTBar14 { Anchor: (Width: 4); Background: #c99436(0.45); }
                Group {
                  FlexWeight: 1;
                  LayoutMode: Top;
                  Padding: (Left: 10, Right: 6, Top: 6);
                  Label #SvTL14 { Anchor: (Height: 18); Text: ""; Style: (FontSize: 13, TextColor: #f0d58c, RenderBold: true, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9); }
                  Label #SvTS14 { Anchor: (Height: 15); Text: ""; Style: (FontSize: 11, TextColor: #a9b8c8, RenderBold: false, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 8); }
                }
              }
            }
            Group {
              Anchor: (Top: 8, Height: 32);
              LayoutMode: Left;
              $C.@SmallSecondaryTextButton #SvPrev {
                @Text = "< Précédent";
                @Anchor = Anchor(Width: 140);
              }
              Group { FlexWeight: 1; }
              Label #SvPage { Text: ""; Style: (FontSize: 13, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
              Group { FlexWeight: 1; }
              $C.@SmallSecondaryTextButton #SvNext {
                @Text = "Suivant >";
                @Anchor = Anchor(Width: 140);
              }
            }
          }
        }
        Group { Anchor: (Top: 8, Height: 2); Background: #c99436(0.18); }
        Group {
          Anchor: (Top: 8, Height: 44);
          LayoutMode: Left;
          Label #SvHint { FlexWeight: 1; Text: ""; Style: (FontSize: 12, TextColor: #878e9c, RenderBold: false, VerticalAlignment: Center, Wrap: true); }
          Group { Anchor: (Width: 10); }
          $C.@SecondaryTextButton #SvCour {
            @Text = "Ma charge";
            @Anchor = Anchor(Width: 170);
          }
          Group { Anchor: (Width: 8); }
          $C.@SecondaryTextButton #SvClose {
            @Text = "Fermer";
            @Anchor = Anchor(Width: 130);
          }
        }
      }
    }
  }
}
