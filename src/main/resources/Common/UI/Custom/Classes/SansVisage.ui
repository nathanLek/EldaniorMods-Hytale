$C = "../Common.ui";

$C.@PageOverlay {}

// Fenetre de la rune Sans Visage de l'Observateur (classes/observateur/SansVisagePage), style du menu Systeme.
// Genere par scripts/observateur/gen_ui.py : modifier le script, pas ce fichier.
// Cadre des fenetres du menu Systeme (System/SystemPage.ui, @GoldContainer), textures du dossier System.
@GoldContainer = Group {
  Group #FrameTitle {
    Anchor: (Height: 38, Top: 0);
    Background: (TexturePath: "../System/GoldHeader.png", HorizontalBorder: 50, VerticalBorder: 0);
  }
  Group #FrameBody {
    Anchor: (Top: 38);
    Background: (TexturePath: "../System/GoldPatch.png", Border: 23);
  }
  Group #FrameDecoTop {
    Anchor: (Width: 236, Height: 11, Top: -12);
    Background: "../System/GoldDecorationTop.png";
  }
  Group #Title {
    Anchor: (Height: 38, Top: 0);
    Padding: (Top: 7);
  }
  Group #Content {
    LayoutMode: Top;
    Anchor: (Top: 38);
    Padding: (Full: 17);
  }
  Group #FrameDecoBottom {
    Anchor: (Width: 236, Height: 11, Bottom: -6);
    Background: "../System/GoldDecorationBottom.png";
  }
};

Group {
  LayoutMode: Center;

  Group {
    Anchor: (Height: 780);
    LayoutMode: Left;

    @GoldContainer #SvFrame {
      Anchor: (Width: 1080, Height: 780);

      #Title {
        Label {
          Text: "Sans Visage";
          Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
          Padding: (Horizontal: 19);
        }
      }

      #Content {
        LayoutMode: Top;
        // ---- etat actuel : case de la rune, visage / nom / classe portes
        Group {
          Anchor: (Height: 54);
          LayoutMode: Left;
          Group {
            Anchor: (Width: 50, Height: 50);
            Background: "../System/CharacterPanelButton.png";
            LayoutMode: CenterMiddle;
            ItemIcon #SvIcon { Anchor: (Width: 38, Height: 38); }
          }
          Group {
            FlexWeight: 1;
            LayoutMode: Top;
            Padding: (Left: 12, Top: 4);
            Label #SvState { Anchor: (Height: 22); Text: ""; Style: (FontSize: 15, TextColor: #f0d58c, RenderBold: true, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10); }
            Label #SvState2 { Anchor: (Height: 18); Text: ""; Style: (FontSize: 12, TextColor: #a9b8c8, RenderBold: false, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9); }
          }
        }
        Group { Anchor: (Top: 10, Height: 2); Background: #c99436(0.18); }
        Group {
          Anchor: (Top: 12);
          FlexWeight: 1;
          LayoutMode: Left;
          Group {
            Anchor: (Width: 320);
            LayoutMode: Top;
            Group {
              Anchor: (Top: 0, Height: 18);
              LayoutMode: Left;
              Group { Anchor: (Width: 6, Height: 6, Top: 6); Background: #c99436; }
              Label { Anchor: (Left: 6); FlexWeight: 1; Text: "Aperçu"; Style: (TextColor: #e8b34f, FontSize: 13, RenderBold: true, RenderUppercase: true); }
            }
            Group { Anchor: (Top: 4, Height: 2); Background: #c99436(0.18); }
            Group {
              Anchor: (Top: 6, Height: 272);
              LayoutMode: Top;
              Padding: (Full: 1);
              Background: #ffffff(0.12);
              Group {
                FlexWeight: 1;
                LayoutMode: Top;
                Background: #0b0e14(0.88);
                ItemPreviewComponent #SvPreview {
                  Anchor: (Height: 238);
                  Visible: false;
                }
                Group #SvNoPreview {
                  Anchor: (Height: 238);
                  LayoutMode: Middle;
                  Label { Text: "?"; Style: (FontSize: 64, TextColor: #3a4256, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
                }
                Label #SvPreviewName { Anchor: (Height: 30); Text: ""; Style: (FontSize: 14, TextColor: #f0d58c, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
              }
            }
            Group { Anchor: (Height: 8); }
            $C.@TextButton #SvWear {
              @Text = "Choisissez un visage";
            }
            Group {
              Anchor: (Top: 6, Height: 32);
              LayoutMode: Left;
              $C.@SmallSecondaryTextButton #SvRandom {
                @Text = "Au hasard";
                @Anchor = Anchor(Width: 140);
              }
              Group { FlexWeight: 1; }
              $C.@SmallSecondaryTextButton #SvReveal {
                @Text = "Mon vrai visage";
                @Anchor = Anchor(Width: 170);
              }
            }
            Group {
              Anchor: (Top: 14, Height: 18);
              LayoutMode: Left;
              Group { Anchor: (Width: 6, Height: 6, Top: 6); Background: #c99436; }
              Label { Anchor: (Left: 6); FlexWeight: 1; Text: "Nom d'emprunt"; Style: (TextColor: #e8b34f, FontSize: 13, RenderBold: true, RenderUppercase: true); }
            }
            Group { Anchor: (Top: 4, Height: 2); Background: #c99436(0.18); }
            Group {
              Anchor: (Top: 8, Height: 32);
              LayoutMode: Left;
              $C.@TextField #SvName {
                Anchor: (Height: 32);
                FlexWeight: 1;
                PlaceholderText: "Nom au-dessus de vous";
              }
              Group { Anchor: (Width: 6); }
              $C.@SmallSecondaryTextButton #SvNameOk {
                @Text = "OK";
                @Anchor = Anchor(Width: 60);
              }
              Group { Anchor: (Width: 4); }
              $C.@SmallSecondaryTextButton #SvNameOff {
                @Text = "Retirer";
                @Anchor = Anchor(Width: 90);
              }
            }
            Group {
              Anchor: (Top: 14, Height: 18);
              LayoutMode: Left;
              Group { Anchor: (Width: 6, Height: 6, Top: 6); Background: #c99436; }
              Label { Anchor: (Left: 6); FlexWeight: 1; Text: "Classe apparente"; Style: (TextColor: #e8b34f, FontSize: 13, RenderBold: true, RenderUppercase: true); }
            }
            Group { Anchor: (Top: 4, Height: 2); Background: #c99436(0.18); }
            Group {
              Anchor: (Top: 8, Height: 32);
              LayoutMode: Left;
              $C.@DropdownBox #SvClass {
                Anchor: (Width: 160, Height: 30);
              }
              Group { Anchor: (Width: 6); }
              $C.@SmallSecondaryTextButton #SvClassOk {
                @Text = "OK";
                @Anchor = Anchor(Width: 60);
              }
              Group { Anchor: (Width: 4); }
              $C.@SmallSecondaryTextButton #SvClassOff {
                @Text = "Retirer";
                @Anchor = Anchor(Width: 90);
              }
            }
          }
          Group { Anchor: (Width: 18); }
          Group { Anchor: (Width: 2); Background: #c99436(0.18); }
          Group { Anchor: (Width: 18); }
          Group {
            FlexWeight: 1;
            LayoutMode: Top;
            Group {
              Anchor: (Height: 34);
              LayoutMode: Left;
              Group { FlexWeight: 1; }
              Group {
                Anchor: (Width: 150);
                LayoutMode: Top;
                TextButton #SvTab0 {
                  Text: "";
                  Anchor: (Height: 31);
                  Style: (Default: (LabelStyle: (FontSize: 13, TextColor: #c9d1dc, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true, LetterSpacing: 1)), Hovered: (LabelStyle: (FontSize: 13, TextColor: #FFD700, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true, LetterSpacing: 1)));
                  Background: #141a24(0.85);
