$C = "../Common.ui";

$C.@PageOverlay {}

Group {
  LayoutMode: Center;

  Group #TradePanel {
    Anchor: (Width: 760, Height: 560);
    Background: #0a0e18(0.96);
    LayoutMode: Top;
    Padding: (Horizontal: 20, Vertical: 14);

    // =============== HEADER ===============
    Group #Header {
      LayoutMode: Left;
      Anchor: (Height: 34);

      Group { FlexWeight: 1; }
      Label {
        Text: "ECHANGE";
        Style: (FontSize: 22, TextColor: #D4AF37, RenderBold: true, RenderUppercase: true, LetterSpacing: 3, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
      Group { FlexWeight: 1; }
    }

    Group { Anchor: (Height: 2); Background: #D4AF37(0.4); }
    Group { Anchor: (Height: 6); }

    // =============== STATUS ===============
    Label #TradeStatus {
      Text: "Deposez vos items depuis la hotbar et validez l'echange.";
      Style: (FontSize: 12, TextColor: #667788, HorizontalAlignment: Center, Wrap: true);
      Anchor: (Height: 20);
    }

    Group { Anchor: (Height: 10); }

    // =============== ZONE D'ECHANGE ===============
    Group #TradeContent {
      LayoutMode: Left;
      FlexWeight: 1;

      // ===== MON COTE (gauche) =====
      Group #MySide {
        FlexWeight: 1;
        LayoutMode: Top;
        Background: #0d1520(0.6);
        Padding: (Full: 10);

        // Mon nom
        Group {
          LayoutMode: Left;
          Anchor: (Height: 26);
          Group { FlexWeight: 1; }
          Label #MyName {
            Text: "Mes Items";
            Style: (FontSize: 15, TextColor: #D4AF37, RenderBold: true, HorizontalAlignment: Center, RenderUppercase: true, LetterSpacing: 1);
          }
          Group { FlexWeight: 1; }
        }
        Group { Anchor: (Height: 2); Background: #D4AF37(0.2); }
        Group { Anchor: (Height: 8); }

        // Grille 2x6 = 12 slots
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Button #MySlot0 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Button #MySlot1 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }
        Group { Anchor: (Height: 4); }
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Button #MySlot2 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Button #MySlot3 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }
        Group { Anchor: (Height: 4); }
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Button #MySlot4 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Button #MySlot5 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }
        Group { Anchor: (Height: 4); }
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Button #MySlot6 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Button #MySlot7 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }
        Group { Anchor: (Height: 4); }
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Button #MySlot8 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Button #MySlot9 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }
        Group { Anchor: (Height: 4); }
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Button #MySlot10 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Button #MySlot11 { Anchor: (Width: 44, Height: 44); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }

        Group { FlexWeight: 1; }

        // Mon statut de validation
        Group {
          Anchor: (Height: 24);
          Background: #0a1018(0.8);
          LayoutMode: Left;
          Group { FlexWeight: 1; }
          Label #MyValidLabel {
            Text: "NON VALIDE";
            Style: (FontSize: 12, TextColor: #cc4444, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true);
          }
          Group { FlexWeight: 1; }
        }
      }

      // ===== SEPARATEUR CENTRAL =====
      Group {
        Anchor: (Width: 24);
        LayoutMode: Middle;
        Label {
          Style: (FontSize: 28, TextColor: #D4AF37(0.6), HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
          Text: "⟷";
        }
      }

      // ===== SON COTE (droite) =====
      Group #OtherSide {
        FlexWeight: 1;
        LayoutMode: Top;
        Background: #0d1520(0.6);
        Padding: (Full: 10);

        // Son nom
        Group {
          LayoutMode: Left;
          Anchor: (Height: 26);
          Group { FlexWeight: 1; }
          Label #OtherName {
            Text: "Ses Items";
            Style: (FontSize: 15, TextColor: #6699cc, RenderBold: true, HorizontalAlignment: Center, RenderUppercase: true, LetterSpacing: 1);
          }
          Group { FlexWeight: 1; }
        }
        Group { Anchor: (Height: 2); Background: #6699cc(0.2); }
        Group { Anchor: (Height: 8); }

        // Grille 2x6 lecture seule
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Group #OtherSlot0 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Group #OtherSlot1 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }
        Group { Anchor: (Height: 4); }
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Group #OtherSlot2 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Group #OtherSlot3 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }
        Group { Anchor: (Height: 4); }
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Group #OtherSlot4 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Group #OtherSlot5 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }
        Group { Anchor: (Height: 4); }
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Group #OtherSlot6 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Group #OtherSlot7 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }
        Group { Anchor: (Height: 4); }
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Group #OtherSlot8 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Group #OtherSlot9 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }
        Group { Anchor: (Height: 4); }
        Group { LayoutMode: Left; Anchor: (Height: 46); Group { FlexWeight: 1; }
          Group #OtherSlot10 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
          Group { Anchor: (Width: 6); }
          Group #OtherSlot11 { Anchor: (Width: 44, Height: 44); Background: #111825; Padding: (Full: 2); ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
        Group { FlexWeight: 1; } }

        Group { FlexWeight: 1; }

        // Son statut de validation
        Group {
          Anchor: (Height: 24);
          Background: #0a1018(0.8);
          LayoutMode: Left;
          Group { FlexWeight: 1; }
          Label #OtherValidLabel {
            Text: "NON VALIDE";
            Style: (FontSize: 12, TextColor: #cc4444, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true);
          }
          Group { FlexWeight: 1; }
        }
      }
    }

    // =============== HOTBAR ===============
    Group { Anchor: (Height: 8); }
    Group { Anchor: (Height: 1); Background: #2a3040(0.5); }
    Group { Anchor: (Height: 4); }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 16);
      Group { FlexWeight: 1; }
      Label { Text: "VOTRE HOTBAR"; Style: (FontSize: 10, TextColor: #556677, RenderUppercase: true, LetterSpacing: 1, HorizontalAlignment: Center); }
      Group { FlexWeight: 1; }
    }

    Group { Anchor: (Height: 4); }

    Group #TradeHotbar {
      LayoutMode: Left;
      Anchor: (Height: 44);

      Group { FlexWeight: 1; }
      Button #THotbar0 { Anchor: (Width: 42, Height: 42); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
      Group { Anchor: (Width: 4); }
      Button #THotbar1 { Anchor: (Width: 42, Height: 42); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
      Group { Anchor: (Width: 4); }
      Button #THotbar2 { Anchor: (Width: 42, Height: 42); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
      Group { Anchor: (Width: 4); }
      Button #THotbar3 { Anchor: (Width: 42, Height: 42); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
      Group { Anchor: (Width: 4); }
      Button #THotbar4 { Anchor: (Width: 42, Height: 42); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
      Group { Anchor: (Width: 4); }
      Button #THotbar5 { Anchor: (Width: 42, Height: 42); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
      Group { Anchor: (Width: 4); }
      Button #THotbar6 { Anchor: (Width: 42, Height: 42); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
      Group { Anchor: (Width: 4); }
      Button #THotbar7 { Anchor: (Width: 42, Height: 42); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
      Group { Anchor: (Width: 4); }
      Button #THotbar8 { Anchor: (Width: 42, Height: 42); Padding: (Full: 2); Style: (Default: (Background: #1a2838), Hovered: (Background: #2a4060)); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TextTooltipShowDelay: 0.1; ItemIcon #Icon { Visible: false; } Label #Qty { Text: ""; Style: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End, RenderBold: true); Anchor: (Right: 2, Bottom: 0); } }
      Group { FlexWeight: 1; }
    }

    // =============== BOUTONS ===============
    Group { Anchor: (Height: 10); }

    Group #TradeButtons {
      LayoutMode: Left;
      Anchor: (Height: 42);

      Group { FlexWeight: 1; }

      TextButton #BtnValidate {
        Text: "VALIDER L'ECHANGE";
        Anchor: (Width: 220, Height: 38);
        Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #4CAF50, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true)));
        Background: #1a2a1a(0.9);
      }

      Group { Anchor: (Width: 30); }

      TextButton #BtnCancel {
        Text: "ANNULER";
        Anchor: (Width: 160, Height: 38);
        Style: (Default: (LabelStyle: (FontSize: 14, TextColor: #cc4444, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true)), Hovered: (LabelStyle: (FontSize: 14, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, RenderUppercase: true)));
        Background: #2a1a1a(0.9);
      }

      Group { FlexWeight: 1; }
    }
  }
}
