// HUD des quetes en cours (quest/QuestHud.java), genere par scripts/quetes/gen_quest_hud.py.
Group {
    LayoutMode: Top;
    Padding: (Top: 10);

    Group {
        LayoutMode: Left;
        Anchor: (Height: 520);

        Group { Anchor: (Width: 10); }

        Group {
            Anchor: (Width: 430);
            LayoutMode: Top;

            // === QUETE PRINCIPALE ===
            Group #QHudMainPanel {
                LayoutMode: Top;
                Visible: false;
                Padding: (Full: 2);
                Background: #f2c45e;

                Group {
                    LayoutMode: Top;
                    Background: (TexturePath: "QHudPatch.png", Border: 16);
                    Padding: (Left: 8, Right: 14, Top: 8, Bottom: 10);

                    Group {
                        Anchor: (Height: 58);
                        LayoutMode: Left;
                        Group #QHudMainRankTab {
                            Anchor: (Width: 62, Height: 58);
                            LayoutMode: Left;
                            Group {
                                Anchor: (Width: 58, Height: 58);
                                Group #QHudMainBadgeF { Anchor: (Left: 0, Top: 0, Width: 58, Height: 58); Background: (TexturePath: "QHudRankF.png"); Visible: false; }
                                Group #QHudMainBadgeE { Anchor: (Left: 0, Top: 0, Width: 58, Height: 58); Background: (TexturePath: "QHudRankE.png"); Visible: false; }
                                Group #QHudMainBadgeD { Anchor: (Left: 0, Top: 0, Width: 58, Height: 58); Background: (TexturePath: "QHudRankD.png"); Visible: false; }
                                Group #QHudMainBadgeC { Anchor: (Left: 0, Top: 0, Width: 58, Height: 58); Background: (TexturePath: "QHudRankC.png"); Visible: false; }
                                Group #QHudMainBadgeB { Anchor: (Left: 0, Top: 0, Width: 58, Height: 58); Background: (TexturePath: "QHudRankB.png"); Visible: false; }
                                Group #QHudMainBadgeA { Anchor: (Left: 0, Top: 0, Width: 58, Height: 58); Background: (TexturePath: "QHudRankA.png"); Visible: false; }
                                Group #QHudMainBadgeS { Anchor: (Left: 0, Top: 0, Width: 58, Height: 58); Background: (TexturePath: "QHudRankS.png"); Visible: false; }
                                Group #QHudMainBadgeSS { Anchor: (Left: 0, Top: 0, Width: 58, Height: 58); Background: (TexturePath: "QHudRankSS.png"); Visible: false; }
                                Group #QHudMainBadgeEX { Anchor: (Left: 0, Top: 0, Width: 58, Height: 58); Background: (TexturePath: "QHudRankEX.png"); Visible: false; }
                                Label #QHudMainRank {
                                    Anchor: (Left: 0, Top: 0, Width: 58, Height: 58);
                                    Style: (FontName: "Secondary", FontSize: 24, RenderBold: true, TextColor: #ffe98a, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 14);
                                }
                            }
                            Group { Anchor: (Width: 2); }
                            Group #QHudMainRankLine { Anchor: (Width: 2); Background: #f2c45e; }
                        }
                        Group {
                            FlexWeight: 1;
                            LayoutMode: Top;
                            Padding: (Left: 10, Top: 4);
                            Label #QHudMainType {
                                Anchor: (Height: 16);
                                Style: (FontSize: 10, RenderBold: true, RenderUppercase: true, TextColor: #f2c45e, VerticalAlignment: Center, LetterSpacing: 1);
                            }
                            Label #QHudMainName {
                                Style: (FontSize: 15, RenderBold: true, TextColor: #f2c45e, Wrap: true);
                            }
                        }
                    }
                    Group { Anchor: (Top: 4, Height: 1); Background: #ffffff(0.14); }
                    Group { Anchor: (Height: 4); }
                    Group #QHudMainObj0 {
                        Anchor: (Height: 21);
                        LayoutMode: Left;
                        Visible: false;
                        Group {
                            Anchor: (Width: 16, Height: 16, Top: 2);
                            Group #QHudMainObjOff0 { Anchor: (Left: 0, Top: 0, Width: 16, Height: 16); Background: (TexturePath: "ChapCheckOff.png"); }
                            Group #QHudMainObjOn0 { Anchor: (Left: 0, Top: 0, Width: 16, Height: 16); Background: (TexturePath: "ChapCheckOn.png"); Visible: false; }
                        }
                        Label #QHudMainObjText0 {
                            FlexWeight: 1;
                            Anchor: (Left: 7);
                            Style: (FontSize: 12, RenderBold: true, TextColor: #b8c2d0, VerticalAlignment: Center);
                        }
                        Label #QHudMainObjCount0 {
                            Anchor: (Width: 78);
                            Style: (FontSize: 12, RenderBold: true, TextColor: #77879d, HorizontalAlignment: End, VerticalAlignment: Center);
                        }
                    }
                    Group #QHudMainObj1 {
                        Anchor: (Height: 21);
                        LayoutMode: Left;
                        Visible: false;
                        Group {
                            Anchor: (Width: 16, Height: 16, Top: 2);
                            Group #QHudMainObjOff1 { Anchor: (Left: 0, Top: 0, Width: 16, Height: 16); Background: (TexturePath: "ChapCheckOff.png"); }
                            Group #QHudMainObjOn1 { Anchor: (Left: 0, Top: 0, Width: 16, Height: 16); Background: (TexturePath: "ChapCheckOn.png"); Visible: false; }
                        }
