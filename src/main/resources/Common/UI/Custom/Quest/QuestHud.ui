Group {
    LayoutMode: Top;
    Padding: (Top: 10);

    Group {
        LayoutMode: Left;
        Anchor: (Height: 180);

        Group { Anchor: (Width: 10); }

        Group {
            Anchor: (Width: 460);
            LayoutMode: Top;

            // === HUD QUETE PRINCIPALE ===
            Group #QHudMainPanel {
                Anchor: (Height: 72);
                Background: #0c0a06(0.90);
                LayoutMode: Top;
                Padding: (Horizontal: 10, Vertical: 4);
                Visible: false;

                // Ligne 1 : categorie
                Label #QHudMainCategory {
                    Text: "QUETE PRINCIPALE";
                    Style: (FontSize: 9, TextColor: #FFD700, RenderBold: true, RenderUppercase: true, LetterSpacing: 1);
                    Anchor: (Height: 13);
                }

                // Ligne 2 : titre + difficulte
                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 17);

                    Label #QHudMainName {
                        Text: "";
                        Style: (FontSize: 13, TextColor: #FFD700, RenderBold: true);
                        FlexWeight: 1;
                    }
                    Label #QHudMainDiff {
                        Text: "";
                        Style: (FontSize: 15, TextColor: #ff9800, RenderBold: true, HorizontalAlignment: End);
                        Anchor: (Width: 36);
                    }
                }

                Group { Anchor: (Height: 6); }

                // Ligne 3 : objectifs dans des containers
                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 24);

                    Group #QHudMainObj1Box {
                        FlexWeight: 1;
                        Anchor: (Height: 24);
                        Background: #1a1a2e(0.8);
                        LayoutMode: Left;
                        Padding: (Horizontal: 6);
                        Visible: false;

                        Label #QHudMainObj1 {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ddeeff, VerticalAlignment: Center);
                            FlexWeight: 1;
                        }
                        Label #QHudMainObj1Count {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: End, RenderBold: true);
                            Anchor: (Width: 40);
                        }
                    }

                    Group { Anchor: (Width: 4); }

                    Group #QHudMainObj2Box {
                        FlexWeight: 1;
                        Anchor: (Height: 24);
                        Background: #1a1a2e(0.8);
                        LayoutMode: Left;
                        Padding: (Horizontal: 6);
                        Visible: false;

                        Label #QHudMainObj2 {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ddeeff, VerticalAlignment: Center);
                            FlexWeight: 1;
                        }
                        Label #QHudMainObj2Count {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: End, RenderBold: true);
                            Anchor: (Width: 40);
                        }
                    }

                    Group { Anchor: (Width: 4); }

                    Group #QHudMainObj3Box {
                        FlexWeight: 1;
                        Anchor: (Height: 24);
                        Background: #1a1a2e(0.8);
                        LayoutMode: Left;
                        Padding: (Horizontal: 6);
                        Visible: false;

                        Label #QHudMainObj3 {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ddeeff, VerticalAlignment: Center);
                            FlexWeight: 1;
                        }
                        Label #QHudMainObj3Count {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: End, RenderBold: true);
                            Anchor: (Width: 40);
                        }
                    }

                    // Progression simple (quetes sans multi-objectifs)
                    Label #QHudMainProg {
                        Text: "";
                        Style: (FontSize: 11, TextColor: #4CAF50, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Anchor: (Width: 0);
                    }
                }
            }

            Group { Anchor: (Height: 3); }

            // === HUD QUETE ACTIVE ===
            Group #QuestHudPanel {
                Anchor: (Height: 72);
                Background: #080c14(0.88);
                LayoutMode: Top;
                Padding: (Horizontal: 10, Vertical: 4);
                Visible: false;

                // Ligne 1 : categorie
                Label #QHudCategory {
                    Text: "QUETE ACTIVE";
                    Style: (FontSize: 9, TextColor: #8899aa, RenderBold: true, RenderUppercase: true, LetterSpacing: 1);
                    Anchor: (Height: 13);
                }

                // Ligne 2 : titre + difficulte
                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 17);

                    Label #QHudName {
                        Text: "";
                        Style: (FontSize: 13, TextColor: #ffffff, RenderBold: true);
                        FlexWeight: 1;
                    }
                    Label #QHudDiff {
                        Text: "";
                        Style: (FontSize: 15, TextColor: #ff9800, RenderBold: true, HorizontalAlignment: End);
                        Anchor: (Width: 36);
                    }
                }

                Group { Anchor: (Height: 6); }

                // Ligne 3 : objectifs dans des containers
                Group {
                    LayoutMode: Left;
                    Anchor: (Height: 24);

                    Group #QHudObj1Box {
                        FlexWeight: 1;
                        Anchor: (Height: 24);
                        Background: #1a1a2e(0.8);
                        LayoutMode: Left;
                        Padding: (Horizontal: 6);
                        Visible: false;

                        Label #QHudObj1 {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ddeeff, VerticalAlignment: Center);
                            FlexWeight: 1;
                        }
                        Label #QHudObj1Count {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: End, RenderBold: true);
                            Anchor: (Width: 40);
                        }
                    }

                    Group { Anchor: (Width: 4); }

                    Group #QHudObj2Box {
                        FlexWeight: 1;
                        Anchor: (Height: 24);
                        Background: #1a1a2e(0.8);
                        LayoutMode: Left;
                        Padding: (Horizontal: 6);
                        Visible: false;

                        Label #QHudObj2 {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ddeeff, VerticalAlignment: Center);
                            FlexWeight: 1;
                        }
                        Label #QHudObj2Count {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: End, RenderBold: true);
                            Anchor: (Width: 40);
                        }
                    }

                    Group { Anchor: (Width: 4); }

                    Group #QHudObj3Box {
                        FlexWeight: 1;
                        Anchor: (Height: 24);
                        Background: #1a1a2e(0.8);
                        LayoutMode: Left;
                        Padding: (Horizontal: 6);
                        Visible: false;

                        Label #QHudObj3 {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ddeeff, VerticalAlignment: Center);
                            FlexWeight: 1;
                        }
                        Label #QHudObj3Count {
                            Text: "";
                            Style: (FontSize: 10, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: End, RenderBold: true);
                            Anchor: (Width: 40);
                        }
                    }

                    Label #QHudProg {
                        Text: "";
                        Style: (FontSize: 11, TextColor: #4CAF50, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                        Anchor: (Width: 0);
                    }
                    Label #QHudReward {
                        Text: "";
                        Anchor: (Width: 0);
                        Visible: false;
                    }
                }
            }
        }

        Group { FlexWeight: 1; }
    }
}
