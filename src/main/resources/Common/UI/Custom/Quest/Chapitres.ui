      Group #ChapCardBadge2 { Anchor: (Left: 170, Top: 20, Width: 52, Height: 52); Background: (TexturePath: "ChapRankBadge.png"); }
      Label #ChapCardPlus2 {
        Anchor: (Left: 0, Top: 270, Width: 392, Height: 120);
        Text: "+";
        Visible: false;
        Style: (FontName: "Secondary", FontSize: 110, RenderBold: true, TextColor: #c58643, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
      Label #ChapCardRank2 {
        Anchor: (Left: 170, Top: 20, Width: 52, Height: 52);
        Style: (FontName: "Secondary", FontSize: 24, RenderBold: true, TextColor: #ffe98a, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 14);
      }
      Group #ChapCardLock2 { Anchor: (Left: 168, Top: 300, Width: 56, Height: 56); Background: (TexturePath: "ChapLock.png"); Visible: false; }
      Label #ChapCardTitle2 {
        Anchor: (Left: 30, Top: 556, Width: 332, Height: 36);
        Style: (FontName: "Secondary", FontSize: 21, RenderBold: true, RenderUppercase: true, TextColor: #f2c45e, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
      Label #ChapCardState2 {
        Anchor: (Left: 30, Top: 594, Width: 332, Height: 20);
        Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #d1dae6, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
    Button #ChapPrev {
      Anchor: (Left: 553, Top: 547, Width: 40, Height: 80);
      Visible: false;
      Style: (Default: (Background: #000000(0)), Hovered: (Background: #000000(0)), Sounds: $C.@ButtonSounds);
      Group { Anchor: (Left: 0, Top: 0, Width: 40, Height: 80); Background: (TexturePath: "ChapArrowLeft.png"); }
    }
    Button #ChapNext {
      Anchor: (Left: 1734, Top: 547, Width: 40, Height: 80);
      Visible: false;
      Style: (Default: (Background: #000000(0)), Hovered: (Background: #000000(0)), Sounds: $C.@ButtonSounds);
      Group { Anchor: (Left: 0, Top: 0, Width: 40, Height: 80); Background: (TexturePath: "ChapArrowRight.png"); }
    }

    // ---- actions (provisoires) ----
    Group {
      Anchor: (Left: 611, Top: 948, Width: 1105, Height: 48);
      LayoutMode: Center;
      Group #ChapActionBox {
        LayoutMode: Left;
        $C.@TextButton #ChapAction {
          @Anchor = Anchor(MinWidth: 260, Right: 16);
          Text: "Accepter";
        }
        $C.@SecondaryTextButton #ChapAlt {
          @Anchor = (MinWidth: 180, Right: 16);
          Text: "Autre quête";
          Visible: false;
        }
        $C.@SecondaryTextButton #ChapFilter {
          @Anchor = (MinWidth: 240, Right: 16);
          Text: "Catégorie : toutes";
          Visible: false;
        }
      }
      $C.@SecondaryTextButton #ChapClose {
        @Anchor = (MinWidth: 200);
        Text: "Fermer";
      }
    }
    Label #ChapHint {
      Anchor: (Left: 611, Top: 1004, Width: 1105, Height: 24);
      Style: (FontSize: 15, RenderBold: true, TextColor: #8a96a8, HorizontalAlignment: Center, VerticalAlignment: Center);
    }
    Label {
      Anchor: (Left: 40, Top: 1028, Width: 300, Height: 24);
      Text: "Échap  ·  Retour";
      Style: (FontSize: 15, RenderBold: true, RenderUppercase: true, TextColor: #77879d, VerticalAlignment: Center);
    }

    Label #ChapEmpty {
      Anchor: (Left: 94, Top: 500, Width: 419, Height: 40);
      Text: "Aucune quête pour le moment.";
      Visible: false;
      Style: (FontSize: 20, RenderBold: true, TextColor: #77879D, HorizontalAlignment: Center);
    }

    // ---- detail de l'acte choisi ----
    Group #ChapDetail {
      Anchor: (Left: 0, Top: 0, Width: 540, Height: 1080);

      Group { Anchor: (Left: 196, Top: 123, Width: 216, Height: 216); Background: (TexturePath: "ChapEmblemFrame.png"); }
      Group { Anchor: (Left: 234, Top: 158, Width: 140, Height: 140); Background: (TexturePath: "ChapEmblemBack.png"); }
      Label #ChapRank {
        Anchor: (Left: 234, Top: 166, Width: 140, Height: 104);
        Style: (FontName: "Secondary", FontSize: 76, RenderBold: true, TextColor: #ffe98a, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 44);
      }

      Label #ChapMission {
        Anchor: (Left: 96, Top: 254, Width: 415, Height: 22);
        Style: (FontSize: 15, RenderBold: true, RenderUppercase: true, TextColor: #b9a2d8, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
      Label #ChapChain {
        Anchor: (Left: 96, Top: 280, Width: 415, Height: 22);
