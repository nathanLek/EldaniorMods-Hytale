              Style: (FontSize: 15, RenderBold: true, TextColor: #878e9c, VerticalAlignment: Center);
            }
          }
          Label #PxPriceCap {
            Style: (FontSize: 10, RenderBold: true, RenderUppercase: true, TextColor: #878e9c, HorizontalAlignment: Center);
          }
        }
        Group #PxRecipe {
          Anchor: (Top: 8);
          LayoutMode: Top;
          Visible: false;
          Label #PxRecipeCap {
            Text: "Recette — cliquer un ingrédient pour l'ouvrir";
            Style: (FontSize: 10, RenderBold: true, RenderUppercase: true, TextColor: #e8a93b, HorizontalAlignment: Start);
          }
          Button #PxIng0 {
            Anchor: (Height: 32, Top: 3);
            LayoutMode: Left;
            Visible: false;
            Style: (
              Default: (Background: #1b2836),
              Hovered: (Background: #26384b),
              Pressed: (Background: #2f4660),
              Sounds: $C.@ButtonSounds
            );
            Group {
              Anchor: (Width: 34);
              LayoutMode: Middle;
              ItemIcon #PxIngIcon0 { Anchor: (Width: 26, Height: 26); }
            }
            Label #PxIngName0 {
              FlexWeight: 1;
              Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center);
            }
            Label #PxIngInfo0 {
              Anchor: (Width: 150, Right: 6);
              Style: (FontSize: 11, RenderBold: true, TextColor: #e8a93b, HorizontalAlignment: End, VerticalAlignment: Center);
            }
          }
          Button #PxIng1 {
            Anchor: (Height: 32, Top: 3);
            LayoutMode: Left;
            Visible: false;
            Style: (
              Default: (Background: #1b2836),
              Hovered: (Background: #26384b),
              Pressed: (Background: #2f4660),
              Sounds: $C.@ButtonSounds
            );
            Group {
              Anchor: (Width: 34);
              LayoutMode: Middle;
              ItemIcon #PxIngIcon1 { Anchor: (Width: 26, Height: 26); }
            }
            Label #PxIngName1 {
              FlexWeight: 1;
              Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center);
            }
            Label #PxIngInfo1 {
              Anchor: (Width: 150, Right: 6);
              Style: (FontSize: 11, RenderBold: true, TextColor: #e8a93b, HorizontalAlignment: End, VerticalAlignment: Center);
            }
          }
          Button #PxIng2 {
            Anchor: (Height: 32, Top: 3);
            LayoutMode: Left;
            Visible: false;
            Style: (
              Default: (Background: #1b2836),
              Hovered: (Background: #26384b),
              Pressed: (Background: #2f4660),
              Sounds: $C.@ButtonSounds
            );
            Group {
              Anchor: (Width: 34);
              LayoutMode: Middle;
              ItemIcon #PxIngIcon2 { Anchor: (Width: 26, Height: 26); }
            }
            Label #PxIngName2 {
              FlexWeight: 1;
              Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center);
            }
            Label #PxIngInfo2 {
              Anchor: (Width: 150, Right: 6);
              Style: (FontSize: 11, RenderBold: true, TextColor: #e8a93b, HorizontalAlignment: End, VerticalAlignment: Center);
            }
          }
          Button #PxIng3 {
            Anchor: (Height: 32, Top: 3);
            LayoutMode: Left;
            Visible: false;
            Style: (
              Default: (Background: #1b2836),
              Hovered: (Background: #26384b),
              Pressed: (Background: #2f4660),
              Sounds: $C.@ButtonSounds
            );
            Group {
              Anchor: (Width: 34);
              LayoutMode: Middle;
              ItemIcon #PxIngIcon3 { Anchor: (Width: 26, Height: 26); }
            }
            Label #PxIngName3 {
              FlexWeight: 1;
              Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center);
            }
            Label #PxIngInfo3 {
              Anchor: (Width: 150, Right: 6);
              Style: (FontSize: 11, RenderBold: true, TextColor: #e8a93b, HorizontalAlignment: End, VerticalAlignment: Center);
            }
          }
          Button #PxIng4 {
            Anchor: (Height: 32, Top: 3);
            LayoutMode: Left;
            Visible: false;
            Style: (
              Default: (Background: #1b2836),
              Hovered: (Background: #26384b),
              Pressed: (Background: #2f4660),
              Sounds: $C.@ButtonSounds
            );
            Group {
              Anchor: (Width: 34);
              LayoutMode: Middle;
              ItemIcon #PxIngIcon4 { Anchor: (Width: 26, Height: 26); }
            }
            Label #PxIngName4 {
              FlexWeight: 1;
              Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center);
            }
            Label #PxIngInfo4 {
              Anchor: (Width: 150, Right: 6);
              Style: (FontSize: 11, RenderBold: true, TextColor: #e8a93b, HorizontalAlignment: End, VerticalAlignment: Center);
            }
          }
          Label #PxRecipeNote {
            Anchor: (Top: 4);
            Style: (FontSize: 11, TextColor: #96a9be, Wrap: true);
          }
        }
        Label #PxUsed {
          Anchor: (Top: 6);
          Style: (FontSize: 11, TextColor: #878e9c, Wrap: true);
        }
        Group { FlexWeight: 1; }
        Label {
          Text: "Nouveau prix, en cuivres (1 or = 100)";
          Style: (FontSize: 10, RenderBold: true, RenderUppercase: true, TextColor: #96a9be, HorizontalAlignment: Start);
        }
        Group {
          Anchor: (Top: 4, Height: 32);
          LayoutMode: Left;
          $C.@NumberField #PxValue {
            Anchor: (Width: 170, Height: 30);
            Format: (MaxDecimalPlaces: 0, Step: 10);
          }
          $C.@SmallSecondaryTextButton #PxSave { @Anchor = (Left: 6); Text: "Enregistrer"; FlexWeight: 1; }
        }
        Group {
          Anchor: (Top: 6, Height: 32);
          LayoutMode: Left;
          $C.@SmallSecondaryTextButton #PxDiv2 { @Anchor = (Right: 3); Text: "/2"; FlexWeight: 1; }
          $C.@SmallSecondaryTextButton #PxM10 { @Anchor = (Right: 3); Text: "-10 %"; FlexWeight: 1; }
          $C.@SmallSecondaryTextButton #PxP10 { @Anchor = (Right: 3); Text: "+10 %"; FlexWeight: 1; }
          $C.@SmallSecondaryTextButton #PxMul2 { Text: "x2"; FlexWeight: 1; }
        }
        Group {
          Anchor: (Top: 6, Height: 32);
          LayoutMode: Left;
          $C.@SmallSecondaryTextButton #PxReset { Text: "Revenir au prix de base"; FlexWeight: 1; }
        }
        Label #PxMsg {
          Anchor: (Top: 4, Height: 34);
          Style: (FontSize: 12, RenderBold: true, TextColor: #00e7b6, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
        }
      }
      Group {
        Anchor: (Width: 236, Height: 11, Bottom: -6);
        Background: "../Common/ContainerDecorationBottom.png";
      }
    }
  }
}
