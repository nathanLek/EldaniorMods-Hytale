        Anchor: (Height: 38, Top: 0);
        Padding: (Top: 7);
        Background: (TexturePath: "../Common/ContainerHeaderNoRunes.png", HorizontalBorder: 35, VerticalBorder: 0);
        Group {
          LayoutMode: Left;
          Padding: (Left: 16, Right: 16);
          Label {
            Text: "Économie";
            Style: (...$C.@TitleStyle);
          }
          Group {
            Anchor: (Width: 6, Height: 10, Left: 10, Right: 8);
            Background: "../Common/ContainerTitleArrow.png";
          }
          Label #PxSub {
            Style: (...$C.@TitleStyle, RenderBold: true, TextColor: #ffffff);
          }
          Group { FlexWeight: 1; }
          Label #PxCount {
            Style: (FontSize: 13, RenderBold: true, TextColor: #96a9be, VerticalAlignment: Center);
          }
        }
      }
