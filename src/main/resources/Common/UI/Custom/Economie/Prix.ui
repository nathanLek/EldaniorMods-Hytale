    Group { Anchor: (Width: 14); }
    Group #PxSide {
      Anchor: (Width: 420, Height: 720);
      Group #PxSideHead {
        Anchor: (Height: 38, Top: 0);
        Padding: (Top: 7);
        Background: (TexturePath: "../Common/ContainerHeader.png", HorizontalBorder: 50, VerticalBorder: 0);
        Group {
          Anchor: (Width: 236, Height: 11, Top: -12);
          Background: "../Common/ContainerDecorationTop.png";
        }
        Label #PxSideTitle {
          Text: "Prix de l'objet";
          Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        }
      }
      Group #PxSideBody {
        LayoutMode: Top;
        Anchor: (Top: 38);
        Padding: (Full: 17);
        Background: (TexturePath: "../Common/ContainerPatch.png", Border: 23);
        Group {
          Anchor: (Height: 96);
          LayoutMode: Left;
          Group {
            Anchor: (Width: 96, Height: 96);
            LayoutMode: Middle;
            Padding: (Full: 2);
            Background: #e8a93b;
            Group {
              Anchor: (Width: 92, Height: 92);
              LayoutMode: Middle;
              Background: #1b2836;
              ItemIcon #PxBig { Anchor: (Width: 78, Height: 78); }
            }
          }
          Group {
            FlexWeight: 1;
            LayoutMode: Top;
            Padding: (Left: 12, Top: 2);
            Label #PxName {
              Style: (FontSize: 17, RenderBold: true, TextColor: #ffffff, Wrap: true);
            }
            Label #PxId {
              Anchor: (Top: 2);
              Style: (FontSize: 11, TextColor: #878e9c);
            }
            Label #PxKind {
              Anchor: (Top: 4);
              Style: (FontSize: 12, RenderBold: true, TextColor: #96a9be, Wrap: true);
            }
          }
        }
        $C.@PanelSeparatorFancy { @Anchor = (Top: 8); }
        Group {
          Anchor: (Top: 8, Height: 56);
          LayoutMode: Top;
          Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
          Padding: (Top: 6);
          Group {
            Anchor: (Height: 26);
            LayoutMode: Center;
            ItemIcon #PxPriceCIcon0 { Anchor: (Width: 22, Height: 22); Visible: false; }
            Label #PxPriceCN0 {
              Anchor: (Left: 2, Right: 7);
              Visible: false;
              Style: (FontSize: 17, RenderBold: true, TextColor: #e8a93b, VerticalAlignment: Center);
            }
            ItemIcon #PxPriceCIcon1 { Anchor: (Width: 22, Height: 22); Visible: false; }
