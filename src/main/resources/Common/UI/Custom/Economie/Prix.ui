$C = "../Common.ui";

// Editeur des prix (/es prix, economy/PriceEditorPage), genere par scripts/economie/gen_prix_ui.py : voir ce script.
$C.@PageOverlay {
  LayoutMode: Middle;

  Group {
    Anchor: (Width: 1304, Height: 720);
    LayoutMode: Left;
    Group #PxMain {
      Anchor: (Width: 870, Height: 720);
