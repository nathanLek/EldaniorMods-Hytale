                // === DETAIL PANEL (shared, expandable) ===
                Group #AWDetail {
                    Visible: false;
                    LayoutMode: Top;
                    Background: #0a1018(0.95);
                    Padding: (Horizontal: 14, Vertical: 10);

                    // === HEADER ===
                    Group { LayoutMode: Left; Anchor: (Height: 26);
                        Label #AWDetName { Text: ""; Style: (FontSize: 16, TextColor: #FFD700, RenderBold: true, VerticalAlignment: Center); FlexWeight: 1; }
