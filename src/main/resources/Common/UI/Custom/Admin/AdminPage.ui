                Group { Anchor: (Height: 8); }

                Group { LayoutMode: Left; Anchor: (Height: 32);
                    TextButton #AResetGuilds { Text: "RESET GUILDES"; Anchor: (Width: 115, Height: 28); Style: (Default: (LabelStyle: (FontSize: 10, TextColor: #cc4444, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #2a0d0d(0.8); }
                    Group { Anchor: (Width: 4); }
                    TextButton #AResetFamilies { Text: "RESET FAMILLES"; Anchor: (Width: 120, Height: 28); Style: (Default: (LabelStyle: (FontSize: 10, TextColor: #cc4444, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #2a0d0d(0.8); }
                    Group { Anchor: (Width: 4); }
                    TextButton #AResetParcels { Text: "RESET PARCELLES"; Anchor: (Width: 130, Height: 28); Style: (Default: (LabelStyle: (FontSize: 10, TextColor: #cc4444, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #2a0d0d(0.8); }
                }
                Group { Anchor: (Height: 4); }
                Group { LayoutMode: Left; Anchor: (Height: 32);
                    TextButton #AResetShop { Text: "RESET SHOP"; Anchor: (Width: 100, Height: 28); Style: (Default: (LabelStyle: (FontSize: 10, TextColor: #cc4444, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #2a0d0d(0.8); }
                    Group { Anchor: (Width: 4); }
                    TextButton #AResetClassements { Text: "RESET CLASSEMENTS"; Anchor: (Width: 145, Height: 28); Style: (Default: (LabelStyle: (FontSize: 10, TextColor: #cc4444, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 10, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #2a0d0d(0.8); }
                }
                Group { Anchor: (Height: 12); }
                Group { Anchor: (Height: 1); Background: #ff0000(0.4); }
                Group { Anchor: (Height: 6); }
                TextButton #AResetAll { Text: "RESET COMPLET DU SERVEUR"; Anchor: (Height: 32); Style: (Default: (LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true)), Hovered: (LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true))); Background: #cc2222(0.9); }
            }

            // Prefill buttons are now in TabPlayers above
        }
    }
}
