$C = "../Common.ui";

$C.@PageOverlay {}

Group {
    LayoutMode: Center;

    Group #MainPanel {
        Anchor: (Width: 1050, Height: 700);
        Background: #0c1018(0.92);
        LayoutMode: Left;

        // =============================================
        // SIDEBAR GAUCHE
        // =============================================
        Group #NavBar {
            Anchor: (Width: 180);
            Background: #1a0a0a(0.95);
            LayoutMode: Top;
            Padding: (Vertical: 10, Horizontal: 8);

            Label {
                Text: "ADMIN";
                Style: (FontSize: 18, TextColor: #cc4444, RenderBold: true, LetterSpacing: 3, HorizontalAlignment: Center);
                Anchor: (Height: 26);
            }
            Label {
                Text: "Eldanior System";
                Style: (FontSize: 9, TextColor: #555555, HorizontalAlignment: Center);
                Anchor: (Height: 14);
            }

            Group { Anchor: (Height: 6); }
            Group { Anchor: (Height: 1); Background: #cc4444(0.3); }
            Group { Anchor: (Height: 8); }

            TextButton #TabBtnDashboard {
                Text: "DASHBOARD";
                Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #cc4444, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 28);
                Background: #2a1a1a(0.6);
            }

            Group { Anchor: (Height: 3); }

            TextButton #TabBtnPlayers {
                Text: "PLAYERS";
                Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #4CAF50, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 28);
                Background: #1a2a1a(0.6);
            }

            Group { Anchor: (Height: 3); }

            TextButton #TabBtnWorld {
                Text: "WORLD";
                Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #D4AF37, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 28);
                Background: #2a2a1a(0.6);
            }

            Group { Anchor: (Height: 3); }

            TextButton #TabBtnEconomy {
                Text: "ECONOMIE";
                Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #2196F3, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 28);
                Background: #1a1a2a(0.6);
            }

            Group { Anchor: (Height: 3); }

            TextButton #TabBtnHolograms {
                Text: "HOLOGRAMMES";
                Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #4CAF50, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 28);
                Background: #0d2a0d(0.6);
            }

            Group { Anchor: (Height: 3); }

            TextButton #TabBtnData {
                Text: "DATA RESET";
                Style: (Default: (LabelStyle: (FontSize: 11, TextColor: #ff4444, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (LabelStyle: (FontSize: 11, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)));
                Anchor: (Height: 28);
                Background: #3a0a0a(0.6);
            }

            Group { FlexWeight: 1; }
            Group { Anchor: (Height: 1); Background: #333333(0.3); }
            Group { Anchor: (Height: 3); }
            Label {
                Text: "OP ONLY";
                Style: (FontSize: 8, TextColor: #cc4444, HorizontalAlignment: Center);
                Anchor: (Height: 12);
            }
        }

        // =============================================
        // CONTENU PRINCIPAL
        // =============================================
        Group #ContentArea {
            FlexWeight: 1;
            Padding: (Horizontal: 14, Vertical: 10);
            LayoutMode: TopScrolling;

            // ===== TAB DASHBOARD =====
            Group #TabDashboard {
                LayoutMode: Top;
                Visible: true;

                Label { Text: "DASHBOARD"; Style: (FontSize: 16, TextColor: #cc4444, RenderBold: true, LetterSpacing: 3, HorizontalAlignment: Center); Anchor: (Height: 22); }
                Group { Anchor: (Height: 4); }
                Group { Anchor: (Height: 1); Background: #cc4444(0.2); }
                Group { Anchor: (Height: 8); }

                // === SECTION: SERVEUR ===
                Label { Text: "SERVEUR"; Style: (FontSize: 10, TextColor: #4CAF50, RenderBold: true, LetterSpacing: 1); Anchor: (Height: 14); }
                Group { Anchor: (Height: 4); }
                Group { LayoutMode: Left; Anchor: (Height: 44);
                    Group { FlexWeight: 1; Anchor: (Height: 44); Background: #0d2a0d(0.6); LayoutMode: Top; Padding: (Horizontal: 8, Vertical: 4);
                        Label { Text: "Joueurs Online"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 12); }
                        Label #AdminStatPlayers { Text: "0"; Style: (FontSize: 20, TextColor: #4CAF50, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 26); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 44); Background: #1a1a2e(0.6); LayoutMode: Top; Padding: (Horizontal: 8, Vertical: 4);
                        Label { Text: "Mobs"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 12); }
                        Label #AdminStatMobs { Text: "0"; Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 26); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 44); Background: #1a1a2e(0.6); LayoutMode: Top; Padding: (Horizontal: 8, Vertical: 4);
                        Label { Text: "NPCs"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 12); }
                        Label #AdminStatNpcs { Text: "0"; Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 26); }
                    }
                }

                Group { Anchor: (Height: 8); }

                // === SECTION: CONTENU ===
                Label { Text: "CONTENU DU JEU"; Style: (FontSize: 10, TextColor: #2196F3, RenderBold: true, LetterSpacing: 1); Anchor: (Height: 14); }
                Group { Anchor: (Height: 4); }
                Group { LayoutMode: Left; Anchor: (Height: 38);
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a1a2e(0.5); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Classes"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #AdminStatClasses { Text: "0"; Style: (FontSize: 16, TextColor: #2196F3, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a1a2e(0.5); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Skills"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #AdminStatSkills { Text: "0"; Style: (FontSize: 16, TextColor: #9C27B0, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a1a2e(0.5); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Titres"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #AdminStatTitres { Text: "0"; Style: (FontSize: 16, TextColor: #C8A2C8, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a1a2e(0.5); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Quetes"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #AdminStatQuetes { Text: "0"; Style: (FontSize: 16, TextColor: #FF9800, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                }

                Group { Anchor: (Height: 8); }

                // === SECTION: TERRITOIRE ===
                Label { Text: "TERRITOIRE"; Style: (FontSize: 10, TextColor: #D4AF37, RenderBold: true, LetterSpacing: 1); Anchor: (Height: 14); }
                Group { Anchor: (Height: 4); }
                Group { LayoutMode: Left; Anchor: (Height: 38);
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #2a2a1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Royaumes"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatKingdoms { Text: "0"; Style: (FontSize: 16, TextColor: #cc4444, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #2a2a1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Territoires"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatTerritories { Text: "0"; Style: (FontSize: 16, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #2a2a1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Villes"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatCities { Text: "0"; Style: (FontSize: 16, TextColor: #2196F3, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #2a2a1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Parcelles"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatPlots { Text: "0"; Style: (FontSize: 16, TextColor: #4CAF50, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #2a2a1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Logements"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatHousing { Text: "0"; Style: (FontSize: 16, TextColor: #9C27B0, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #2a2a1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Fermes"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatFarms { Text: "0"; Style: (FontSize: 16, TextColor: #8BC34A, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                }

                Group { Anchor: (Height: 8); }

                // === SECTION: ECONOMIE & SOCIAL ===
                Label { Text: "ECONOMIE & SOCIAL"; Style: (FontSize: 10, TextColor: #D4AF37, RenderBold: true, LetterSpacing: 1); Anchor: (Height: 14); }
                Group { Anchor: (Height: 4); }
                Group { LayoutMode: Left; Anchor: (Height: 38);
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a1a2e(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Guildes"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatGuilds { Text: "0"; Style: (FontSize: 16, TextColor: #4CAF50, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a1a2e(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Familles"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatFamilies { Text: "0/9"; Style: (FontSize: 16, TextColor: #C8A2C8, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a1a2e(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Shop"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatShop { Text: "0"; Style: (FontSize: 16, TextColor: #D4AF37, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #2a0d0d(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Black Market"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatBlackMarket { Text: "0"; Style: (FontSize: 16, TextColor: #cc4444, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a1a2e(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "PvP Zones"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatPvp { Text: "0"; Style: (FontSize: 16, TextColor: #cc4444, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                }

                Group { Anchor: (Height: 8); }

                // === SECTION: NOBLESSE ===
                Label { Text: "NOBLESSE"; Style: (FontSize: 10, TextColor: #C8A2C8, RenderBold: true, LetterSpacing: 1); Anchor: (Height: 14); }
                Group { Anchor: (Height: 4); }
                Group { LayoutMode: Left; Anchor: (Height: 38);
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a0d1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Roi"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatKing { Text: "Aucun"; Style: (FontSize: 11, TextColor: #cc4444, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a0d1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Marquis"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatMarquis { Text: "0"; Style: (FontSize: 16, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a0d1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Ducs"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatDucs { Text: "0"; Style: (FontSize: 16, TextColor: #9C27B0, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a0d1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Comtes"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatComtes { Text: "0"; Style: (FontSize: 16, TextColor: #2196F3, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a0d1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Barons"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatBarons { Text: "0"; Style: (FontSize: 16, TextColor: #4CAF50, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #1a0d1a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Chevaliers"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatChevaliers { Text: "0"; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                }

                Group { Anchor: (Height: 8); }

                // === SECTION: EGLISE ===
                Label { Text: "EGLISE"; Style: (FontSize: 10, TextColor: #7EB8DA, RenderBold: true, LetterSpacing: 1); Anchor: (Height: 14); }
                Group { Anchor: (Height: 4); }
                Group { LayoutMode: Left; Anchor: (Height: 38);
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #0d1a2a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Pape"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatPope { Text: "Aucun"; Style: (FontSize: 11, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #0d1a2a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Cardinaux"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatCardinals { Text: "0"; Style: (FontSize: 16, TextColor: #cc4444, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #0d1a2a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Archeveques"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatArcheveques { Text: "0"; Style: (FontSize: 16, TextColor: #2196F3, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 38); Background: #0d1a2a(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Pretres"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatPretres { Text: "0"; Style: (FontSize: 16, TextColor: #4CAF50, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 22); }
                    }
                }

                Group { Anchor: (Height: 8); }

                // === SECTION: ARGENT EN CIRCULATION ===
                Label { Text: "ARGENT EN CIRCULATION"; Style: (FontSize: 10, TextColor: #D4AF37, RenderBold: true, LetterSpacing: 1); Anchor: (Height: 14); }
                Group { Anchor: (Height: 4); }
                Group { LayoutMode: Left; Anchor: (Height: 44);
                    Group { FlexWeight: 1; Anchor: (Height: 44); Background: #2a2a0d(0.5); LayoutMode: Top; Padding: (Horizontal: 8, Vertical: 4);
                        Label { Text: "Total Serveur"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 12); }
                        Label #DStatTotalMoney { Text: "0"; Style: (FontSize: 18, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 26); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 44); Background: #1a1a0d(0.5); LayoutMode: Top; Padding: (Horizontal: 8, Vertical: 4);
                        Label { Text: "Joueurs"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 12); }
                        Label #DStatPlayerMoney { Text: "0"; Style: (FontSize: 16, TextColor: #D4AF37, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 26); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 44); Background: #1a1a0d(0.5); LayoutMode: Top; Padding: (Horizontal: 8, Vertical: 4);
                        Label { Text: "Guildes"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 12); }
                        Label #DStatGuildMoney { Text: "0"; Style: (FontSize: 16, TextColor: #4CAF50, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 26); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 44); Background: #1a1a0d(0.5); LayoutMode: Top; Padding: (Horizontal: 8, Vertical: 4);
                        Label { Text: "Tresoreries"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 12); }
                        Label #DStatParcelMoney { Text: "0"; Style: (FontSize: 16, TextColor: #2196F3, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 26); }
                    }
                }

                Group { Anchor: (Height: 8); }

                // === SECTION: MOBS & QUETES ===
                Label { Text: "MOBS & QUETES"; Style: (FontSize: 10, TextColor: #FF9800, RenderBold: true, LetterSpacing: 1); Anchor: (Height: 14); }
                Group { Anchor: (Height: 4); }
                Group { LayoutMode: Left; Anchor: (Height: 34);
                    Group { FlexWeight: 1; Anchor: (Height: 34); Background: #2a1a0d(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Familles Mobs"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatMobFamilies { Text: "22"; Style: (FontSize: 14, TextColor: #FF9800, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 18); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 34); Background: #2a1a0d(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Total Quetes"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatQuestsTotal { Text: "122"; Style: (FontSize: 14, TextColor: #FF9800, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 18); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 34); Background: #2a1a0d(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "HP/Lvl Mob"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatMobHp { Text: "+10"; Style: (FontSize: 14, TextColor: #4CAF50, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 18); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 34); Background: #2a1a0d(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Dmg/Lvl Mob"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatMobDmg { Text: "+0.5"; Style: (FontSize: 14, TextColor: #cc4444, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 18); }
                    }
                    Group { Anchor: (Width: 3); }
                    Group { FlexWeight: 1; Anchor: (Height: 34); Background: #2a1a0d(0.4); LayoutMode: Top; Padding: (Horizontal: 6, Vertical: 3);
                        Label { Text: "Groupes actifs"; Style: (FontSize: 8, TextColor: #667788); Anchor: (Height: 11); }
                        Label #DStatParties { Text: "0"; Style: (FontSize: 14, TextColor: #2196F3, RenderBold: true, HorizontalAlignment: Center); Anchor: (Height: 18); }
